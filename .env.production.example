# Copie MANUALMENTE para /etc/detara/production.env (root:root, 0600).
# Formato KEY=value sem aspas, interpolação, espaços em secrets ou comandos shell.
# Secrets vazios intencionais: validate-env.sh deve rejeitar este exemplo.
DETARA_APP_HOST=app.detara.com.br
DETARA_API_HOST=api.detara.com.br
DETARA_ACME_EMAIL=
# Somente CIDRs oficiais da Cloudflare, revisados pelo operador. Sem proxy: 127.0.0.254/32
DETARA_TRUSTED_CIDRS=127.0.0.254/32
DETARA_HSTS_MAX_AGE=0

# Preenchidos pelo manifesto de release; digests obrigatórios nos scripts de deploy.
DETARA_API_IMAGE=
DETARA_WEB_IMAGE=
DETARA_WHATSAPP_GATEWAY_IMAGE=
DETARA_MIGRATIONS_IMAGE=
DETARA_RELEASE_SHA=

# Senhas SQL diferentes, 24-128 caracteres aleatórios: letras, números, !@%+=._-
# Este alfabeto evita ambiguidades de dotenv, SQL e connection strings.
DETARA_SQL_ADMIN_PASSWORD=
DETARA_SQL_RUNTIME_PASSWORD=
DETARA_SQL_MIGRATION_PASSWORD=
DETARA_JWT_KEY=
DETARA_PLATFORM_JWT_KEY=
DETARA_DATA_PROTECTION_PASSWORD=
DETARA_DATA_PROTECTION_CERTIFICATE=/etc/detara/data-protection.pfx
DETARA_WHATSAPP_PATH=/var/lib/detara/whatsapp
DETARA_BACKUP_PATH=/var/backups/detara/sql

# Mídia já utiliza S3. R2 privado separado do bucket de backup.
DETARA_S3_ENDPOINT=
DETARA_S3_BUCKET=
DETARA_S3_REGION=auto
DETARA_S3_ACCESS_KEY=
DETARA_S3_SECRET_KEY=
DETARA_S3_FORCE_PATH_STYLE=true
DETARA_RESEND_API_KEY=
DETARA_EMAIL_FROM_ADDRESS=
DETARA_EMAIL_FROM_NAME=Detara
DETARA_WHATSAPP_GATEWAY_API_KEY=

# Backup: rclone host configurado por ambiente; somente bucket privado de backups.
DETARA_R2_ENDPOINT=
DETARA_R2_BUCKET=
DETARA_R2_ACCESS_KEY=
DETARA_R2_SECRET_KEY=
# Chave pública age; chave PRIVADA de recuperação guardada FORA da VPS.
DETARA_BACKUP_RECIPIENT=
