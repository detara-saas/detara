# Copie para .env.production fora do versionamento e substitua todos os placeholders.
DETARA_PUBLIC_HOST=detara.example.com
DETARA_ACME_EMAIL=ops@example.com

# Use tags imutáveis ou, preferencialmente, digests sha256.
DETARA_API_IMAGE=registry.example.com/detara/api:CHANGE_ME
DETARA_WEB_IMAGE=registry.example.com/detara/web:CHANGE_ME
DETARA_WHATSAPP_GATEWAY_IMAGE=registry.example.com/detara/whatsapp-gateway:CHANGE_ME

DETARA_SQL_PID=Express
DETARA_SQL_ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_ADMIN_PASSWORD
DETARA_SQL_RUNTIME_PASSWORD=CHANGE_ME_LONG_RANDOM_RUNTIME_PASSWORD

DETARA_JWT_KEY=CHANGE_ME_RANDOM_AT_LEAST_32_BYTES_TENANT
DETARA_PLATFORM_JWT_KEY=CHANGE_ME_DIFFERENT_RANDOM_AT_LEAST_32_BYTES_PLATFORM
DETARA_DATA_PROTECTION_PASSWORD=CHANGE_ME_CERTIFICATE_PASSWORD

DETARA_S3_ENDPOINT=https://s3.example.com
DETARA_S3_BUCKET=detara-private-production
DETARA_S3_REGION=CHANGE_ME_REGION
DETARA_S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
DETARA_S3_SECRET_KEY=CHANGE_ME_SECRET_KEY
DETARA_S3_FORCE_PATH_STYLE=true

DETARA_RESEND_API_KEY=CHANGE_ME_RESEND_API_KEY
DETARA_EMAIL_FROM_ADDRESS=nao-responda@detara.example.com
DETARA_EMAIL_FROM_NAME=Detara

DETARA_WHATSAPP_GATEWAY_API_KEY=CHANGE_ME_RANDOM_AT_LEAST_32_BYTES_GATEWAY
