<DetaraDialog Titulo="Estornar pagamento" Descricao="Este pagamento deixará de compor o valor recebido da conta. O registro original será preservado no histórico." TextoPrimario="Confirmar estorno" CorPrimaria="Color.Error" OnPrimary="Confirmar" OnSecondary="Cancelar">
    <div class="dialog-financial-summary"><span>@Forma</span><strong>@Valor.ToString("C2")</strong></div>
    <MudTextField T="string" @bind-Value="_motivo" Label="Motivo do estorno" Variant="Variant.Outlined" Lines="3" Counter="500" MaxLength="500" Required="true" />
</DetaraDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string Forma { get; set; } = string.Empty;
    [Parameter] public decimal Valor { get; set; }
    private string? _motivo;
    private void Cancelar() => MudDialog.Cancel();
    private void Confirmar() { if (string.IsNullOrWhiteSpace(_motivo)) return; MudDialog.Close(DialogResult.Ok(_motivo.Trim())); }
}
