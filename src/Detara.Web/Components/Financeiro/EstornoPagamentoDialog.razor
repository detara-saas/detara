<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Estornar pagamento</MudText></TitleContent>
    <DialogContent>
        <div class="dialog-content-stack">
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Este pagamento deixará de compor o valor recebido da conta. O registro original será preservado no histórico.</MudAlert>
            <div class="dialog-financial-summary"><span>@Forma</span><strong>@Valor.ToString("C2")</strong></div>
            <MudTextField T="string" @bind-Value="_motivo" Label="Motivo do estorno" Variant="Variant.Outlined" Lines="3" Counter="500" MaxLength="500" Required="true" />
        </div>
    </DialogContent>
    <DialogActions><MudButton OnClick="Cancelar">Cancelar</MudButton><MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="Confirmar">Confirmar estorno</MudButton></DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string Forma { get; set; } = string.Empty;
    [Parameter] public decimal Valor { get; set; }
    private string? _motivo;
    private void Cancelar() => MudDialog.Cancel();
    private void Confirmar() { if (string.IsNullOrWhiteSpace(_motivo)) return; MudDialog.Close(DialogResult.Ok(_motivo.Trim())); }
}
