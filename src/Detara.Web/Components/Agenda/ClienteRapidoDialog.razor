<MudDialog Class="detara-dialog quick-create-dialog">
    <TitleContent>
        <div class="detara-dialog__heading">
            <MudText Typo="Typo.h6">Novo cliente</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Cadastre o cliente sem perder os dados do agendamento.</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="detara-dialog__content">
            <ClienteFormulario Incorporado="true" Salvo="Concluir" Cancelado="Cancelar" />
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private void Concluir(ClienteDetalheResponse cliente) =>
        MudDialog.Close(DialogResult.Ok(cliente));

    private void Cancelar() => MudDialog.Cancel();
}
