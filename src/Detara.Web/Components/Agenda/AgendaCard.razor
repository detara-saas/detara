<a class="appointment-card @(Compacto ? "compact" : string.Empty)" href="@($"/agenda/{Item.Id}")">
    <time>@Item.InicioLocal.ToString("HH:mm")</time>
    <div><strong>@Item.ClienteNome</strong><span>@FormatacaoVeiculo.Exibir(Item.VeiculoDescricao, Item.VeiculoPlaca)</span><span>@string.Join(", ", Item.PrincipaisItens) · @FormatarDuracao(Item.DuracaoPlanejadaMinutos)</span><small>@FormatacaoCatalogo.Referencia(Item.Referencia)</small></div>
    <DetaraStatusBadge Texto="@NomeStatus(Item.Status)" Tone="@TomStatus(Item.Status)" />
</a>

@code {
    [Parameter, EditorRequired] public AgendamentoPeriodoResponse Item { get; set; } = null!;
    [Parameter] public bool Compacto { get; set; }
    private static string NomeStatus(StatusAgendamentoContrato status) => AgendamentoApresentacao.NomeStatus(status);
    private static DetaraStatusTone TomStatus(StatusAgendamentoContrato status) => AgendamentoApresentacao.TomStatus(status);
    private static string FormatarDuracao(int minutos) => minutos >= 60 ? $"{minutos / 60}h{(minutos % 60 > 0 ? $" {minutos % 60}min" : string.Empty)}" : $"{minutos} min";
}
