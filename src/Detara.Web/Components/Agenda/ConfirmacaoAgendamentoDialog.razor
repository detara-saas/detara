@inject AgendaServico AgendaApi

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@Titulo</MudText></TitleContent>
    <DialogContent>
        <div class="dialog-content-stack">
            <MudAlert Severity="@Severidade" Variant="Variant.Outlined">@Descricao</MudAlert>
            <div class="reschedule-context"><strong>@ClienteNome</strong><span>@VeiculoDescricao</span></div>
            @if (!string.IsNullOrWhiteSpace(_erro))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_erro</MudAlert>
            }
            @if (Destino == StatusAgendamentoContrato.Cancelado)
            {
                <MudTextField T="string"
                              @bind-Value="_motivoCancelamento"
                              Label="Motivo do cancelamento (opcional)"
                              Variant="Variant.Outlined"
                              Lines="3"
                              MaxLength="1000"
                              Counter="1000"
                              Disabled="_enviando" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Disabled="_enviando">Voltar</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="@CorConfirmacao"
                   OnClick="ConfirmarAsync"
                   Disabled="_enviando">
            @(_enviando ? "Processando..." : TextoConfirmacao)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid AgendamentoId { get; set; }
    [Parameter] public StatusAgendamentoContrato Destino { get; set; }
    [Parameter] public string ClienteNome { get; set; } = string.Empty;
    [Parameter] public string VeiculoDescricao { get; set; } = string.Empty;

    private string? _motivoCancelamento;
    private string? _erro;
    private bool _enviando;

    private string Titulo => Destino switch
    {
        StatusAgendamentoContrato.Confirmado => "Confirmar agendamento?",
        StatusAgendamentoContrato.Compareceu => "Registrar chegada?",
        StatusAgendamentoContrato.NaoCompareceu => "Registrar não comparecimento?",
        StatusAgendamentoContrato.Cancelado => "Cancelar agendamento?",
        _ => "Confirmar ação?"
    };

    private string Descricao => Destino switch
    {
        StatusAgendamentoContrato.Confirmado => "Confirme que o horário foi alinhado com o cliente.",
        StatusAgendamentoContrato.Compareceu => "A chegada será registrada na Agenda. A execução da OS continua sendo uma etapa separada.",
        StatusAgendamentoContrato.NaoCompareceu => "O agendamento será encerrado como não comparecimento.",
        StatusAgendamentoContrato.Cancelado => "O atendimento não ocorrerá neste agendamento. Esta ação não exclui o histórico.",
        _ => "Revise a ação antes de continuar."
    };

    private string TextoConfirmacao => Destino switch
    {
        StatusAgendamentoContrato.Confirmado => "Confirmar agendamento",
        StatusAgendamentoContrato.Compareceu => "Registrar chegada",
        StatusAgendamentoContrato.NaoCompareceu => "Confirmar não comparecimento",
        StatusAgendamentoContrato.Cancelado => "Cancelar agendamento",
        _ => "Confirmar"
    };

    private Color CorConfirmacao => Destino switch
    {
        StatusAgendamentoContrato.Compareceu => Color.Success,
        StatusAgendamentoContrato.NaoCompareceu => Color.Warning,
        StatusAgendamentoContrato.Cancelado => Color.Error,
        _ => Color.Primary
    };

    private Severity Severidade => Destino switch
    {
        StatusAgendamentoContrato.NaoCompareceu => Severity.Warning,
        StatusAgendamentoContrato.Cancelado => Severity.Error,
        _ => Severity.Info
    };

    private void Cancelar() => MudDialog.Cancel();

    private async Task ConfirmarAsync()
    {
        if (_enviando)
        {
            return;
        }

        _enviando = true;
        _erro = null;
        var resultado = await AgendaApi.AlterarStatusAsync(AgendamentoId,
            new(Destino, _motivoCancelamento));
        if (!resultado.Sucesso || resultado.Resultado is null)
        {
            _erro = resultado.Mensagem;
            _enviando = false;
            return;
        }

        MudDialog.Close(DialogResult.Ok(resultado));
    }
}
