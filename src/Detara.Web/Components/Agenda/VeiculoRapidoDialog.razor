<MudDialog Class="detara-dialog quick-create-dialog">
    <TitleContent>
        <div class="detara-dialog__heading">
            <MudText Typo="Typo.h6">Novo veículo</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">O veículo será vinculado ao cliente selecionado no agendamento.</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="detara-dialog__content">
            <VeiculoFormulario Incorporado="true" ClienteInicialId="ClienteId" Salvo="Concluir" Cancelado="Cancelar" />
        </div>
    </DialogContent>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public Guid ClienteId { get; set; }

    private void Concluir(VeiculoDetalheResponse veiculo) =>
        MudDialog.Close(DialogResult.Ok(veiculo));

    private void Cancelar() => MudDialog.Cancel();
}
