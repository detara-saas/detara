<article class="detara-card @Class">
    @if (!string.IsNullOrWhiteSpace(Titulo) || Cabecalho is not null || Acoes is not null)
    {
        <header class="detara-card__header">
            @if (Cabecalho is not null)
            {
                @Cabecalho
            }
            else
            {
                <div>
                    @if (!string.IsNullOrWhiteSpace(Sobretitulo)) { <span class="section-eyebrow">@Sobretitulo</span> }
                    <h2>@Titulo</h2>
                    @if (!string.IsNullOrWhiteSpace(Descricao)) { <p>@Descricao</p> }
                </div>
            }
            @if (Acoes is not null) { <div class="detara-card__actions">@Acoes</div> }
        </header>
    }
    <div class="detara-card__content @ContentClass">@ChildContent</div>
</article>

@code {
    [Parameter] public string? Titulo { get; set; }
    [Parameter] public string? Sobretitulo { get; set; }
    [Parameter] public string? Descricao { get; set; }
    [Parameter] public RenderFragment? Cabecalho { get; set; }
    [Parameter] public RenderFragment? Acoes { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? ContentClass { get; set; }
}
