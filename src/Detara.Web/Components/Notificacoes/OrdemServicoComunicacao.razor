@if (OrdemStatus is StatusOrdemServicoContrato.AguardandoRetirada or StatusOrdemServicoContrato.Concluida)
{
    var ultimaComunicacao = UltimaComunicacao;
    var comunicacaoPendente = Notificacao?.Comunicacoes.Any(item =>
        item.Status == StatusComunicacaoClienteContrato.Pendente) == true;
    <DetaraCard Titulo="Comunicação com o cliente"
                Sobretitulo="VEÍCULO PRONTO"
                Descricao="Canal, resultado e histórico real dos avisos enviados."
                Class="service-order-communication"
                ContentClass="service-order-communication-content">
        <ChildContent>
            @if (Notificacao?.Comunicacoes.Count > 0)
            {
                <div class="communication-history" aria-label="Histórico de comunicação com o cliente">
                    <div class="communication-history-heading">
                        <strong>Histórico de comunicação</strong>
                        <span>@Notificacao.Comunicacoes.Count registro(s)</span>
                    </div>
                    @foreach (var comunicacao in Notificacao.Comunicacoes.OrderByDescending(item => item.CriadoEmUtc))
                    {
                        <article>
                            <span class="communication-history-icon">
                                <MudIcon Icon="@(comunicacao.Canal == CanalComunicacaoClienteContrato.WhatsApp ? Icons.Material.Outlined.Chat : Icons.Material.Outlined.AlternateEmail)" />
                            </span>
                            <div class="communication-history-copy">
                                <strong>@NomeCanal(comunicacao.Canal)</strong>
                                <span>@((comunicacao.DataEnvioUtc ?? comunicacao.CriadoEmUtc).ToLocalTime().ToString("dd/MM/yyyy HH:mm")) · @(comunicacao.Origem == OrigemComunicacaoClienteContrato.Automatica ? "Automático" : "Manual")</span>
                                <small>@(comunicacao.Destinatario ?? "Sem destinatário")</small>
                                <details>
                                    <summary>Ver detalhes</summary>
                                    <div class="communication-history-detail">
                                        <span><b>Usuário</b>@(comunicacao.SolicitadoPorUsuarioNome ?? (comunicacao.Origem == OrigemComunicacaoClienteContrato.Automatica ? "Automático Detara" : "Não identificado"))</span>
                                        <span><b>Data</b>@comunicacao.CriadoEmUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                                        <span><b>Resultado</b>@NomeComunicacao(comunicacao.Status)</span>
                                        <span><b>Template</b>@(comunicacao.TemplateNome ?? "Template legado")</span>
                                        <p>@comunicacao.Mensagem</p>
                                    </div>
                                </details>
                            </div>
                            <DetaraStatusBadge Texto="@NomeComunicacao(comunicacao.Status)"
                                               Tone="@TomComunicacao(comunicacao.Status)" />
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="communication-history-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.Forum" />
                    <span>Nenhuma comunicação enviada.</span>
                </div>
            }
            @if (string.IsNullOrWhiteSpace(Notificacao?.EmailDestinoAtual) &&
                string.IsNullOrWhiteSpace(Notificacao?.WhatsAppDestinoAtual))
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="service-order-communication-alert">
                    Cliente sem e-mail ou WhatsApp válido cadastrado. Atualize o cadastro para enviar o aviso.
                </MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(ultimaComunicacao?.UltimoErroSeguro))
            {
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="service-order-communication-alert">@ultimaComunicacao.UltimoErroSeguro</MudAlert>
            }
            @if (OrdemStatus == StatusOrdemServicoContrato.AguardandoRetirada)
            {
                <AuthorizeView Policy="@Permissoes.NotificacoesReenviar">
                    <Authorized>
                        <div class="form-actions communication-actions">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Outlined.Send"
                                       Disabled="@(Executando || comunicacaoPendente || string.IsNullOrWhiteSpace(Notificacao?.EmailDestinoAtual) && string.IsNullOrWhiteSpace(Notificacao?.WhatsAppDestinoAtual))"
                                       OnClick="OnComunicar">
                                @(Executando ? "Atualizando status..." : comunicacaoPendente ? "Envio em andamento" : "Enviar atualização")
                            </MudButton>
                        </div>
                    </Authorized>
                </AuthorizeView>
            }
        </ChildContent>
    </DetaraCard>
}

@code {
    [Parameter] public StatusOrdemServicoContrato OrdemStatus { get; set; }
    [Parameter] public NotificacaoOrdemServicoResponse? Notificacao { get; set; }
    [Parameter] public bool Executando { get; set; }
    [Parameter] public EventCallback OnComunicar { get; set; }

    private ComunicacaoClienteResponse? UltimaComunicacao => Notificacao?.Comunicacoes
        .OrderByDescending(item => item.CriadoEmUtc).FirstOrDefault();
    private static string NomeCanal(CanalComunicacaoClienteContrato? canal) => canal switch
    {
        CanalComunicacaoClienteContrato.Email => "Email",
        CanalComunicacaoClienteContrato.WhatsApp => "WhatsApp",
        _ => "Nenhum envio"
    };
    private static string NomeComunicacao(StatusComunicacaoClienteContrato? status) => status switch
    {
        null => "Ainda não comunicado",
        StatusComunicacaoClienteContrato.Pendente => "Pendente",
        StatusComunicacaoClienteContrato.Enviado => "Enviado",
        _ => "Falhou"
    };
    private static DetaraStatusTone TomComunicacao(StatusComunicacaoClienteContrato? status) => status switch
    {
        StatusComunicacaoClienteContrato.Enviado => DetaraStatusTone.Positive,
        StatusComunicacaoClienteContrato.Falhou => DetaraStatusTone.Critical,
        StatusComunicacaoClienteContrato.Pendente => DetaraStatusTone.Warning,
        _ => DetaraStatusTone.Neutral
    };
}
