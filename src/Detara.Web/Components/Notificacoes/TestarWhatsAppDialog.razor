<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">Enviar mensagem de teste</MudText></TitleContent>
    <DialogContent>
        <div class="dialog-content-stack whatsapp-test-dialog">
            <div class="communication-dialog-intro">
                <span class="section-eyebrow">VALIDAR CONEXÃO</span>
                <p>Informe um número com código do país e DDD. O envio será registrado no histórico desta empresa.</p>
            </div>
            <MudTextField T="string" @bind-Value="_numero" Label="Número para teste"
                          Placeholder="5541999990000" Variant="Variant.Outlined"
                          InputType="InputType.Telephone" Immediate="true" MaxLength="32"
                          HelperText="Use somente um número que esteja autorizado a receber este teste." />
            <div class="whatsapp-test-message">
                <MudIcon Icon="@Icons.Material.Outlined.Chat" />
                <p>Olá!<br /><br />Esta é uma mensagem de teste do Detara.<br /><br />Sua conexão WhatsApp está funcionando corretamente.<br /><br /><strong>@EmpresaNome</strong></p>
            </div>
            <MudCheckBox T="bool" @bind-Value="_confirmado" Color="Color.Primary"
                         Label="Confirmo o envio desta mensagem para o número informado." />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Send"
                   Disabled="@(!_confirmado || string.IsNullOrWhiteSpace(_numero))"
                   OnClick="Confirmar">Enviar teste</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string EmpresaNome { get; set; } = "Sua empresa";
    private string? _numero;
    private bool _confirmado;
    private void Cancelar() => MudDialog.Cancel();
    private void Confirmar()
    {
        if (_confirmado && !string.IsNullOrWhiteSpace(_numero))
            MudDialog.Close(DialogResult.Ok(_numero.Trim()));
    }
}
