<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@Titulo</MudText></TitleContent>
    <DialogContent>
        <div class="dialog-content-stack">
            <MudAlert Severity="@Severidade" Variant="Variant.Outlined">@Aviso</MudAlert>
            <MudTextField T="string" @bind-Value="_motivo" Label="Motivo" Variant="Variant.Outlined"
                          Lines="3" Counter="500" MaxLength="500" Required="true"
                          HelperText="O motivo será preservado na auditoria da plataforma." />
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled" Color="@Cor" OnClick="Confirmar">@TextoConfirmacao</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public bool Suspender { get; set; }
    private string? _motivo;
    private string Titulo => Suspender ? "Suspender empresa" : "Reativar empresa";
    private string Aviso => Suspender
        ? "Todos os tokens tenant atuais serão revogados e novos logins serão bloqueados até a reativação."
        : "A empresa voltará a aceitar login. Sessões antigas continuarão revogadas.";
    private string TextoConfirmacao => Suspender ? "Confirmar suspensão" : "Confirmar reativação";
    private Color Cor => Suspender ? Color.Error : Color.Success;
    private Severity Severidade => Suspender ? Severity.Warning : Severity.Info;
    private void Cancelar() => MudDialog.Cancel();
    private void Confirmar()
    {
        if (!string.IsNullOrWhiteSpace(_motivo)) MudDialog.Close(DialogResult.Ok(_motivo.Trim()));
    }
}
