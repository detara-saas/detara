<section class="executive-summary-grid" aria-label="Indicadores principais">
    @if (Resumo.AgendamentosHoje.HasValue)
    {
        <DetaraMetricCard Titulo="Agendamentos"
                          Valor="@Resumo.AgendamentosHoje.Value.ToString(Cultura)"
                          Descricao="@(Resumo.AgendamentosConcluidosHoje == 1 ? "1 atendimento concluído" : $"{Resumo.AgendamentosConcluidosHoje ?? 0} atendimentos concluídos")"
                          Contexto="Hoje"
                          Icone="@Icons.Material.Outlined.CalendarToday"
                          Tone="DetaraMetricTone.Positive" />
    }
    @if (Resumo.OrdensEmExecucao.HasValue)
    {
        <DetaraMetricCard Titulo="Em execução" Valor="@Resumo.OrdensEmExecucao.Value.ToString(Cultura)" Descricao="Ordens em atendimento" Contexto="Agora" Icone="@Icons.Material.Outlined.Handyman" Tone="DetaraMetricTone.Info" />
        <DetaraMetricCard Titulo="Aguardando retirada" Valor="@((Resumo.OrdensAguardandoRetirada ?? 0).ToString(Cultura))" Descricao="Veículos prontos para entrega" Contexto="Agora" Icone="@Icons.Material.Outlined.DirectionsCar" Tone="DetaraMetricTone.Warning" />
    }
    @if (Resumo.ReceitaLiquida.HasValue)
    {
        <DetaraMetricCard Titulo="Receita líquida recebida"
                          Valor="@Moeda(Resumo.ReceitaLiquida.Value)"
                          Descricao="@(Resumo.VariacaoReceitaPercentual.HasValue ? null : "Recebido menos taxas · não é lucro")"
                          Tendencia="@(Resumo.VariacaoReceitaPercentual.HasValue ? $"{Math.Abs(Resumo.VariacaoReceitaPercentual.Value).ToString("N1", Cultura)}% vs. período anterior" : null)"
                          Contexto="@RotuloPeriodo"
                          Icone="@Icons.Material.Outlined.Payments"
                          Tone="@(Resumo.VariacaoReceitaPercentual < 0 ? DetaraMetricTone.Warning : DetaraMetricTone.Positive)"
                          ValorSemQuebra="true" />
    }
</section>

@code {
    private static readonly System.Globalization.CultureInfo Cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    [Parameter, EditorRequired] public DashboardResumoResponse Resumo { get; set; } = null!;
    [Parameter] public string RotuloPeriodo { get; set; } = "PERÍODO";
    private static string Moeda(decimal valor) => valor.ToString("C2", Cultura);
}
