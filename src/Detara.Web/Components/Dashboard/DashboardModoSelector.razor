<div class="dashboard-mode-switch" role="tablist" aria-label="Alternar modo do Dashboard">
    <MudButton Variant="@(Modo == ModoDashboard.Operacao ? Variant.Filled : Variant.Text)"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Outlined.Today"
               Disabled="Alterando"
               OnClick="() => AlterarAsync(ModoDashboard.Operacao)">
        Operação
    </MudButton>
    <MudButton Variant="@(Modo == ModoDashboard.Empresa ? Variant.Filled : Variant.Text)"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Outlined.QueryStats"
               Disabled="Alterando"
               OnClick="() => AlterarAsync(ModoDashboard.Empresa)">
        Empresa
    </MudButton>
</div>

@code {
    [Parameter] public ModoDashboard Modo { get; set; }
    [Parameter] public bool Alterando { get; set; }
    [Parameter] public EventCallback<ModoDashboard> ModoAlterado { get; set; }

    private Task AlterarAsync(ModoDashboard modo) =>
        modo == Modo ? Task.CompletedTask : ModoAlterado.InvokeAsync(modo);
}
