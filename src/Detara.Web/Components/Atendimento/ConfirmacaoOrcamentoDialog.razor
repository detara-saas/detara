@inject OrcamentosServico OrcamentosApi

<MudDialog>
    <TitleContent><MudText Typo="Typo.h6">@Titulo</MudText></TitleContent>
    <DialogContent>
        <div class="dialog-content-stack quotation-action-dialog">
            <MudAlert Severity="@Severidade" Variant="Variant.Outlined">@Descricao</MudAlert>
            @if (!string.IsNullOrWhiteSpace(_erro))
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined">@_erro</MudAlert>
            }
            @if (Acao != "nova")
            {
                <MudTextField T="string"
                              @bind-Value="_observacao"
                              Label="Observação (opcional)"
                              Variant="Variant.Outlined"
                              Lines="3"
                              MaxLength="1000"
                              Counter="1000"
                              Disabled="_enviando" />
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar" Disabled="_enviando">Cancelar</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="@CorConfirmacao"
                   OnClick="ConfirmarAsync"
                   Disabled="_enviando">
            @(_enviando ? "Processando..." : TextoConfirmacao)
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Guid OrcamentoId { get; set; }
    [Parameter] public string Acao { get; set; } = string.Empty;

    private string? _observacao;
    private string? _erro;
    private bool _enviando;

    private string Titulo => Acao switch
    {
        "emitir" => "Emitir orçamento?",
        "aprovar" => "Registrar aprovação do cliente?",
        "recusar" => "Registrar recusa do cliente?",
        "cancelar" => "Cancelar orçamento?",
        "nova" => "Criar nova proposta?",
        _ => "Confirmar ação?"
    };

    private string Descricao => Acao switch
    {
        "emitir" => "Após a emissão, este orçamento se torna um documento comercial imutável. Para alterar serviços ou valores, será necessário criar uma nova proposta.",
        "aprovar" => "Você está registrando internamente que o cliente aprovou este orçamento. Esta ação não representa assinatura digital.",
        "recusar" => "A recusa registra que o cliente não aceitou esta proposta comercial.",
        "cancelar" => "O cancelamento é uma decisão operacional da empresa e não equivale à recusa do cliente.",
        "nova" => "Um novo rascunho será criado. O orçamento atual não será alterado até a emissão da nova proposta.",
        _ => "Revise a ação antes de continuar."
    };

    private string TextoConfirmacao => Acao switch
    {
        "emitir" => "Emitir orçamento",
        "aprovar" => "Confirmar aprovação",
        "recusar" => "Confirmar recusa",
        "cancelar" => "Cancelar orçamento",
        "nova" => "Criar nova proposta",
        _ => "Confirmar"
    };

    private Color CorConfirmacao => Acao is "recusar" or "cancelar"
        ? Color.Warning
        : Acao == "aprovar" ? Color.Success : Color.Primary;

    private Severity Severidade => Acao is "recusar" or "cancelar"
        ? Severity.Warning
        : Severity.Info;

    private void Cancelar() => MudDialog.Cancel();

    private async Task ConfirmarAsync()
    {
        if (_enviando)
        {
            return;
        }

        _enviando = true;
        _erro = null;
        var resultado = Acao switch
        {
            "emitir" => await OrcamentosApi.EmitirAsync(OrcamentoId, _observacao),
            "aprovar" => await OrcamentosApi.AprovarAsync(OrcamentoId, _observacao),
            "recusar" => await OrcamentosApi.RecusarAsync(OrcamentoId, _observacao),
            "cancelar" => await OrcamentosApi.CancelarAsync(OrcamentoId, _observacao),
            "nova" => await OrcamentosApi.NovaPropostaAsync(OrcamentoId),
            _ => ResultadoServico<OrcamentoDetalheResponse>.Falha("Ação inválida.")
        };

        if (!resultado.Sucesso || resultado.Resultado is null)
        {
            _erro = resultado.Mensagem;
            _enviando = false;
            return;
        }

        MudDialog.Close(DialogResult.Ok(resultado));
    }
}
