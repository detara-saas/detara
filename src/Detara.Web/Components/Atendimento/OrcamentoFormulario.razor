@inject OrcamentosServico OrcamentosApi
@inject OrdensServicoServico OrdensServicoApi
@inject IMensagemServico Mensagens
@inject NavigationManager Navegacao

@if (_carregando)
{
    <div class="module-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else
{
    <EditForm Model="_modelo" OnValidSubmit="SalvarAsync" class="form-page-grid quotation-form">
        <DataAnnotationsValidator />
        <main class="page-main-column">
            @if (_agendamentoOrigemId.HasValue || _ordemServicoOrigemId.HasValue)
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="page-alert quotation-origin-note">@(_ordemServicoOrigemId.HasValue ? "Este é um orçamento adicional vinculado à OS. Só itens aprovados serão incorporados ao escopo autorizado." : "Este rascunho usa os snapshots apresentados no agendamento. Confirme os valores negociados sem alterar a Agenda.")</MudAlert>
            }

            <section class="module-panel section-card">
                <CabecalhoSecao Sobretitulo="DESTINATÁRIO" Titulo="Cliente e veículo" Descricao="Identifique para quem a proposta será apresentada." Etapa="01" />
                <div class="form-grid">
                    <ClienteOrcamentoAutocomplete ClienteId="_clienteId" ClienteNome="@_clienteNome" Fixo="@OrigemFixa" SelecionadoChanged="ClienteSelecionadoAsync" />
                    <MudSelect T="Guid?" @bind-Value="_veiculoId" Label="Veículo *" Variant="Variant.Outlined" Disabled="@(!_clienteId.HasValue || OrigemFixa)" Required="true">
                        @foreach (var veiculo in _veiculos) { <MudSelectItem T="Guid?" Value="@((Guid?)veiculo.Id)">@FormatacaoVeiculo.Exibir(veiculo.Descricao, veiculo.Placa)</MudSelectItem> }
                    </MudSelect>
                </div>
            </section>

            <section class="module-panel section-card">
                <CabecalhoSecao Sobretitulo="PROPOSTA" Titulo="Itens e valores negociados" Descricao="Use o catálogo como referência e registre o valor desta proposta." Etapa="02" />
                <div class="catalog-tools">
                    <MudTextField T="string" @bind-Value="_pesquisaCatalogo" Label="Pesquisar serviços e pacotes" Placeholder="Serviço ou pacote" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
                    <div class="catalog-actions"><MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Search" OnClick="BuscarCatalogoAsync">Buscar catálogo</MudButton><MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Add" OnClick="AdicionarPersonalizado">Item personalizado</MudButton></div>
                </div>
                @if (_catalogo.Count > 0)
                {
                    <div class="quotation-catalog-picker">
                        @foreach (var item in _catalogo)
                        {
                            <button type="button" class="quotation-catalog-item" @onclick="@(() => AdicionarCatalogo(item))">
                                <MudIcon Icon="@(item.TipoItem == TipoItemOrcamentoContrato.Servico ? Icons.Material.Outlined.AutoFixHigh : Icons.Material.Outlined.Inventory2)" />
                                <span><strong>@item.Nome</strong><small>@Referencia(item.TipoPrecificacao, item.PrecoReferencia)</small></span>
                                <MudIcon Icon="@Icons.Material.Outlined.AddCircleOutline" />
                            </button>
                        }
                    </div>
                }
                @if (_itens.Count == 0)
                {
                    <div class="items-empty"><span><MudIcon Icon="@Icons.Material.Outlined.PlaylistAdd" /></span><div><strong>Nenhum item na proposta</strong><p>Pesquise o catálogo ou adicione um item personalizado para compor o orçamento.</p></div></div>
                }
                else
                {
                    <div class="quotation-items-editor">
                        @for (var indice = 0; indice < _itens.Count; indice++)
                        {
                            var item = _itens[indice];
                            <article>
                                <div class="quotation-item-title">
                                    <span class="package-order">@(indice + 1)</span>
                                    <div>
                                        @if (item.TipoItem == TipoItemOrcamentoContrato.Personalizado)
                                        { <MudTextField T="string" @bind-Value="item.Nome" Label="Descrição do item *" Variant="Variant.Outlined" Required="true" /> }
                                        else
                                        { <strong>@item.Nome</strong><span>Referência interna: @Referencia(item.TipoPrecificacao, item.PrecoReferencia)</span> }
                                    </div>
                                    <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" OnClick="@(() => Remover(item))" aria-label="Remover item" />
                                </div>
                                <div class="quotation-item-values">
                                    <MudNumericField T="int" @bind-Value="item.Quantidade" Label="Quantidade" Variant="Variant.Outlined" Min="1" />
                                    <MudNumericField T="decimal" @bind-Value="item.ValorUnitario" Label="Valor neste orçamento" Variant="Variant.Outlined" Min="0" Format="C2" />
                                    <div class="quotation-item-subtotal"><span>Subtotal</span><strong class="currency-value">@((item.Quantidade * item.ValorUnitario).ToString("C2"))</strong></div>
                                </div>
                                <MudTextField T="string" @bind-Value="item.Observacao" Label="Observação do item (opcional)" Variant="Variant.Outlined" />
                            </article>
                        }
                    </div>
                }
            </section>

            <section class="module-panel section-card">
                <CabecalhoSecao Sobretitulo="CONDIÇÕES" Titulo="Validade e comunicação" Descricao="Defina o prazo e as informações apresentadas ao cliente." Etapa="03" />
                <div class="form-grid">
                    <MudDatePicker @bind-Date="_validoAte" Label="Válido até *" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" />
                    <MudTextField T="string" @bind-Value="_modelo.Condicoes" Label="Condições comerciais" Variant="Variant.Outlined" Lines="3" Class="form-full" />
                    <MudTextField T="string" @bind-Value="_modelo.ObservacaoCliente" Label="Observações para o cliente" Variant="Variant.Outlined" Lines="3" Class="form-full" />
                    <MudTextField T="string" @bind-Value="_modelo.ObservacaoInterna" Label="Observação interna (não aparece no PDF)" Variant="Variant.Outlined" Lines="3" Class="form-full" />
                </div>
            </section>
        </main>

        <ResumoLateral Icone="@Icons.Material.Outlined.RequestQuote" Sobretitulo="RESUMO DO ORÇAMENTO" Titulo="Total negociado">
            <ChildContent>
                <dl class="summary-list"><div><dt>Itens</dt><dd>@_itens.Count</dd></div><div><dt>Subtotal</dt><dd class="currency-value">@Subtotal.ToString("C2")</dd></div></dl>
                <MudNumericField T="decimal" @bind-Value="_modelo.Desconto" Label="Desconto" Variant="Variant.Outlined" Min="0" Format="C2" />
                <MudNumericField T="decimal" @bind-Value="_modelo.Acrescimo" Label="Acréscimo" Variant="Variant.Outlined" Min="0" Format="C2" />
                <div class="summary-total"><span>TOTAL</span><strong class="currency-value">@Total.ToString("C2")</strong></div>
                <p class="summary-note"><MudIcon Icon="@Icons.Material.Outlined.Info" /> O documento permanece editável enquanto estiver em rascunho.</p>
            </ChildContent>
            <Acoes><MudButton Href="@CancelarHref" Variant="Variant.Text">Cancelar</MudButton><MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" Disabled="_salvando">@(_salvando ? "Salvando..." : "Salvar rascunho")</MudButton></Acoes>
        </ResumoLateral>
    </EditForm>
}

@code {
    [Parameter] public Guid? OrcamentoId { get; set; }
    [Parameter] public Guid? ClienteInicialId { get; set; }
    [Parameter] public string? ClienteInicialNome { get; set; }
    [Parameter] public Guid? VeiculoInicialId { get; set; }
    private readonly ModeloFormulario _modelo = new();
    private readonly List<ItemEdicao> _itens = [];
    private IReadOnlyCollection<VeiculoOrcamentoResponse> _veiculos = [];
    private IReadOnlyCollection<ItemCatalogoOrcamentoResponse> _catalogo = [];
    private Guid? _clienteId; private string? _clienteNome; private Guid? _veiculoId; private Guid? _agendamentoOrigemId; private Guid? _ordemServicoOrigemId;
    private DateTime? _validoAte; private string? _pesquisaCatalogo; private bool _carregando = true; private bool _salvando;
    private decimal Subtotal => _itens.Sum(x => x.Quantidade * x.ValorUnitario);
    private decimal Total => Subtotal - _modelo.Desconto + _modelo.Acrescimo;
    private bool OrigemFixa => _agendamentoOrigemId.HasValue || _ordemServicoOrigemId.HasValue;
    private string CancelarHref => _ordemServicoOrigemId.HasValue ? $"/ordens-servico/{_ordemServicoOrigemId}" : OrcamentoId.HasValue ? $"/orcamentos/{OrcamentoId}" : "/orcamentos";

    protected override async Task OnInitializedAsync()
    {
        if (OrcamentoId.HasValue) await CarregarEdicaoAsync(OrcamentoId.Value);
        else
        {
            var contexto = await OrcamentosApi.ObterContextoAsync(); _validoAte = contexto.Resultado?.ValidadeSugerida.ToDateTime(TimeOnly.MinValue);
            _ordemServicoOrigemId = LerQueryId("ordemServicoId");
            if (_ordemServicoOrigemId.HasValue) await CarregarOrigemOrdemServicoAsync(_ordemServicoOrigemId.Value);
            else
            {
                var origemId = LerQueryId("agendamentoId");
                if (origemId.HasValue) await CarregarOrigemAsync(origemId.Value);
                else if (ClienteInicialId.HasValue && !string.IsNullOrWhiteSpace(ClienteInicialNome))
                {
                    _clienteId = ClienteInicialId;
                    _clienteNome = ClienteInicialNome;
                    _veiculos = (await OrcamentosApi.ListarVeiculosAsync(ClienteInicialId.Value)).Resultado ?? [];
                    if (VeiculoInicialId.HasValue && _veiculos.Any(item => item.Id == VeiculoInicialId.Value)) _veiculoId = VeiculoInicialId;
                    else if (_veiculos.Count == 1) _veiculoId = _veiculos.Single().Id;
                }
            }
        }
        _carregando = false;
    }

    private async Task CarregarEdicaoAsync(Guid id)
    {
        var resultado = await OrcamentosApi.ObterAsync(id); var o = resultado.Resultado;
        if (o is null) { Mensagens.Mostrar(resultado.Mensagem, true); Navegacao.NavigateTo("/orcamentos"); return; }
        if (o.Status != StatusOrcamentoContrato.Rascunho) { Mensagens.Mostrar("Este orçamento já foi emitido. Para mudar valores, crie uma nova proposta.", true); Navegacao.NavigateTo($"/orcamentos/{id}"); return; }
        _clienteId = o.ClienteId; _clienteNome = o.ClienteNome; _veiculoId = o.VeiculoId; _agendamentoOrigemId = o.AgendamentoOrigemId;
        _veiculos = [new(o.VeiculoId, o.VeiculoDescricao, o.VeiculoPlaca)]; _validoAte = o.ValidoAte.ToDateTime(TimeOnly.MinValue);
        _modelo.ObservacaoCliente = o.ObservacaoCliente; _modelo.ObservacaoInterna = o.ObservacaoInterna; _modelo.Condicoes = o.Condicoes; _modelo.Desconto = o.Desconto; _modelo.Acrescimo = o.Acrescimo;
        _itens.AddRange(o.Itens.OrderBy(x => x.Ordem).Select(x => new ItemEdicao(x.TipoItem, x.ItemCatalogoId, x.Nome, x.Descricao, x.TipoPrecificacaoReferencia, x.PrecoReferencia, x.ValorUnitario, x.Quantidade, x.Observacao)));
    }

    private async Task CarregarOrigemAsync(Guid id)
    {
        var resultado = await OrcamentosApi.ObterOrigemAsync(id); var origem = resultado.Resultado;
        if (origem is null) { Mensagens.Mostrar(resultado.Mensagem, true); return; }
        _agendamentoOrigemId = id; _clienteId = origem.ClienteId; _clienteNome = origem.ClienteNome; _veiculoId = origem.VeiculoId;
        _veiculos = [new(origem.VeiculoId, origem.VeiculoDescricao, origem.VeiculoPlaca)];
        _itens.AddRange(origem.Itens.Select(x => new ItemEdicao(x.TipoItem, x.Id, x.Nome, x.Descricao, x.TipoPrecificacao, x.PrecoReferencia, x.PrecoReferencia ?? 0, 1, null)));
    }

    private async Task CarregarOrigemOrdemServicoAsync(Guid id)
    {
        var resultado = await OrdensServicoApi.ObterAsync(id); var ordem = resultado.Resultado;
        if (ordem is null || ordem.Status != StatusOrdemServicoContrato.EmExecucao) { Mensagens.Mostrar("A OS precisa estar em execução para criar um adicional.", true); Navegacao.NavigateTo($"/ordens-servico/{id}"); return; }
        _clienteId = ordem.ClienteId; _clienteNome = ordem.ClienteNome; _veiculoId = ordem.VeiculoId;
        _veiculos = [new(ordem.VeiculoId, ordem.VeiculoDescricao, ordem.VeiculoPlaca)];
    }

    private async Task ClienteSelecionadoAsync(ClienteOrcamentoResponse? cliente)
    {
        _clienteId = cliente?.Id; _clienteNome = cliente?.Nome; _veiculoId = null; _veiculos = [];
        if (cliente is not null) _veiculos = (await OrcamentosApi.ListarVeiculosAsync(cliente.Id)).Resultado ?? [];
    }
    private async Task BuscarCatalogoAsync() { _catalogo = (await OrcamentosApi.BuscarCatalogoAsync(_pesquisaCatalogo)).Resultado ?? []; }
    private void AdicionarCatalogo(ItemCatalogoOrcamentoResponse item)
    {
        if (_itens.Any(x => x.TipoItem == item.TipoItem && x.ItemCatalogoId == item.Id)) { Mensagens.Mostrar("Este item já está no orçamento. Ajuste a quantidade.", true); return; }
        _itens.Add(new(item.TipoItem, item.Id, item.Nome, item.Descricao, item.TipoPrecificacao, item.PrecoReferencia, item.PrecoReferencia ?? 0, 1, null));
    }
    private void AdicionarPersonalizado() => _itens.Add(new(TipoItemOrcamentoContrato.Personalizado, null, string.Empty, null, null, null, 0, 1, null));
    private void Remover(ItemEdicao item) => _itens.Remove(item);

    private async Task SalvarAsync()
    {
        if (!_clienteId.HasValue || !_veiculoId.HasValue || !_validoAte.HasValue || _itens.Count == 0) { Mensagens.Mostrar("Informe cliente, veículo, validade e ao menos um item.", true); return; }
        if (Total < 0) { Mensagens.Mostrar("O total não pode ser negativo.", true); return; }
        _salvando = true;
        var request = new SalvarOrcamentoRequest(_clienteId.Value, _veiculoId.Value, _agendamentoOrigemId, DateOnly.FromDateTime(_validoAte.Value),
            _modelo.ObservacaoCliente, _modelo.ObservacaoInterna, _modelo.Condicoes, _modelo.Desconto, _modelo.Acrescimo,
            _itens.Select(x => new OrcamentoItemRequest(x.TipoItem, x.ItemCatalogoId, x.TipoItem == TipoItemOrcamentoContrato.Personalizado ? x.Nome : null,
                x.TipoItem == TipoItemOrcamentoContrato.Personalizado ? x.Descricao : null, x.ValorUnitario, x.Quantidade, x.Observacao)).ToArray());
        ResultadoServico<OrcamentoDetalheResponse> resultado;
        if (_ordemServicoOrigemId.HasValue)
            resultado = await OrdensServicoApi.CriarOrcamentoAdicionalAsync(_ordemServicoOrigemId.Value,
                new CriarOrcamentoAdicionalRequest(request.ValidoAte, request.ObservacaoCliente, request.ObservacaoInterna,
                    request.Condicoes, request.Desconto, request.Acrescimo, request.Itens));
        else resultado = OrcamentoId.HasValue ? await OrcamentosApi.AtualizarAsync(OrcamentoId.Value, request) : await OrcamentosApi.CriarAsync(request);
        _salvando = false; Mensagens.Mostrar(resultado.Mensagem, !resultado.Sucesso);
        if (resultado.Resultado is not null) Navegacao.NavigateTo($"/orcamentos/{resultado.Resultado.Id}");
    }

    private Guid? LerQueryId(string nome)
    {
        var query = Navegacao.ToAbsoluteUri(Navegacao.Uri).Query.TrimStart('?');
        foreach (var parte in query.Split('&', StringSplitOptions.RemoveEmptyEntries)) { var p = parte.Split('=', 2); if (p.Length == 2 && p[0].Equals(nome, StringComparison.OrdinalIgnoreCase) && Guid.TryParse(Uri.UnescapeDataString(p[1]), out var id)) return id; }
        return null;
    }
    private static string Referencia(TipoPrecificacaoCatalogo? tipo, decimal? preco) => tipo switch { TipoPrecificacaoCatalogo.Fixo => preco?.ToString("C2") ?? "Sob consulta", TipoPrecificacaoCatalogo.APartirDe => preco.HasValue ? $"A partir de {preco:C2}" : "Sob consulta", _ => "Sob consulta" };
    private sealed class ModeloFormulario { public string? ObservacaoCliente { get; set; } public string? ObservacaoInterna { get; set; } public string? Condicoes { get; set; } public decimal Desconto { get; set; } public decimal Acrescimo { get; set; } }
    private sealed class ItemEdicao(TipoItemOrcamentoContrato tipoItem, Guid? itemCatalogoId, string nome, string? descricao,
        TipoPrecificacaoCatalogo? tipoPrecificacao, decimal? precoReferencia, decimal valorUnitario, int quantidade, string? observacao)
    { public TipoItemOrcamentoContrato TipoItem { get; } = tipoItem; public Guid? ItemCatalogoId { get; } = itemCatalogoId; public string Nome { get; set; } = nome; public string? Descricao { get; } = descricao; public TipoPrecificacaoCatalogo? TipoPrecificacao { get; } = tipoPrecificacao; public decimal? PrecoReferencia { get; } = precoReferencia; public decimal ValorUnitario { get; set; } = valorUnitario; public int Quantidade { get; set; } = quantidade; public string? Observacao { get; set; } = observacao; }
}
