@page "/financeiro/contas-receber/{Id:guid}"
@attribute [Authorize(Policy = Permissoes.FinanceiroVisualizar)]
@inject FinanceiroServico FinanceiroApi
@inject IMensagemServico Mensagens
@inject IDialogService DialogService

<PageTitle>@(_conta?.OrdemServicoCodigo ?? "Conta a Receber") | Detara</PageTitle>
@if (_carregando) { <div class="module-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div> }
else if (_conta is null) { <EstadoVazio Titulo="Conta a receber não encontrada" Descricao="O registro não existe ou pertence a outra empresa." Icone="@Icons.Material.Outlined.ReceiptLong" /> }
else
{
    <div class="page-container receivable-detail-page">
        <CabecalhoPagina Titulo="@_conta.OrdemServicoCodigo" Descricao="@($"{_conta.ClienteNome} · {_conta.VeiculoDescricao} · {_conta.VeiculoPlaca}")" Sobretitulo="FINANCEIRO">
            <Acoes><span class="status-badge @ClasseStatus">@StatusEfetivo</span><MudButton Href="/financeiro/contas-receber" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.ArrowBack">Voltar</MudButton></Acoes>
        </CabecalhoPagina>
        <section class="detail-metrics detail-metrics-four" aria-label="Resumo da conta">
            <CardMetrica Icone="@Icons.Material.Outlined.RequestQuote" Rotulo="VALOR ORIGINAL" Valor="@_conta.ValorOriginal.ToString("C2")" Descricao="Snapshot imutável da OS" Destaque="true" ValorSemQuebra="true" />
            <CardMetrica Icone="@Icons.Material.Outlined.Payments" Rotulo="RECEBIDO" Valor="@_conta.ValorRecebido.ToString("C2")" Descricao="Pagamentos confirmados" ValorSemQuebra="true" />
            <CardMetrica Icone="@Icons.Material.Outlined.PendingActions" Rotulo="EM ABERTO" Valor="@_conta.ValorEmAberto.ToString("C2")" Descricao="Saldo atual" ValorSemQuebra="true" />
            <CardMetrica Icone="@Icons.Material.Outlined.Event" Rotulo="VENCIMENTO" Valor="@_conta.DataVencimento.ToString("dd/MM/yyyy")" Descricao="@(_conta.Vencida ? "Conta vencida" : "No fuso da empresa")" Classe="@(_conta.Vencida ? "financial-overdue-card" : null)" />
        </section>

        <div class="detail-stack">
            <section class="module-panel section-card receivable-origin-card"><div class="section-heading section-card-heading"><div><span class="section-eyebrow">ORIGEM</span><h2>Ordem de Serviço @_conta.OrdemServicoCodigo</h2><p>A cobrança preserva cliente, veículo e valores do momento da finalização.</p></div><AuthorizeView Policy="@Permissoes.OrdemServicoVisualizar"><Authorized><MudButton Href="@($"/ordens-servico/{_conta.OrdemServicoId}")" Variant="Variant.Outlined" EndIcon="@Icons.Material.Outlined.OpenInNew">Abrir OS</MudButton></Authorized></AuthorizeView></div><div class="financial-breakdown"><span>Subtotal <strong>@_conta.SubtotalAutorizado.ToString("C2")</strong></span><span>Desconto <strong>@_conta.DescontoAutorizado.ToString("C2")</strong></span><span>Acréscimo <strong>@_conta.AcrescimoAutorizado.ToString("C2")</strong></span><span>Competência <strong>@_conta.DataCompetencia.ToString("dd/MM/yyyy")</strong></span></div></section>

            @if (_editandoVencimento)
            { <AuthorizeView Policy="@Permissoes.FinanceiroEditar"><Authorized><MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="financial-inline-action"><div><strong>Alterar vencimento</strong><span>O valor original e a competência permanecem inalterados.</span></div><MudDatePicker @bind-Date="_novoVencimento" Label="Novo vencimento" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" /><div><MudButton Variant="Variant.Text" OnClick="@(() => _editandoVencimento = false)">Cancelar</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SalvarVencimentoAsync">Salvar</MudButton></div></MudAlert></Authorized></AuthorizeView> }
            else if (_conta.Status != StatusContaReceberContrato.Pago)
            { <AuthorizeView Policy="@Permissoes.FinanceiroEditar"><Authorized><div class="secondary-page-action"><MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.EditCalendar" OnClick="EditarVencimento">Alterar vencimento</MudButton></div></Authorized></AuthorizeView> }

            @if (_registrandoPagamento)
            {
                <AuthorizeView Policy="@Permissoes.FinanceiroRegistrarPagamento"><Authorized>
                    <section class="module-panel section-card payment-form-card"><div class="section-heading section-card-heading"><div><span class="section-eyebrow">RECEBIMENTO</span><h2>Registrar pagamento</h2><p>Pagamentos são imutáveis. Correções posteriores devem ser feitas por estorno.</p></div><strong class="section-total currency-value">Saldo @_conta.ValorEmAberto.ToString("C2")</strong></div>
                        <div class="payment-form-grid"><MudNumericField T="decimal" @bind-Value="_valor" Label="Valor recebido" Variant="Variant.Outlined" Min="0.01m" Max="@_conta.ValorEmAberto" Format="C2" /><MudSelect T="FormaPagamentoContrato" @bind-Value="_forma" Label="Forma de pagamento" Variant="Variant.Outlined">@foreach (var forma in Enum.GetValues<FormaPagamentoContrato>()) { <MudSelectItem Value="forma">@Financeiro.NomeForma(forma)</MudSelectItem> }</MudSelect><MudNumericField T="decimal" @bind-Value="_taxa" Label="Taxa" Variant="Variant.Outlined" Min="0m" Max="@_valor" Format="C2" />@if (_forma == FormaPagamentoContrato.CartaoCredito) { <MudNumericField T="int?" @bind-Value="_parcelas" Label="Parcelas" Variant="Variant.Outlined" Min="1" Max="120" /> }<MudDatePicker @bind-Date="_dataRecebimento" Label="Data do recebimento" Variant="Variant.Outlined" DateFormat="dd/MM/yyyy" /><MudTimePicker @bind-Time="_horaRecebimento" Label="Horário" Variant="Variant.Outlined" /><MudTextField T="string" @bind-Value="_observacao" Label="Observação" Variant="Variant.Outlined" Lines="2" Class="form-full" /></div>
                        <div class="payment-net-preview"><span>Recebido bruto <strong>@_valor.ToString("C2")</strong></span><span>Taxa <strong>@_taxa.ToString("C2")</strong></span><span>Líquido recebido <strong>@((_valor - _taxa).ToString("C2"))</strong></span></div>
                        <div class="form-actions"><MudButton Variant="Variant.Text" OnClick="@(() => _registrandoPagamento = false)">Cancelar</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.CheckCircle" OnClick="RegistrarPagamentoAsync">Confirmar pagamento</MudButton></div>
                    </section>
                </Authorized></AuthorizeView>
            }

            <section class="module-panel section-card"><div class="section-heading section-card-heading"><div><span class="section-eyebrow">PAGAMENTOS</span><h2>Histórico de recebimentos</h2><p>Registros confirmados e estornados permanecem auditáveis.</p></div>@if (_conta.ValorEmAberto > 0 && !_registrandoPagamento) { <AuthorizeView Policy="@Permissoes.FinanceiroRegistrarPagamento"><Authorized><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AddCard" OnClick="NovoPagamento">Registrar pagamento</MudButton></Authorized></AuthorizeView> }</div>
                @if (_conta.Pagamentos.Count == 0) { <div class="compact-empty-state"><span><MudIcon Icon="@Icons.Material.Outlined.Payments" /></span><div><strong>Nenhum pagamento registrado</strong><p>O saldo integral permanece em aberto.</p></div></div> }
                else { <div class="payments-history">@foreach (var pagamento in _conta.Pagamentos) { <article class="@(pagamento.Status == StatusPagamentoContrato.Estornado ? "reversed-payment" : null)"><span class="payment-form-icon"><MudIcon Icon="@Icons.Material.Outlined.Payments" /></span><div class="payment-history-main"><strong>@Financeiro.NomeForma(pagamento.FormaPagamento) @Parcelas(pagamento)</strong><span>@pagamento.RecebidoEmUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @pagamento.RegistradoPorUsuarioNome</span>@if (!string.IsNullOrWhiteSpace(pagamento.Observacao)) { <p>@pagamento.Observacao</p> }@if (pagamento.Status == StatusPagamentoContrato.Estornado) { <p class="reversal-reason">Estornado por @pagamento.EstornadoPorUsuarioNome · @pagamento.EstornadoEmUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")<br />Motivo: @pagamento.MotivoEstorno</p> }</div><div class="payment-history-values"><strong>@pagamento.Valor.ToString("C2")</strong><span>Taxa @pagamento.Taxa.ToString("C2") · Líquido @pagamento.ValorLiquido.ToString("C2")</span><span class="status-badge @(pagamento.Status == StatusPagamentoContrato.Confirmado ? "status-confirmed" : "status-cancelled")">@(pagamento.Status == StatusPagamentoContrato.Confirmado ? "Confirmado" : "Estornado")</span>@if (pagamento.Status == StatusPagamentoContrato.Confirmado) { <AuthorizeView Policy="@Permissoes.FinanceiroEstornarPagamento"><Authorized><MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => SolicitarEstornoAsync(pagamento))">Estornar</MudButton></Authorized></AuthorizeView> }</div></article> }</div> }
            </section>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private ContaReceberDetalheResponse? _conta; private bool _carregando = true, _registrandoPagamento, _editandoVencimento; private decimal _valor, _taxa; private FormaPagamentoContrato _forma = FormaPagamentoContrato.Pix; private int? _parcelas; private string? _observacao; private DateTime? _dataRecebimento = DateTime.Today, _novoVencimento; private TimeSpan? _horaRecebimento = DateTime.Now.TimeOfDay;
    private string StatusEfetivo => _conta?.Vencida == true ? "Vencida" : _conta?.Status switch { StatusContaReceberContrato.EmAberto => "Em aberto", StatusContaReceberContrato.ParcialmentePago => "Parcialmente paga", _ => "Paga" };
    private string ClasseStatus => _conta?.Vencida == true ? "status-cancelled" : _conta?.Status switch { StatusContaReceberContrato.Pago => "status-confirmed", StatusContaReceberContrato.ParcialmentePago => "status-waiting", _ => "status-scheduled" };
    protected override Task OnParametersSetAsync() => CarregarAsync();
    private async Task CarregarAsync() { _carregando = true; var r = await FinanceiroApi.ObterAsync(Id); _conta = r.Resultado; if (!r.Sucesso) Mensagens.Mostrar(r.Mensagem, true); _carregando = false; }
    private void NovoPagamento() { if (_conta is null) return; _valor = _conta.ValorEmAberto; _taxa = 0; _forma = FormaPagamentoContrato.Pix; _parcelas = null; _observacao = null; _dataRecebimento = DateTime.Today; _horaRecebimento = DateTime.Now.TimeOfDay; _registrandoPagamento = true; }
    private async Task RegistrarPagamentoAsync() { if (_conta is null || _valor <= 0 || _valor > _conta.ValorEmAberto || _taxa < 0 || _taxa > _valor || !_dataRecebimento.HasValue) { Mensagens.Mostrar("Revise o valor, a taxa e a data do pagamento.", true); return; } if (_forma == FormaPagamentoContrato.Outro && string.IsNullOrWhiteSpace(_observacao)) { Mensagens.Mostrar("Descreva a forma de pagamento na observação.", true); return; } var dataHora = _dataRecebimento.Value.Date + (_horaRecebimento ?? TimeSpan.Zero); var r = await FinanceiroApi.RegistrarPagamentoAsync(Id, new(_forma, _valor, _taxa, _forma == FormaPagamentoContrato.CartaoCredito ? _parcelas : null, _observacao, dataHora)); Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Sucesso) { _conta = r.Resultado; _registrandoPagamento = false; } }
    private void EditarVencimento() { if (_conta is null) return; _novoVencimento = _conta.DataVencimento.ToDateTime(TimeOnly.MinValue); _editandoVencimento = true; }
    private async Task SalvarVencimentoAsync() { if (!_novoVencimento.HasValue) return; var r = await FinanceiroApi.AlterarVencimentoAsync(Id, new(DateOnly.FromDateTime(_novoVencimento.Value))); Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Sucesso) { _conta = r.Resultado; _editandoVencimento = false; } }
    private async Task SolicitarEstornoAsync(PagamentoResponse pagamento) { var parametros = new DialogParameters<EstornoPagamentoDialog> { { x => x.Forma, Financeiro.NomeForma(pagamento.FormaPagamento) }, { x => x.Valor, pagamento.Valor } }; var dialogo = await DialogService.ShowAsync<EstornoPagamentoDialog>("Estornar pagamento", parametros, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }); var resultado = await dialogo.Result; if (resultado is null || resultado.Canceled || resultado.Data is not string motivo) return; var r = await FinanceiroApi.EstornarPagamentoAsync(Id, pagamento.Id, new(motivo)); Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Sucesso) _conta = r.Resultado; }
    private static string Parcelas(PagamentoResponse pagamento) => pagamento.NumeroParcelas.HasValue ? $"· {pagamento.NumeroParcelas}x" : string.Empty;
}
