@page "/pacotes/novo"
@page "/pacotes/{Id:guid}/editar"
@attribute [Authorize]

<PageTitle>@(Id.HasValue ? "Editar pacote" : "Novo pacote") | Detara</PageTitle>
<AuthorizeView Policy="@Politica">
    <Authorized><CabecalhoPagina Titulo="@(Id.HasValue ? "Editar pacote" : "Novo pacote")" Descricao="Monte uma oferta com um ou mais serviços do catálogo." Sobretitulo="CATÁLOGO" /><section class="module-panel form-panel"><PacoteFormulario PacoteId="Id" /></section></Authorized>
    <NotAuthorized><EstadoVazio Titulo="Acesso não autorizado" Descricao="Seu perfil não possui permissão para esta operação." Icone="@Icons.Material.Outlined.Lock" /></NotAuthorized>
</AuthorizeView>

@code { [Parameter] public Guid? Id { get; set; } private string Politica => Id.HasValue ? Permissoes.PacotesEditar : Permissoes.PacotesCriar; }
