@page "/ordens-servico/nova"
@attribute [Authorize(Policy = Permissoes.OrdemServicoCriar)]
@inject OrdensServicoServico OrdensApi
@inject OrcamentosServico OrcamentosApi
@inject IMensagemServico Mensagens
@inject NavigationManager Navegacao

<PageTitle>Nova Ordem de Serviço | Detara</PageTitle>
<div class="page-container page-container-wide service-order-create-page">
    <CabecalhoPagina Titulo="Nova ordem de serviço" Descricao="Confirme a origem e o valor autorizado antes de iniciar o atendimento." Sobretitulo="ATENDIMENTO" />

    @if (_carregando)
    {
        <div class="module-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
    }
    else
    {
        <section class="module-panel service-order-origin">
            <div class="service-order-origin-icon"><MudIcon Icon="@IconeOrigem" /></div>
            <div class="service-order-origin-copy">
                <span class="section-eyebrow">ORIGEM DA ORDEM</span>
                <strong>@NomeOrigem</strong>
                <p>@DescricaoOrigem</p>
            </div>
            <span class="status-badge @(_orcamento is not null ? "status-running" : "status-neutral")">@RotuloOrigem</span>
        </section>

        @if (_orcamento is not null)
        {
            <div class="detail-stack">
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="page-alert">
                Os itens, descontos, acréscimos e valores são snapshots do orçamento aprovado e não serão recalculados pelo catálogo.
            </MudAlert>
            <div class="form-page-grid service-order-approved-grid">
                <main class="page-main-column">
                    <section class="module-panel section-card">
                        <CabecalhoSecao Sobretitulo="ORÇAMENTO APROVADO" Titulo="@_orcamento.Codigo" Descricao="Escopo comercial autorizado pelo cliente.">
                            <Complemento><strong class="section-total currency-value">@_orcamento.Total.ToString("C2")</strong></Complemento>
                        </CabecalhoSecao>
                        <div class="appointment-items">
                            @foreach (var item in _orcamento.Itens.OrderBy(item => item.Ordem))
                            {
                                <article><span class="package-order">@item.Ordem</span><div><strong>@item.Nome</strong><span>@item.Quantidade × @item.ValorUnitario.ToString("C2")</span></div><strong>@item.Subtotal.ToString("C2")</strong></article>
                            }
                        </div>
                    </section>
                </main>
                <ResumoLateral Icone="@Icons.Material.Outlined.Verified" Sobretitulo="RESUMO DA OS" Titulo="Valor autorizado">
                    <ChildContent><dl class="summary-list"><div><dt>Itens</dt><dd>@_orcamento.Itens.Count</dd></div><div><dt>Desconto</dt><dd class="currency-value">@_orcamento.Desconto.ToString("C2")</dd></div><div><dt>Acréscimo</dt><dd class="currency-value">@_orcamento.Acrescimo.ToString("C2")</dd></div></dl><div class="summary-total"><span>TOTAL AUTORIZADO</span><strong class="currency-value">@_orcamento.Total.ToString("C2")</strong></div><p class="summary-note"><MudIcon Icon="@Icons.Material.Outlined.Lock" /> O valor seguirá preservado na execução.</p></ChildContent>
                    <Acoes><MudButton Href="@($"/orcamentos/{_orcamento.Id}")" Variant="Variant.Text">Cancelar</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.FactCheck" OnClick="CriarAsync" Disabled="_salvando">@(_salvando ? "Criando..." : "Criar ordem de serviço")</MudButton></Acoes>
                </ResumoLateral>
            </div>
            </div>
        }
        else
        {
            <div class="form-page-grid">
                <main class="page-main-column">
                    <section class="module-panel section-card">
                        <CabecalhoSecao Sobretitulo="CLIENTE E VEÍCULO" Titulo="Dados do atendimento" Descricao="Identifique quem será atendido e o veículo recebido." Etapa="01" />
                        <div class="form-grid">
                            <ClienteOrcamentoAutocomplete ClienteId="_clienteId" ClienteNome="@_clienteNome" Fixo="@_agendamentoId.HasValue" SelecionadoChanged="ClienteSelecionadoAsync" />
                            <MudSelect T="Guid?" @bind-Value="_veiculoId" Label="Veículo *" Variant="Variant.Outlined" Disabled="@(!_clienteId.HasValue || _agendamentoId.HasValue)" Required="true">@foreach (var v in _veiculos) { <MudSelectItem T="Guid?" Value="@((Guid?)v.Id)">@v.Descricao · @v.Placa</MudSelectItem> }</MudSelect>
                        </div>
                        <div class="form-divider"></div>
                        <div class="form-grid service-order-operational-fields">
                            <MudNumericField T="int?" @bind-Value="_duracao" Label="Duração planejada em minutos (opcional)" Variant="Variant.Outlined" Min="1" />
                            <MudTextField T="string" @bind-Value="_observacaoAutorizacao" Label="Registro da autorização direta (opcional)" HelperText="Ex.: cliente aprovou presencialmente o valor informado." Variant="Variant.Outlined" Lines="2" />
                        </div>
                    </section>

                    <section class="module-panel section-card">
                        <CabecalhoSecao Sobretitulo="ESCOPO AUTORIZADO" Titulo="Serviços e valores" Descricao="Use o catálogo como referência e confirme o valor negociado." Etapa="02" />
                        <div class="catalog-tools">
                            <MudTextField T="string" @bind-Value="_pesquisaCatalogo" Label="Pesquisar no catálogo" Placeholder="Serviço ou pacote" Variant="Variant.Outlined" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" />
                            <div class="catalog-actions"><MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Search" OnClick="BuscarCatalogoAsync">Buscar</MudButton><MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Outlined.Add" OnClick="AdicionarPersonalizado">Item personalizado</MudButton></div>
                        </div>
                        @if (_catalogo.Count > 0)
                        {
                            <div class="quotation-catalog-picker">@foreach (var item in _catalogo) { <button type="button" class="quotation-catalog-item" @onclick="@(() => Adicionar(item))"><MudIcon Icon="@Icons.Material.Outlined.AutoFixHigh" /><span><strong>@item.Nome</strong><small>@Referencia(item)</small></span><MudIcon Icon="@Icons.Material.Outlined.AddCircleOutline" /></button> }</div>
                        }
                        @if (_itens.Count == 0)
                        {
                            <div class="items-empty"><span><MudIcon Icon="@Icons.Material.Outlined.PlaylistAdd" /></span><div><strong>Nenhum item autorizado</strong><p>Pesquise o catálogo ou adicione um item personalizado para compor a OS.</p></div></div>
                        }
                        else
                        {
                            <div class="quotation-items-editor">@for (var indice = 0; indice < _itens.Count; indice++) { var item = _itens[indice]; <article><div class="quotation-item-title"><span class="package-order">@(indice + 1)</span><div>@if (item.Tipo == TipoItemOrcamentoContrato.Personalizado) { <MudTextField T="string" @bind-Value="item.Nome" Label="Descrição *" Required="true" Variant="Variant.Outlined" /> } else { <strong>@item.Nome</strong><span>Referência: @item.Referencia</span> }</div><MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" OnClick="@(() => _itens.Remove(item))" aria-label="Remover item" /></div><div class="quotation-item-values"><MudNumericField T="int" @bind-Value="item.Quantidade" Label="Quantidade" Min="1" Variant="Variant.Outlined" /><MudNumericField T="decimal" @bind-Value="item.Valor" Label="Valor autorizado" Min="0" Format="C2" Variant="Variant.Outlined" /><div class="quotation-item-subtotal"><span>Subtotal</span><strong>@((item.Valor * item.Quantidade).ToString("C2"))</strong></div></div></article> }</div>
                        }
                    </section>
                </main>

                <ResumoLateral Icone="@Icons.Material.Outlined.ReceiptLong" Sobretitulo="RESUMO DA OS" Titulo="Total autorizado">
                    <ChildContent><dl class="summary-list"><div><dt>Origem</dt><dd>@RotuloOrigem</dd></div><div><dt>Itens</dt><dd>@_itens.Count</dd></div><div><dt>Subtotal</dt><dd class="currency-value">@Subtotal.ToString("C2")</dd></div></dl><div class="summary-total"><span>TOTAL AUTORIZADO</span><strong class="currency-value">@Subtotal.ToString("C2")</strong></div><p class="summary-note"><MudIcon Icon="@Icons.Material.Outlined.Info" /> Confirme os valores com o cliente antes de criar.</p></ChildContent>
                    <Acoes><MudButton Href="/ordens-servico" Variant="Variant.Text">Cancelar</MudButton><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.FactCheck" OnClick="CriarAsync" Disabled="_salvando">@(_salvando ? "Criando..." : "Criar ordem de serviço")</MudButton></Acoes>
                </ResumoLateral>
            </div>
        }
    }
</div>

@code {
    private bool _carregando = true, _salvando; private Guid? _orcamentoId, _agendamentoId, _clienteId, _veiculoId; private string? _clienteNome, _observacaoAutorizacao, _pesquisaCatalogo; private int? _duracao;
    private OrcamentoDetalheResponse? _orcamento; private IReadOnlyCollection<VeiculoOrcamentoResponse> _veiculos = []; private IReadOnlyCollection<ItemCatalogoOrcamentoResponse> _catalogo = []; private readonly List<ItemEdicao> _itens = [];
    private decimal Subtotal => _itens.Sum(item => item.Valor * item.Quantidade);
    private string NomeOrigem => _orcamento is not null ? $"Orçamento {_orcamento.Codigo}" : _agendamentoId.HasValue ? "Agendamento" : "Atendimento direto";
    private string RotuloOrigem => _orcamento is not null ? "Orçamento aprovado" : _agendamentoId.HasValue ? "Agenda" : "Acordo direto";
    private string IconeOrigem => _orcamento is not null ? Icons.Material.Outlined.Verified : _agendamentoId.HasValue ? Icons.Material.Outlined.EventAvailable : Icons.Material.Outlined.Handshake;
    private string DescricaoOrigem => _orcamento is not null ? "A fonte comercial é o documento aprovado." : _agendamentoId.HasValue ? "A Agenda sugere o escopo; confirme cada valor autorizado." : "Registre os valores confirmados diretamente pelo cliente.";
    protected override async Task OnInitializedAsync()
    {
        _orcamentoId = LerId("orcamentoId"); _agendamentoId = LerId("agendamentoId");
        if (_orcamentoId.HasValue)
        {
            var r = await OrcamentosApi.ObterAsync(_orcamentoId.Value); _orcamento = r.Resultado;
            if (_orcamento is null || _orcamento.Status != StatusOrcamentoContrato.Aprovado || _orcamento.OrdemServicoOrigemId.HasValue) { Mensagens.Mostrar("Somente um orçamento principal aprovado pode originar uma OS.", true); _orcamento = null; }
            else if (_orcamento.OrdemServicoId.HasValue) Navegacao.NavigateTo($"/ordens-servico/{_orcamento.OrdemServicoId}");
            else if (!_orcamento.AgendamentoId.HasValue) { Mensagens.Mostrar("Agende o atendimento antes de criar a ordem de serviço.", true); Navegacao.NavigateTo($"/agenda/novo?orcamentoId={_orcamento.Id}"); return; }
            else if (_agendamentoId.HasValue && _agendamentoId != _orcamento.AgendamentoId) { Mensagens.Mostrar("O agendamento informado não pertence a este orçamento.", true); Navegacao.NavigateTo($"/orcamentos/{_orcamento.Id}"); return; }
            else _agendamentoId = _orcamento.AgendamentoId;
        }
        else if (_agendamentoId.HasValue)
        {
            var r = await OrcamentosApi.ObterOrigemAsync(_agendamentoId.Value); var origem = r.Resultado;
            if (origem is not null) { _clienteId = origem.ClienteId; _clienteNome = origem.ClienteNome; _veiculoId = origem.VeiculoId; _veiculos = [new(origem.VeiculoId, origem.VeiculoDescricao, origem.VeiculoPlaca)]; _itens.AddRange(origem.Itens.Select(item => new ItemEdicao(item.TipoItem, item.Id, item.Nome, item.PrecoReferencia ?? 0, 1, Referencia(item)))); }
        }
        else { Navegacao.NavigateTo("/agenda/novo?agora=true"); return; }
        _carregando = false;
    }
    private async Task ClienteSelecionadoAsync(ClienteOrcamentoResponse? cliente) { _clienteId = cliente?.Id; _clienteNome = cliente?.Nome; _veiculoId = null; _veiculos = cliente is null ? [] : (await OrcamentosApi.ListarVeiculosAsync(cliente.Id)).Resultado ?? []; }
    private async Task BuscarCatalogoAsync() => _catalogo = (await OrcamentosApi.BuscarCatalogoAsync(_pesquisaCatalogo)).Resultado ?? [];
    private void Adicionar(ItemCatalogoOrcamentoResponse item) { if (_itens.Any(i => i.Tipo == item.TipoItem && i.Id == item.Id)) { Mensagens.Mostrar("Este item já foi incluído; ajuste a quantidade.", true); return; } _itens.Add(new(item.TipoItem, item.Id, item.Nome, item.PrecoReferencia ?? 0, 1, Referencia(item))); }
    private void AdicionarPersonalizado() => _itens.Add(new(TipoItemOrcamentoContrato.Personalizado, null, string.Empty, 0, 1, "Sem referência de catálogo"));
    private async Task CriarAsync()
    {
        if (_orcamento is null && (!_clienteId.HasValue || !_veiculoId.HasValue || _itens.Count == 0)) { Mensagens.Mostrar("Informe cliente, veículo e ao menos um item autorizado.", true); return; }
        _salvando = true;
        var request = new CriarOrdemServicoRequest(_orcamento?.Id, _agendamentoId, _clienteId, _veiculoId, _duracao, 0, 0,
            _observacaoAutorizacao, _orcamento is not null ? [] : _itens.Select(item => new ItemOrdemServicoRequest(item.Tipo, item.Id,
                item.Tipo == TipoItemOrcamentoContrato.Personalizado ? item.Nome : null, null, item.Valor, item.Quantidade, null)).ToArray());
        var r = await OrdensApi.CriarAsync(request); _salvando = false; Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Resultado is not null) Navegacao.NavigateTo($"/ordens-servico/{r.Resultado.Id}");
    }
    private Guid? LerId(string nome) { var query = Navegacao.ToAbsoluteUri(Navegacao.Uri).Query.TrimStart('?'); foreach (var parte in query.Split('&', StringSplitOptions.RemoveEmptyEntries)) { var p = parte.Split('=', 2); if (p.Length == 2 && p[0].Equals(nome, StringComparison.OrdinalIgnoreCase) && Guid.TryParse(Uri.UnescapeDataString(p[1]), out var id)) return id; } return null; }
    private static string Referencia(ItemCatalogoOrcamentoResponse item) => item.TipoPrecificacao == TipoPrecificacaoCatalogo.APartirDe && item.PrecoReferencia.HasValue ? $"A partir de {item.PrecoReferencia:C2}" : item.PrecoReferencia?.ToString("C2") ?? "Sob consulta";
    private sealed class ItemEdicao(TipoItemOrcamentoContrato tipo, Guid? id, string nome, decimal valor, int quantidade, string referencia) { public TipoItemOrcamentoContrato Tipo { get; } = tipo; public Guid? Id { get; } = id; public string Nome { get; set; } = nome; public decimal Valor { get; set; } = valor; public int Quantidade { get; set; } = quantidade; public string Referencia { get; } = referencia; }
}
