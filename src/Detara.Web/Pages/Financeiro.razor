@page "/financeiro"
@attribute [Authorize(Policy = Permissoes.FinanceiroVisualizar)]
@inject FinanceiroServico FinanceiroApi
@inject IMensagemServico Mensagens

<PageTitle>Financeiro | Detara</PageTitle>
<div class="page-container page-container-fluid financial-dashboard-page">
    <CabecalhoPagina Titulo="Visão financeira" Descricao="Recebimentos, taxas e saldos da operação em uma leitura confiável." Sobretitulo="FINANCEIRO">
        <Acoes><MudButton Href="/financeiro/despesas" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.ReceiptLong">Despesas</MudButton><MudButton Href="/financeiro/contas-receber" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.RequestQuote">Contas a receber</MudButton></Acoes>
    </CabecalhoPagina>

    <section class="module-toolbar financial-period-toolbar">
        <MudDatePicker @bind-Date="_inicio" Label="Início" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
        <MudDatePicker @bind-Date="_fim" Label="Fim" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CarregarAsync">Atualizar período</MudButton>
    </section>

    @if (_carregando) { <div class="module-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div> }
    else if (_resumo is not null)
    {
        <section class="financial-overview-groups" aria-label="Resumo financeiro">
            <article class="financial-overview-group">
                <div class="financial-group-heading"><span class="section-eyebrow">ENTRADAS</span><p>Competência e caixa no período selecionado</p></div>
                <div class="financial-group-metrics">
                    <CardMetrica Icone="@Icons.Material.Outlined.RequestQuote" Rotulo="FATURADO" Valor="@Moeda(_resumo.Faturado)" Descricao="Por competência" ValorSemQuebra="true" />
                    <CardMetrica Icone="@Icons.Material.Outlined.AccountBalanceWallet" Rotulo="RECEBIDO LÍQUIDO" Valor="@Moeda(_resumo.ReceitaLiquidaRecebida)" Descricao="Por caixa, após taxas" Destaque="true" ValorSemQuebra="true" />
                </div>
            </article>
            <article class="financial-overview-group">
                <div class="financial-group-heading"><span class="section-eyebrow">SAÍDAS</span><p>Compromissos e pagamentos de despesas</p></div>
                <div class="financial-group-metrics">
                    <CardMetrica Icone="@Icons.Material.Outlined.ReceiptLong" Rotulo="DESPESAS PREVISTAS" Valor="@Moeda(_resumo.DespesasPrevistasPeriodo)" Descricao="Por competência" ValorSemQuebra="true" />
                    <CardMetrica Icone="@Icons.Material.Outlined.Payments" Rotulo="DESPESAS PAGAS" Valor="@Moeda(_resumo.DespesasPagasPeriodo)" Descricao="Por caixa no período" ValorSemQuebra="true" />
                </div>
            </article>
            <article class="financial-overview-group financial-result-group">
                <div class="financial-group-heading"><span class="section-eyebrow">RESULTADO OPERACIONAL</span><p>Movimentações confirmadas no período</p></div>
                <CardMetrica Icone="@Icons.Material.Outlined.Balance" Rotulo="SALDO OPERACIONAL" Valor="@Moeda(_resumo.SaldoOperacionalPeriodo)" Descricao="Recebido líquido menos despesas pagas — não é lucro" Destaque="true" ValorSemQuebra="true" Classe="@($"financial-balance-card {(_resumo.SaldoOperacionalPeriodo < 0 ? "financial-negative-card" : null)}")" />
            </article>
        </section>

        <section class="financial-position-strip" aria-label="Posição financeira atual e detalhes do período">
            <div><span>Recebido bruto · período</span><strong>@Moeda(_resumo.RecebidoBruto)</strong></div>
            <div><span>Taxas · período</span><strong>@Moeda(_resumo.Taxas)</strong></div>
            <div><span>Recebíveis em aberto · atual</span><strong>@Moeda(_resumo.EmAbertoAtual)</strong></div>
            <div class="financial-overdue-value"><span>Recebíveis vencidos · atual</span><strong>@Moeda(_resumo.VencidoAtual)</strong></div>
            <div><span>Despesas em aberto · atual</span><strong>@Moeda(_resumo.DespesasEmAbertoAtual)</strong></div>
            <div class="financial-overdue-value"><span>Despesas vencidas · atual</span><strong>@Moeda(_resumo.DespesasVencidasAtual)</strong></div>
            <div><span>Ticket médio · competência</span><strong>@Moeda(_resumo.TicketMedio)</strong></div>
        </section>

        <section class="financial-dashboard-grid">
            <article class="module-panel section-card">
                <div class="section-heading section-card-heading"><div><span class="section-eyebrow">RECEBIMENTOS</span><h2>Formas de pagamento</h2><p>Distribuição dos pagamentos confirmados no período.</p></div></div>
                @if (_resumo.FormasPagamento.Count == 0)
                { <div class="compact-empty-state"><span><MudIcon Icon="@Icons.Material.Outlined.Payments" /></span><div><strong>Nenhum recebimento no período</strong><p>Os pagamentos confirmados aparecerão aqui.</p></div></div> }
                else
                {
                    <div class="payment-distribution">
                        @foreach (var forma in _resumo.FormasPagamento.OrderByDescending(x => x.Valor))
                        { <article><span class="payment-form-icon"><MudIcon Icon="@IconeForma(forma.FormaPagamento)" /></span><div><strong>@NomeForma(forma.FormaPagamento)</strong><span>@forma.Quantidade pagamento(s)</span></div><strong>@Moeda(forma.Valor)</strong></article> }
                    </div>
                }
            </article>
            <article class="module-panel financial-definition-card">
                <span class="metric-summary-icon"><MudIcon Icon="@Icons.Material.Outlined.Info" /></span>
                <div><span class="section-eyebrow">LEITURA DOS NÚMEROS</span><h2>Caixa e competência permanecem separados</h2><p>O saldo operacional compara somente caixa confirmado: recebimentos menos taxas e pagamentos de despesas na data selecionada. Faturado e despesas previstas usam competência e não entram nessa fórmula. O indicador não representa lucro contábil.</p><MudButton Href="/financeiro/contas-receber" Variant="Variant.Text" EndIcon="@Icons.Material.Outlined.ArrowForward">Explorar contas</MudButton></div>
            </article>
        </section>
    }
</div>

@code {
    private ResumoFinanceiroResponse? _resumo; private bool _carregando = true; private DateTime? _inicio, _fim;
    protected override Task OnInitializedAsync() => CarregarAsync();
    private async Task CarregarAsync()
    {
        _carregando = true;
        var r = await FinanceiroApi.ObterResumoAsync(_inicio.HasValue ? DateOnly.FromDateTime(_inicio.Value) : null,
            _fim.HasValue ? DateOnly.FromDateTime(_fim.Value) : null);
        _resumo = r.Resultado;
        if (_resumo is not null) { _inicio = _resumo.Inicio.ToDateTime(TimeOnly.MinValue); _fim = _resumo.Fim.ToDateTime(TimeOnly.MinValue); }
        if (!r.Sucesso) Mensagens.Mostrar(r.Mensagem, true);
        _carregando = false;
    }
    private static string Moeda(decimal valor) => valor.ToString("C2");
    internal static string NomeForma(FormaPagamentoContrato forma) => forma switch { FormaPagamentoContrato.CartaoDebito => "Cartão de débito", FormaPagamentoContrato.CartaoCredito => "Cartão de crédito", FormaPagamentoContrato.Transferencia => "Transferência", _ => forma.ToString() };
    private static string IconeForma(FormaPagamentoContrato forma) => forma switch { FormaPagamentoContrato.Pix => Icons.Material.Outlined.QrCode2, FormaPagamentoContrato.Dinheiro => Icons.Material.Outlined.Payments, FormaPagamentoContrato.CartaoDebito or FormaPagamentoContrato.CartaoCredito => Icons.Material.Outlined.CreditCard, FormaPagamentoContrato.Boleto => Icons.Material.Outlined.Receipt, FormaPagamentoContrato.Transferencia => Icons.Material.Outlined.AccountBalance, _ => Icons.Material.Outlined.MoreHoriz };
}
