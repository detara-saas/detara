@page "/servicos/{Id:guid}"
@attribute [Authorize(Policy = Permissoes.ServicosVisualizar)]
@inject CatalogoServico Catalogo
@inject IMensagemServico Mensagens

<PageTitle>@(_servico?.Nome ?? "Serviço") | Detara</PageTitle>
<div class="page-container page-container-focused">
@if (_carregando) { <div class="module-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div> }
else if (_servico is null) { <EstadoVazio Titulo="Serviço não encontrado" Descricao="O serviço não existe ou não pertence à empresa atual." Icone="@Icons.Material.Outlined.HomeRepairService" /> }
else
{
    <CabecalhoPagina Titulo="@_servico.Nome" Descricao="@_servico.CategoriaNome" Sobretitulo="SERVIÇO"><Acoes><span class="status-badge @(_servico.EhAtivo ? "status-running" : "status-neutral")">@(_servico.EhAtivo ? "Ativo" : "Inativo")</span><AuthorizeView Policy="@Permissoes.ServicosEditar"><Authorized><MudButton Href="@($"/servicos/{Id}/editar")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Edit">Editar</MudButton><MudButton Variant="Variant.Text" Color="@(_servico.EhAtivo ? Color.Error : Color.Primary)" OnClick="SolicitarStatus">@(_servico.EhAtivo ? "Inativar" : "Ativar")</MudButton></Authorized></AuthorizeView></Acoes></CabecalhoPagina>
    @if (_confirmando) { <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="confirmation-strip"><div><strong>Confirmar @(_servico.EhAtivo ? "inativação" : "ativação")?</strong><span>O histórico e os vínculos com pacotes serão preservados.</span></div><div><MudButton Variant="Variant.Text" OnClick="CancelarStatus">Cancelar</MudButton><MudButton Variant="Variant.Filled" Color="@(_servico.EhAtivo ? Color.Error : Color.Primary)" OnClick="ConfirmarStatusAsync">Confirmar</MudButton></div></MudAlert> }
    <div class="detail-grid"><section class="module-panel detail-card"><div class="section-heading"><div><span class="section-eyebrow">RESUMO</span><h2>Dados comerciais</h2></div></div><dl class="detail-list"><div><dt>Categoria</dt><dd>@_servico.CategoriaNome</dd></div><div><dt>Preço de referência</dt><dd>@FormatacaoCatalogo.Preco(_servico.TipoPrecificacao, _servico.PrecoBase)</dd></div><div><dt>Duração estimada</dt><dd>@FormatarDuracao(_servico.DuracaoEstimadaMinutos)</dd></div><div><dt>Ordem</dt><dd>@_servico.Ordem</dd></div></dl></section><section class="module-panel detail-card detail-observation"><div class="section-heading"><div><span class="section-eyebrow">DESCRIÇÃO</span><h2>Escopo do serviço</h2></div></div><p>@(string.IsNullOrWhiteSpace(_servico.Descricao) ? "Nenhuma descrição registrada." : _servico.Descricao)</p></section></div>
    <section class="module-panel related-section"><div class="section-heading"><div><span class="section-eyebrow">HISTÓRICO</span><h2>Execuções do serviço</h2><p>As 10 finalizações mais recentes em ordens de serviço.</p></div></div>
        @if (_servico.Execucoes.Count == 0)
        { <div class="compact-empty"><MudIcon Icon="@Icons.Material.Outlined.History" /><div><strong>Nenhuma execução registrada</strong><span>O histórico aparecerá após a execução ser finalizada em uma ordem de serviço.</span></div></div> }
        else
        {
            <div class="catalog-execution-history">
            @foreach (var execucao in _servico.Execucoes)
            { <a href="@($"/ordens-servico/{execucao.OrdemServicoId}")"><span class="catalog-execution-icon"><MudIcon Icon="@Icons.Material.Outlined.Handyman" /></span><div><strong>@execucao.ClienteNome · @FormatacaoVeiculo.Exibir(execucao.VeiculoDescricao, execucao.VeiculoPlaca)</strong><span>@execucao.OrdemServicoCodigo · @execucao.ExecutadaEmUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span></div><DetaraStatusBadge Texto="@NomeStatus(execucao.Status)" Tone="DetaraStatusTone.Positive" /><strong class="currency-value">@((execucao.ValorUnitario * execucao.Quantidade).ToString("C2"))</strong><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a> }
            </div>
        }
    </section>
}

</div>

@code {
    [Parameter] public Guid Id { get; set; }
    private ServicoDetalheResponse? _servico;
    private bool _carregando = true;
    private bool _confirmando;
    protected override async Task OnParametersSetAsync() { _carregando = true; var resultado = await Catalogo.ObterServicoAsync(Id); _servico = resultado.Resultado; if (!resultado.Sucesso) Mensagens.Mostrar(resultado.Mensagem, true); _carregando = false; }
    private void SolicitarStatus() => _confirmando = true;
    private void CancelarStatus() => _confirmando = false;
    private async Task ConfirmarStatusAsync() { if (_servico is null) return; var resultado = await Catalogo.AlterarStatusServicoAsync(Id, !_servico.EhAtivo); Mensagens.Mostrar(resultado.Mensagem, !resultado.Sucesso); _confirmando = false; if (resultado.Sucesso) await OnParametersSetAsync(); }
    private static string FormatarDuracao(int? minutos) => minutos.HasValue ? $"{minutos.Value} min" : "Não informada";
    private static string NomeStatus(StatusOrdemServicoContrato status) => status == StatusOrdemServicoContrato.Concluida ? "Concluída" : "Execução finalizada";
}
