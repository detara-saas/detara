@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@implements IDisposable
@using Detara.Contracts.Autenticacao
@inject AutenticacaoServico Autenticacao
@inject PreferenciasInterfaceServico Preferencias
@inject PwaServico Pwa
@inject IMensagemServico Mensagens
@inject NavigationManager Navigation

<PageTitle>Entrar | Detara</PageTitle>

<section class="login-brand-panel" aria-label="Detara">
    <img src="brand/detara-logo-on-dark.png"
         alt="Detara — Gestão para estéticas automotivas"
         class="login-brand-logo" />
    <div class="login-message">
        <span class="login-eyebrow">GESTÃO AUTOMOTIVA, SEM RUÍDO</span>
        <MudText Typo="Typo.h1">Sua operação,<br />sob controle.</MudText>
        <MudText Typo="Typo.body1">
            Clareza para organizar a agenda, acompanhar cada veículo e entregar uma experiência à altura do seu trabalho.
        </MudText>
    </div>
    <MudText Typo="Typo.caption" Class="login-signature">ORGANIZE · ATENDA · EVOLUA</MudText>
</section>

<section class="login-form-panel">
    <div class="login-theme-picker">
        <MudMenu Icon="@IconeTema" AnchorOrigin="Origin.BottomRight" aria-label="Escolher aparência">
            <MudMenuItem Icon="@Icons.Material.Outlined.SettingsBrightness" OnClick="@(() => Preferencias.DefinirTemaAsync("Sistema"))">Sistema</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.LightMode" OnClick="@(() => Preferencias.DefinirTemaAsync("Claro"))">Claro</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.DarkMode" OnClick="@(() => Preferencias.DefinirTemaAsync("Escuro"))">Escuro</MudMenuItem>
        </MudMenu>
    </div>
    <MudPaper Elevation="0" Class="login-card">
        <PwaStatus />
        <div class="login-mobile-brand">
            <img src="brand/detara-logo-on-light.png" alt="Detara" />
        </div>
        <MudText Typo="Typo.h2">Acesse sua conta</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="login-subtitle">
            Informe sua empresa e suas credenciais para continuar.
        </MudText>
        <MudForm @ref="_form">
            <MudTextField T="string" @bind-Value="_slugEmpresa" Label="Empresa" Placeholder="ex.: premium-detail"
                          Variant="Variant.Outlined" Required="true" RequiredError="Informe a empresa."
                          Class="login-field" autocomplete="organization" />
            <MudTextField T="string" @bind-Value="_email" Label="E-mail" InputType="InputType.Email"
                          Variant="Variant.Outlined" Required="true" RequiredError="Informe o e-mail."
                          Class="login-field" autocomplete="username" />
            <MudTextField T="string" @bind-Value="_senha" Label="Senha" InputType="InputType.Password"
                          Variant="Variant.Outlined" Required="true" RequiredError="Informe a senha."
                          Class="login-field" autocomplete="current-password" />
            <MudButton FullWidth="true" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                       Disabled="@_processando" OnClick="EntrarAsync" Class="login-button">
                @if (_processando)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Entrar
            </MudButton>
        </MudForm>
        <div class="login-security-note">
            <MudIcon Icon="@Icons.Material.Outlined.Lock" Size="Size.Small" />
            <MudText Typo="Typo.caption">Ambiente seguro e isolado para sua empresa.</MudText>
        </div>
        @if (Pwa.PodeInstalar)
        {
            <MudButton FullWidth="true"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Outlined.InstallMobile"
                       OnClick="InstalarAsync"
                       Class="login-install-button">
                Instalar Detara
            </MudButton>
        }
        <MudText Typo="Typo.caption" Color="Color.Secondary" Align="Align.Center" Class="login-help">
            Problemas para acessar? Fale com o administrador da sua empresa.
        </MudText>
    </MudPaper>
</section>

@code {
    private MudForm _form = null!;
    private string _slugEmpresa = string.Empty;
    private string _email = string.Empty;
    private string _senha = string.Empty;
    private bool _processando;
    private string IconeTema => Preferencias.Atual.Tema switch
    {
        "Claro" => Icons.Material.Outlined.LightMode,
        "Escuro" => Icons.Material.Outlined.DarkMode,
        _ => Icons.Material.Outlined.SettingsBrightness
    };

    [SupplyParameterFromQuery]
    public string? Retorno { get; set; }

    protected override void OnInitialized() => Pwa.Alterado += AtualizarPwa;

    private async Task EntrarAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid || _processando)
        {
            return;
        }

        _processando = true;
        try
        {
            var resultado = await Autenticacao.EntrarAsync(new LoginRequest(_slugEmpresa, _email, _senha));
            Mensagens.Mostrar(resultado.Mensagem, !resultado.Sucesso);
            if (resultado.Sucesso)
            {
                Navigation.NavigateTo(ObterDestinoSeguro());
            }
        }
        catch (HttpRequestException)
        {
            Mensagens.Mostrar("Não foi possível conectar à Detara. Verifique sua conexão e tente novamente.", true);
        }
        finally
        {
            _processando = false;
        }
    }

    private string ObterDestinoSeguro()
    {
        if (Retorno is not { Length: > 0 } ||
            !Uri.TryCreate(Retorno, UriKind.Relative, out _) ||
            !Retorno.StartsWith('/') ||
            Retorno.StartsWith("//", StringComparison.Ordinal) ||
            Retorno.Contains('\\'))
        {
            return "/dashboard";
        }

        return Retorno;
    }

    private async Task InstalarAsync()
    {
        if (await Pwa.InstalarAsync())
        {
            Mensagens.Mostrar("Detara instalada com sucesso.");
        }
    }

    private void AtualizarPwa() => InvokeAsync(StateHasChanged);

    public void Dispose() => Pwa.Alterado -= AtualizarPwa;
}
