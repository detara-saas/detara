@page "/orcamentos"
@attribute [Authorize(Policy = Permissoes.OrcamentosVisualizar)]
@inject OrcamentosServico OrcamentosApi
@inject IMensagemServico Mensagens

<PageTitle>Orçamentos | Detara</PageTitle>
<div class="page-container page-container-fluid list-page">
<CabecalhoPagina Titulo="Orçamentos" Descricao="Propostas comerciais formais, valores negociados e aprovações." Sobretitulo="ATENDIMENTO">
    <Acoes><AuthorizeView Policy="@Permissoes.OrcamentosCriar"><Authorized><MudButton Href="/orcamentos/novo" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add">Novo orçamento</MudButton></Authorized></AuthorizeView></Acoes>
</CabecalhoPagina>

<section class="module-toolbar quotation-list-filters">
    <MudTextField T="string" @bind-Value="_pesquisa" Placeholder="Código, cliente, documento, placa ou veículo" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Class="module-search" />
    <MudSelect T="StatusOrcamentoContrato?" @bind-Value="_status" Label="Status" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
        @foreach (var status in Enum.GetValues<StatusOrcamentoContrato>()) { <MudSelectItem T="StatusOrcamentoContrato?" Value="status">@NomeStatus(status)</MudSelectItem> }
    </MudSelect>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="PesquisarAsync">Aplicar filtros</MudButton>
</section>

@if (_carregando) { <DetaraSkeleton Variant="DetaraSkeletonVariant.Table" Rotulo="Carregando orçamentos" /> }
else if (_pagina is null || _pagina.Itens.Count == 0)
{
    <DetaraEmptyState Titulo="@(TemFiltrosAtivos ? "Nenhum orçamento corresponde aos filtros" : "Nenhum orçamento criado")" Descricao="@(TemFiltrosAtivos ? "Revise a pesquisa ou o status para ampliar os resultados." : "Use orçamentos quando precisar formalizar uma proposta e aprovação. Atendimentos diretos continuam disponíveis.")" Icone="@Icons.Material.Outlined.RequestQuote"><Acao>@if (!TemFiltrosAtivos) { <AuthorizeView Policy="@Permissoes.OrcamentosCriar"><Authorized><MudButton Href="/orcamentos/novo" Variant="Variant.Filled" Color="Color.Primary">Novo orçamento</MudButton></Authorized></AuthorizeView> }</Acao></DetaraEmptyState>
}
else
{
    <section class="module-panel desktop-list"><table class="module-table"><thead><tr><th>Código</th><th>Cliente</th><th>Veículo</th><th>Emissão / validade</th><th>Valor</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var item in _pagina.Itens)
        {
            <tr><td><a class="primary-link" href="@($"/orcamentos/{item.Id}")">@Identificacao(item)</a></td><td>@item.ClienteNome</td><td>@FormatacaoVeiculo.Exibir(item.VeiculoDescricao, item.VeiculoPlaca)</td><td>@(item.EmitidoEmUtc?.ToString("dd/MM/yyyy") ?? "Não emitido")<span class="cell-caption">Válido até @item.ValidoAte.ToString("dd/MM/yyyy")</span></td><td><strong>@item.Total.ToString("C2")</strong></td><td><DetaraStatusBadge Texto="@NomeStatus(item.Status)" Tone="@TomStatus(item.Status)" /></td><td><MudIconButton Href="@($"/orcamentos/{item.Id}")" Icon="@Icons.Material.Outlined.ChevronRight" aria-label="Abrir orçamento" /></td></tr>
        }
    </tbody></table></section>
    <section class="mobile-list">@foreach (var item in _pagina.Itens) { <a class="mobile-record quotation-mobile-record" href="@($"/orcamentos/{item.Id}")"><div class="mobile-record-main"><strong>@Identificacao(item)</strong><span>@item.ClienteNome</span><span>@FormatacaoVeiculo.Exibir(item.VeiculoDescricao, item.VeiculoPlaca)</span><strong>@item.Total.ToString("C2")</strong><span>Válido até @item.ValidoAte.ToString("dd/MM")</span></div><DetaraStatusBadge Texto="@NomeStatus(item.Status)" Tone="@TomStatus(item.Status)" /><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a> }</section>
    <div class="module-pagination"><span>@_pagina.TotalItens registro(s) · Página @_pagina.Pagina de @Math.Max(1, _pagina.TotalPaginas)</span><div><MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft" Disabled="@(_pagina.Pagina <= 1)" OnClick="@(() => MoverPaginaAsync(-1))" aria-label="Página anterior" /><MudIconButton Icon="@Icons.Material.Outlined.ChevronRight" Disabled="@(_pagina.Pagina >= _pagina.TotalPaginas)" OnClick="@(() => MoverPaginaAsync(1))" aria-label="Próxima página" /></div></div>
}
</div>

@code {
    private PaginaResponse<OrcamentoListaResponse>? _pagina; private bool _carregando = true; private int _paginaAtual = 1; private string? _pesquisa; private StatusOrcamentoContrato? _status;
    private bool TemFiltrosAtivos => !string.IsNullOrWhiteSpace(_pesquisa) || _status.HasValue;
    protected override Task OnInitializedAsync() => CarregarAsync();
    private async Task CarregarAsync() { _carregando = true; var r = await OrcamentosApi.ListarAsync(_paginaAtual, 25, _pesquisa, _status); _pagina = r.Resultado; if (!r.Sucesso) Mensagens.Mostrar(r.Mensagem, true); _carregando = false; }
    private async Task PesquisarAsync() { _paginaAtual = 1; await CarregarAsync(); }
    private async Task MoverPaginaAsync(int delta) { _paginaAtual += delta; await CarregarAsync(); }
    private static string NomeStatus(StatusOrcamentoContrato status) => status switch { StatusOrcamentoContrato.Substituido => "Substituído", StatusOrcamentoContrato.Expirado => "Expirado", _ => status.ToString() };
    private static string Identificacao(OrcamentoListaResponse item) => item.Codigo ?? (item.Status == StatusOrcamentoContrato.Rascunho ? "Rascunho" : "Sem emissão");
    private static DetaraStatusTone TomStatus(StatusOrcamentoContrato status) => status switch { StatusOrcamentoContrato.Emitido => DetaraStatusTone.Info, StatusOrcamentoContrato.Aprovado => DetaraStatusTone.Positive, StatusOrcamentoContrato.Recusado or StatusOrcamentoContrato.Cancelado => DetaraStatusTone.Critical, StatusOrcamentoContrato.Expirado => DetaraStatusTone.Warning, _ => DetaraStatusTone.Neutral };
}
