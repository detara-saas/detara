@page "/ordens-servico"
@attribute [Authorize(Policy = Permissoes.OrdemServicoVisualizar)]
@inject OrdensServicoServico OrdensApi
@inject IMensagemServico Mensagens

<PageTitle>Ordens de Serviço | Detara</PageTitle>
<div class="page-container page-container-fluid list-page">
<CabecalhoPagina Titulo="Ordens de Serviço" Descricao="Check-in, execução, evidências e escopo autorizado do atendimento." Sobretitulo="ATENDIMENTO">
    <Acoes><AuthorizeView Policy="@Permissoes.OrdemServicoCriar"><Authorized><MudButton Href="/ordens-servico/nova" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add">Nova ordem de serviço</MudButton></Authorized></AuthorizeView></Acoes>
</CabecalhoPagina>

<section class="module-toolbar service-order-filters">
    <MudTextField T="string" @bind-Value="_pesquisa" Placeholder="Código, cliente, placa ou veículo" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Class="module-search" />
    <MudSelect T="StatusOrdemServicoContrato?" @bind-Value="_status" Label="Status" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
        @foreach (var status in Enum.GetValues<StatusOrdemServicoContrato>()) { <MudSelectItem T="StatusOrdemServicoContrato?" Value="status">@NomeStatus(status)</MudSelectItem> }
    </MudSelect>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="PesquisarAsync">Aplicar filtros</MudButton>
</section>

@if (_carregando) { <DetaraSkeleton Variant="DetaraSkeletonVariant.Table" Rotulo="Carregando ordens de serviço" /> }
else if (_pagina is null || _pagina.Itens.Count == 0)
{
    <DetaraEmptyState Titulo="@(TemFiltrosAtivos ? "Nenhuma ordem corresponde aos filtros" : "Nenhuma ordem de serviço iniciada")" Descricao="@(TemFiltrosAtivos ? "Revise a pesquisa ou o status para ampliar os resultados." : "A Ordem de Serviço organiza check-in, execução, evidências e o escopo autorizado do atendimento.")" Icone="@Icons.Material.Outlined.FactCheck"><Acao>@if (!TemFiltrosAtivos) { <AuthorizeView Policy="@Permissoes.OrdemServicoCriar"><Authorized><MudButton Href="/ordens-servico/nova" Variant="Variant.Filled" Color="Color.Primary">Nova ordem de serviço</MudButton></Authorized></AuthorizeView> }</Acao></DetaraEmptyState>
}
else
{
    <section class="module-panel desktop-list"><table class="module-table"><thead><tr><th>Código</th><th>Cliente</th><th>Veículo</th><th>Criada em</th><th>Total autorizado</th><th>Status</th><th></th></tr></thead><tbody>
        @foreach (var item in _pagina.Itens) { <tr><td><a class="primary-link" href="@($"/ordens-servico/{item.Id}")">@item.Codigo</a></td><td>@item.ClienteNome</td><td>@FormatacaoVeiculo.Exibir(item.VeiculoDescricao, item.VeiculoPlaca)</td><td>@item.CriadoEmUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td><td><strong>@item.TotalAutorizado.ToString("C2")</strong></td><td><DetaraStatusBadge Texto="@NomeStatus(item.Status)" Tone="@TomStatus(item.Status)" /></td><td><MudIconButton Href="@($"/ordens-servico/{item.Id}")" Icon="@Icons.Material.Outlined.ChevronRight" aria-label="Abrir ordem de serviço" /></td></tr> }
    </tbody></table></section>
    <section class="mobile-list">@foreach (var item in _pagina.Itens) { <a class="mobile-record service-order-mobile" href="@($"/ordens-servico/{item.Id}")"><div class="mobile-record-main"><strong>@item.Codigo</strong><span>@item.ClienteNome</span><span>@FormatacaoVeiculo.Exibir(item.VeiculoDescricao, item.VeiculoPlaca)</span><strong>@item.TotalAutorizado.ToString("C2")</strong></div><DetaraStatusBadge Texto="@NomeStatus(item.Status)" Tone="@TomStatus(item.Status)" /><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a> }</section>
    <div class="module-pagination"><span>@_pagina.TotalItens registro(s) · Página @_pagina.Pagina de @Math.Max(1, _pagina.TotalPaginas)</span><div><MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft" Disabled="@(_pagina.Pagina <= 1)" OnClick="@(() => MoverAsync(-1))" /><MudIconButton Icon="@Icons.Material.Outlined.ChevronRight" Disabled="@(_pagina.Pagina >= _pagina.TotalPaginas)" OnClick="@(() => MoverAsync(1))" /></div></div>
}
</div>

@code {
    private PaginaResponse<OrdemServicoListaResponse>? _pagina; private bool _carregando = true; private int _paginaAtual = 1; private string? _pesquisa; private StatusOrdemServicoContrato? _status;
    private bool TemFiltrosAtivos => !string.IsNullOrWhiteSpace(_pesquisa) || _status.HasValue;
    protected override Task OnInitializedAsync() => CarregarAsync();
    private async Task CarregarAsync() { _carregando = true; var r = await OrdensApi.ListarAsync(_paginaAtual, 25, _pesquisa, _status); _pagina = r.Resultado; if (!r.Sucesso) Mensagens.Mostrar(r.Mensagem, true); _carregando = false; }
    private async Task PesquisarAsync() { _paginaAtual = 1; await CarregarAsync(); }
    private async Task MoverAsync(int delta) { _paginaAtual += delta; await CarregarAsync(); }
    internal static string NomeStatus(StatusOrdemServicoContrato status) => status switch { StatusOrdemServicoContrato.EmExecucao => "Em execução", StatusOrdemServicoContrato.AguardandoRetirada => "Aguardando retirada", StatusOrdemServicoContrato.Concluida => "Concluída", _ => status.ToString() };
    internal static DetaraStatusTone TomStatus(StatusOrdemServicoContrato status) => status switch { StatusOrdemServicoContrato.Aberta => DetaraStatusTone.Info, StatusOrdemServicoContrato.EmExecucao or StatusOrdemServicoContrato.Concluida => DetaraStatusTone.Positive, StatusOrdemServicoContrato.AguardandoRetirada => DetaraStatusTone.Warning, _ => DetaraStatusTone.Critical };
}
