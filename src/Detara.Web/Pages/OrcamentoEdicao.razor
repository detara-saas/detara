@page "/orcamentos/{Id:guid}/editar"
@attribute [Authorize(Policy = Permissoes.OrcamentosEditar)]

<PageTitle>Editar orçamento | Detara</PageTitle>
<div class="page-container page-container-wide">
    <CabecalhoPagina Titulo="Editar rascunho" Descricao="Enquanto rascunho, cliente, itens, valores e condições podem ser ajustados." Sobretitulo="ATENDIMENTO" />
    <OrcamentoFormulario OrcamentoId="Id" />
</div>

@code { [Parameter] public Guid Id { get; set; } }
