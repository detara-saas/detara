@page "/servicos"
@attribute [Authorize(Policy = Permissoes.ServicosVisualizar)]
@inject CatalogoServico Catalogo
@inject IMensagemServico Mensagens

<PageTitle>Serviços | Detara</PageTitle>

<CabecalhoPagina Titulo="Serviços" Descricao="Organize o catálogo, preços e tempos da sua operação." Sobretitulo="CATÁLOGO">
    <Acoes>
        <AuthorizeView Policy="@Permissoes.ServicosEditar"><Authorized><MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Category" OnClick="AlternarCategorias">Categorias</MudButton></Authorized></AuthorizeView>
        <AuthorizeView Policy="@Permissoes.ServicosCriar"><Authorized><MudButton Href="/servicos/novo" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add">Novo serviço</MudButton></Authorized></AuthorizeView>
    </Acoes>
</CabecalhoPagina>

@if (_categoriasAbertas)
{
    <CategoriasPainel />
}

<section class="module-toolbar" aria-label="Filtros de serviços">
    <MudTextField T="string" @bind-Value="_pesquisa" Placeholder="Nome ou descrição" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Class="module-search" />
    <MudSelect T="Guid?" @bind-Value="_categoriaId" Label="Categoria" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
        @foreach (var categoria in _categorias)
        {
            <MudSelectItem T="Guid?" Value="@categoria.Id">@categoria.Nome</MudSelectItem>
        }
    </MudSelect>
    <MudSelect T="string" @bind-Value="_status" Label="Status" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("todos")">Todos</MudSelectItem><MudSelectItem Value="@("ativos")">Ativos</MudSelectItem><MudSelectItem Value="@("inativos")">Inativos</MudSelectItem></MudSelect>
    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="PesquisarAsync" StartIcon="@Icons.Material.Outlined.FilterAlt">Aplicar</MudButton>
</section>

@if (_carregando)
{
    <div class="module-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else if (_pagina is null || _pagina.Itens.Count == 0)
{
    <EstadoVazio Titulo="Nenhum serviço encontrado" Descricao="Cadastre o primeiro serviço ou ajuste os filtros." Icone="@Icons.Material.Outlined.HomeRepairService"><Acao><AuthorizeView Policy="@Permissoes.ServicosCriar"><Authorized><MudButton Href="/servicos/novo" Variant="Variant.Filled" Color="Color.Primary">Cadastrar serviço</MudButton></Authorized></AuthorizeView></Acao></EstadoVazio>
}
else
{
    <section class="module-panel desktop-list" aria-label="Lista de serviços"><table class="module-table"><thead><tr><th>Serviço</th><th>Categoria</th><th>Preço base</th><th>Duração</th><th>Status</th><th class="actions-column">Ações</th></tr></thead><tbody>
    @foreach (var servico in _pagina.Itens)
    {
        <tr><td><a class="primary-link" href="@($"/servicos/{servico.Id}")">@servico.Nome</a></td><td>@servico.CategoriaNome</td><td>@FormatacaoCatalogo.Preco(servico.TipoPrecificacao, servico.PrecoBase)</td><td>@FormatarDuracao(servico.DuracaoEstimadaMinutos)</td><td><span class="status-badge @(servico.EhAtivo ? "status-running" : "status-neutral")">@(servico.EhAtivo ? "Ativo" : "Inativo")</span></td><td class="table-actions"><MudIconButton Href="@($"/servicos/{servico.Id}")" Icon="@Icons.Material.Outlined.Visibility" Size="Size.Small" aria-label="Abrir serviço" /><AuthorizeView Policy="@Permissoes.ServicosEditar"><Authorized><MudIconButton Href="@($"/servicos/{servico.Id}/editar")" Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" aria-label="Editar serviço" /></Authorized></AuthorizeView></td></tr>
    }
    </tbody></table></section>
    <section class="mobile-list" aria-label="Lista de serviços">
    @foreach (var servico in _pagina.Itens)
    {
        <a class="mobile-record" href="@($"/servicos/{servico.Id}")"><div class="mobile-record-main"><strong>@servico.Nome</strong><span>@servico.CategoriaNome</span><span>@FormatacaoCatalogo.Preco(servico.TipoPrecificacao, servico.PrecoBase) · @FormatarDuracao(servico.DuracaoEstimadaMinutos)</span></div><span class="status-badge @(servico.EhAtivo ? "status-running" : "status-neutral")">@(servico.EhAtivo ? "Ativo" : "Inativo")</span><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a>
    }
    </section>
    <div class="module-pagination"><span>@_pagina.TotalItens registro(s) · Página @_pagina.Pagina de @Math.Max(1, _pagina.TotalPaginas)</span><div><MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft" Disabled="@(_pagina.Pagina <= 1)" OnClick="PaginaAnteriorAsync" aria-label="Página anterior" /><MudIconButton Icon="@Icons.Material.Outlined.ChevronRight" Disabled="@(_pagina.Pagina >= _pagina.TotalPaginas)" OnClick="ProximaPaginaAsync" aria-label="Próxima página" /></div></div>
}

@code {
    private PaginaResponse<ServicoListaResponse>? _pagina;
    private IReadOnlyCollection<CategoriaServicoResponse> _categorias = [];
    private bool _carregando = true;
    private bool _categoriasAbertas;
    private string? _pesquisa;
    private Guid? _categoriaId;
    private string _status = "todos";
    private int _paginaAtual = 1;

    protected override async Task OnInitializedAsync()
    {
        var categorias = await Catalogo.ListarCategoriasAsync();
        _categorias = categorias.Resultado ?? [];
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        var resultado = await Catalogo.ListarServicosAsync(_paginaAtual, _pesquisa, _status == "todos" ? null : _status == "ativos", _categoriaId);
        _pagina = resultado.Resultado;
        if (!resultado.Sucesso) Mensagens.Mostrar(resultado.Mensagem, true);
        _carregando = false;
    }

    private void AlternarCategorias() => _categoriasAbertas = !_categoriasAbertas;
    private async Task PesquisarAsync() { _paginaAtual = 1; await CarregarAsync(); }
    private async Task PaginaAnteriorAsync() { _paginaAtual--; await CarregarAsync(); }
    private async Task ProximaPaginaAsync() { _paginaAtual++; await CarregarAsync(); }
    private static string FormatarDuracao(int? minutos) => minutos.HasValue ? $"{minutos.Value} min" : "Não informada";
}
