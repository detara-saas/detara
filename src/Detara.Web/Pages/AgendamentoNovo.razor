@page "/agenda/novo"
@attribute [Authorize(Policy = Permissoes.AgendaCriar)]
@inject NavigationManager Navegacao

<PageTitle>Novo agendamento | Detara</PageTitle>
<div class="page-container page-container-wide">
<CabecalhoPagina Titulo="@(_orcamentoId.HasValue ? "Agendar orçamento aprovado" : "Novo agendamento")" Descricao="Planeje cliente, veículo, itens e duração operacional." Sobretitulo="AGENDA" />
<AgendamentoFormulario OrcamentoId="_orcamentoId" ClienteInicialId="_clienteId" ClienteInicialNome="@_clienteNome" VeiculoInicialId="_veiculoId" DataInicial="_dataInicial" HoraInicial="_horaInicial" />
</div>

@code {
    private Guid? _orcamentoId;
    private Guid? _clienteId;
    private Guid? _veiculoId;
    private string? _clienteNome;
    private DateTime? _dataInicial;
    private TimeSpan? _horaInicial;

    protected override void OnInitialized()
    {
        var query = Navegacao.ToAbsoluteUri(Navegacao.Uri).Query.TrimStart('?');
        foreach (var parte in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var itens = parte.Split('=', 2);
            if (itens.Length != 2) continue;
            if (itens[0].Equals("orcamentoId", StringComparison.OrdinalIgnoreCase)
                && Guid.TryParse(Uri.UnescapeDataString(itens[1]), out var id)) _orcamentoId = id;
            if (itens[0].Equals("clienteId", StringComparison.OrdinalIgnoreCase)
                && Guid.TryParse(Uri.UnescapeDataString(itens[1]), out var clienteId)) _clienteId = clienteId;
            if (itens[0].Equals("clienteNome", StringComparison.OrdinalIgnoreCase)) _clienteNome = Uri.UnescapeDataString(itens[1]);
            if (itens[0].Equals("veiculoId", StringComparison.OrdinalIgnoreCase)
                && Guid.TryParse(Uri.UnescapeDataString(itens[1]), out var veiculoId)) _veiculoId = veiculoId;
            if (itens[0].Equals("data", StringComparison.OrdinalIgnoreCase)
                && EntradaDataHoraAgenda.TentarInterpretarData(Uri.UnescapeDataString(itens[1]), out var data)) _dataInicial = data;
            if (itens[0].Equals("hora", StringComparison.OrdinalIgnoreCase)
                && EntradaDataHoraAgenda.TentarInterpretarHora(Uri.UnescapeDataString(itens[1]), out var hora)) _horaInicial = hora;
        }
    }
}
