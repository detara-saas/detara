@page "/financeiro/contas-receber"
@attribute [Authorize(Policy = Permissoes.FinanceiroVisualizar)]
@inject FinanceiroServico FinanceiroApi
@inject IMensagemServico Mensagens

<PageTitle>Contas a Receber | Detara</PageTitle>
<div class="page-container page-container-fluid list-page receivables-list-page">
    <CabecalhoPagina Titulo="Contas a receber" Descricao="Saldos originados das ordens de serviço finalizadas." Sobretitulo="FINANCEIRO">
        <Acoes><MudButton Href="/financeiro" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.SpaceDashboard">Visão financeira</MudButton></Acoes>
    </CabecalhoPagina>
    <section class="module-toolbar receivables-filters">
        <MudTextField T="string" @bind-Value="_pesquisa" Placeholder="OS, cliente, placa ou veículo" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search" Class="module-search" />
        <MudSelect T="StatusContaReceberContrato?" @bind-Value="_status" Label="Status" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var status in Enum.GetValues<StatusContaReceberContrato>()) { <MudSelectItem T="StatusContaReceberContrato?" Value="status">@NomeStatus(status)</MudSelectItem> }
        </MudSelect>
        <MudSelect T="bool?" @bind-Value="_vencida" Label="Vencimento" Clearable="true" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem T="bool?" Value="true">Somente vencidas</MudSelectItem><MudSelectItem T="bool?" Value="false">Não vencidas</MudSelectItem></MudSelect>
        <MudDatePicker @bind-Date="_inicio" Label="Competência inicial" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
        <MudDatePicker @bind-Date="_fim" Label="Competência final" Variant="Variant.Outlined" Margin="Margin.Dense" DateFormat="dd/MM/yyyy" />
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="PesquisarAsync">Aplicar filtros</MudButton>
    </section>

    @if (_carregando) { <div class="module-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div> }
    else if (_pagina is null || _pagina.Itens.Count == 0)
    { <EstadoVazio Titulo="@(TemFiltrosAtivos ? "Nenhuma conta corresponde aos filtros" : "Nenhuma conta a receber gerada")" Descricao="@(TemFiltrosAtivos ? "Revise a pesquisa, status, vencimento ou período para ampliar os resultados." : "As contas surgem automaticamente quando a execução de uma OS com valor autorizado é finalizada.")" Icone="@Icons.Material.Outlined.ReceiptLong"><Acao>@if (!TemFiltrosAtivos) { <AuthorizeView Policy="@Permissoes.OrdemServicoVisualizar"><Authorized><MudButton Href="/ordens-servico" Variant="Variant.Outlined">Ver ordens de serviço</MudButton></Authorized></AuthorizeView> }</Acao></EstadoVazio> }
    else
    {
        <section class="module-panel desktop-list"><table class="module-table"><thead><tr><th>OS</th><th>Cliente</th><th>Veículo</th><th>Competência</th><th>Vencimento</th><th>Valor</th><th>Recebido</th><th>Em aberto</th><th>Status</th><th></th></tr></thead><tbody>
            @foreach (var item in _pagina.Itens) { <tr><td><a class="primary-link" href="@($"/financeiro/contas-receber/{item.Id}")">@item.OrdemServicoCodigo</a></td><td>@item.ClienteNome</td><td>@FormatacaoVeiculo.Exibir(item.VeiculoDescricao, item.VeiculoPlaca)</td><td>@item.DataCompetencia.ToString("dd/MM/yyyy")</td><td><span class="@(item.Vencida ? "overdue-text" : null)">@item.DataVencimento.ToString("dd/MM/yyyy")</span></td><td>@item.ValorOriginal.ToString("C2")</td><td>@item.ValorRecebido.ToString("C2")</td><td><strong>@item.ValorEmAberto.ToString("C2")</strong></td><td><span class="status-badge @ClasseStatus(item)">@(item.Vencida ? "Vencida" : NomeStatus(item.Status))</span></td><td><MudIconButton Href="@($"/financeiro/contas-receber/{item.Id}")" Icon="@Icons.Material.Outlined.ChevronRight" aria-label="Abrir conta" /></td></tr> }
        </tbody></table></section>
        <section class="mobile-list">@foreach (var item in _pagina.Itens) { <a class="mobile-record receivable-mobile-record" href="@($"/financeiro/contas-receber/{item.Id}")"><div class="mobile-record-main"><strong>@item.OrdemServicoCodigo</strong><span>@item.ClienteNome</span><span>@FormatacaoVeiculo.Exibir(item.VeiculoDescricao, item.VeiculoPlaca)</span><div class="mobile-financial-values"><span>Total <strong>@item.ValorOriginal.ToString("C2")</strong></span><span>Recebido <strong>@item.ValorRecebido.ToString("C2")</strong></span><span>Em aberto <strong>@item.ValorEmAberto.ToString("C2")</strong></span></div><span class="status-badge @ClasseStatus(item)">@(item.Vencida ? $"Vencida · {item.DataVencimento:dd/MM}" : NomeStatus(item.Status))</span></div><MudIcon Icon="@Icons.Material.Outlined.ChevronRight" /></a> }</section>
        <div class="module-pagination"><span>@_pagina.TotalItens registro(s) · Página @_pagina.Pagina de @Math.Max(1, _pagina.TotalPaginas)</span><div><MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft" Disabled="@(_pagina.Pagina <= 1)" OnClick="@(() => MoverAsync(-1))" /><MudIconButton Icon="@Icons.Material.Outlined.ChevronRight" Disabled="@(_pagina.Pagina >= _pagina.TotalPaginas)" OnClick="@(() => MoverAsync(1))" /></div></div>
    }
</div>

@code {
    private PaginaResponse<ContaReceberListaResponse>? _pagina; private bool _carregando = true; private int _paginaAtual = 1; private string? _pesquisa; private StatusContaReceberContrato? _status; private bool? _vencida; private DateTime? _inicio, _fim;
    private bool TemFiltrosAtivos => !string.IsNullOrWhiteSpace(_pesquisa) || _status.HasValue || _vencida.HasValue || _inicio.HasValue || _fim.HasValue;
    protected override Task OnInitializedAsync() => CarregarAsync();
    private async Task CarregarAsync() { _carregando = true; var r = await FinanceiroApi.ListarAsync(_paginaAtual, 25, _pesquisa, _status, _vencida, _inicio.HasValue ? DateOnly.FromDateTime(_inicio.Value) : null, _fim.HasValue ? DateOnly.FromDateTime(_fim.Value) : null); _pagina = r.Resultado; if (!r.Sucesso) Mensagens.Mostrar(r.Mensagem, true); _carregando = false; }
    private async Task PesquisarAsync() { _paginaAtual = 1; await CarregarAsync(); }
    private async Task MoverAsync(int delta) { _paginaAtual += delta; await CarregarAsync(); }
    internal static string NomeStatus(StatusContaReceberContrato status) => status switch { StatusContaReceberContrato.EmAberto => "Em aberto", StatusContaReceberContrato.ParcialmentePago => "Parcialmente paga", _ => "Paga" };
    internal static string ClasseStatus(ContaReceberListaResponse item) => item.Vencida ? "status-cancelled" : item.Status switch { StatusContaReceberContrato.Pago => "status-confirmed", StatusContaReceberContrato.ParcialmentePago => "status-waiting", _ => "status-scheduled" };
}
