@page "/ordens-servico/{Id:guid}"
@attribute [Authorize(Policy = Permissoes.OrdemServicoVisualizar)]
@inject OrdensServicoServico OrdensApi
@inject IMensagemServico Mensagens
@inject FinanceiroServico FinanceiroApi
@inject IAuthorizationService Authorization
@inject AuthenticationStateProvider AuthenticationState
@inject NotificacoesServico NotificacoesApi
@inject IDialogService Dialogs

<PageTitle>@(_ordem?.Codigo ?? "Ordem de Serviço") | Detara</PageTitle>
@if (_carregando) { <div class="module-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div> }
else if (_ordem is null) { <EstadoVazio Titulo="Ordem de serviço não encontrada" Descricao="O registro não existe ou pertence a outra empresa." Icone="@Icons.Material.Outlined.FactCheck" /> }
else
{
    <div class="page-container page-container-wide service-order-detail-page">
        <div class="service-order-detail-header">
            <CabecalhoPagina Titulo="@_ordem.Codigo" Descricao="@($"{_ordem.ClienteNome} · {FormatacaoVeiculo.Exibir(_ordem.VeiculoDescricao, _ordem.VeiculoPlaca)}")" Sobretitulo="ORDEM DE SERVIÇO">
                <Acoes><span class="status-badge @ClasseStatus(_ordem.Status)">@NomeStatus(_ordem.Status)</span>@if (_ordem.AgendamentoOrigemId.HasValue) { <AuthorizeView Policy="@Permissoes.AgendaVisualizar"><Authorized><MudButton Href="@($"/agenda/{_ordem.AgendamentoOrigemId}")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.EventAvailable">Ver agendamento</MudButton></Authorized></AuthorizeView> }@if (_contaReceberId.HasValue) { <AuthorizeView Policy="@Permissoes.FinanceiroVisualizar"><Authorized><MudButton Href="@($"/financeiro/contas-receber/{_contaReceberId}")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.AccountBalanceWallet">Ver conta a receber</MudButton></Authorized></AuthorizeView> }</Acoes>
            </CabecalhoPagina>
        </div>

        <section class="detail-metrics" aria-label="Resumo da ordem de serviço">
            <CardMetrica Icone="@Icons.Material.Outlined.Paid" Rotulo="TOTAL AUTORIZADO" Valor="@_ordem.TotalAutorizado.ToString("C2")" Descricao="Valor comercial preservado" Destaque="true" ValorSemQuebra="true" />
            <CardMetrica Icone="@Icons.Material.Outlined.AccountTree" Rotulo="ORIGEM" Valor="@NomeOrigem(_ordem)" Descricao="@DescricaoOrigem(_ordem)" />
            <CardMetrica Icone="@Icons.Material.Outlined.FactCheck" Rotulo="CHECK-IN" Valor="@(_ordem.CheckInEmUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Pendente")" Descricao="@IndicadorCheckIn" />
        </section>

        <div class="detail-stack">

    @if (_ordem.Status is StatusOrdemServicoContrato.Concluida or StatusOrdemServicoContrato.Cancelada)
    { <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="page-alert">Esta OS é histórica. Checklist e evidências permanecem consultáveis e não podem mais ser alterados.</MudAlert> }

    <section class="module-panel section-card"><div class="section-heading section-card-heading"><div><span class="section-eyebrow">SERVIÇOS AUTORIZADOS</span><h2>@_ordem.Itens.Count item(ns)</h2><p>Escopo efetivamente autorizado para execução neste veículo.</p></div><strong class="section-total currency-value">@_ordem.TotalAutorizado.ToString("C2")</strong></div>
        <div class="appointment-items">@foreach (var item in _ordem.Itens.OrderBy(item => item.Ordem)) { <article><span class="package-order">@item.Ordem</span><div><strong>@item.Nome</strong><span>@item.Quantidade × @item.ValorUnitarioAutorizado.ToString("C2") · @OrigemItem(item)</span>@if (!string.IsNullOrWhiteSpace(item.ObservacaoAutorizacao)) { <p>@item.ObservacaoAutorizacao</p> }</div><strong>@item.Subtotal.ToString("C2")</strong></article> }</div>
        @if (_ordem.DescontoAutorizado > 0 || _ordem.AcrescimoAutorizado > 0) { <div class="service-order-adjustments"><span>Desconto: @_ordem.DescontoAutorizado.ToString("C2")</span><span>Acréscimo: @_ordem.AcrescimoAutorizado.ToString("C2")</span></div> }
    </section>

    @if (!_ordem.CheckInEmUtc.HasValue)
    {
        <AuthorizeView Policy="@Permissoes.OrdemServicoEditar"><Authorized><section class="module-panel section-card"><div class="section-heading section-card-heading"><div><span class="section-eyebrow">CHECK-IN</span><h2>Registrar entrada do veículo</h2><p>Documente as condições de recebimento antes da execução.</p></div><span class="step-badge">01</span></div><div class="form-grid"><MudNumericField T="int?" @bind-Value="_quilometragem" Label="Quilometragem de entrada (opcional)" Min="0" Variant="Variant.Outlined" /><MudTextField T="string" @bind-Value="_observacaoEntrada" Label="Observação de entrada" Lines="3" Variant="Variant.Outlined" Class="form-full" /></div><div class="form-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Login" OnClick="RealizarCheckInAsync">Realizar check-in</MudButton></div></section></Authorized></AuthorizeView>
    }
    else
    {
        <section class="module-panel section-card"><div class="section-heading section-card-heading"><div><span class="section-eyebrow">CHECK-IN</span><h2>Condições de entrada</h2><p>Snapshot operacional registrado no recebimento.</p></div><span class="status-badge @(_ordem.ChecklistEntradaSnapshot == NivelExigenciaOperacionalContrato.Obrigatorio ? "status-waiting" : "status-neutral")">@NomeExigencia(_ordem.ChecklistEntradaSnapshot)</span></div><div class="service-order-checkin-meta"><span><MudIcon Icon="@Icons.Material.Outlined.Speed" /> Quilometragem: @(_ordem.QuilometragemEntrada?.ToString("N0") ?? "Não informada")</span><span><MudIcon Icon="@Icons.Material.Outlined.Notes" /> @(_ordem.ObservacaoEntrada ?? "Sem observação de entrada")</span></div>
            @if (_ordem.Checklist is not null) { <div class="service-order-checklist">@foreach (var resposta in _respostas) { <article><div><strong>@resposta.Ordem. @resposta.Descricao</strong><MudSelect T="RespostaChecklistOrdemServicoContrato?" @bind-Value="resposta.Resposta" Label="Resposta" Variant="Variant.Outlined" Disabled="@EhTerminal"><MudSelectItem T="RespostaChecklistOrdemServicoContrato?" Value="RespostaChecklistOrdemServicoContrato.Conforme">Conforme</MudSelectItem><MudSelectItem T="RespostaChecklistOrdemServicoContrato?" Value="RespostaChecklistOrdemServicoContrato.NaoConforme">Não conforme</MudSelectItem><MudSelectItem T="RespostaChecklistOrdemServicoContrato?" Value="RespostaChecklistOrdemServicoContrato.NaoAplicavel">Não aplicável</MudSelectItem></MudSelect><MudTextField T="string" @bind-Value="resposta.Observacao" Label="Observação" Variant="Variant.Outlined" Disabled="@EhTerminal" /></div></article> }</div><AuthorizeView Policy="@Permissoes.OrdemServicoEditar"><Authorized>@if (!EhTerminal) { <div class="form-actions"><MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="SalvarChecklistAsync">Salvar checklist</MudButton></div> }</Authorized></AuthorizeView> }
        </section>
    }

    @if (_ordem.CheckInEmUtc.HasValue)
    {
        <section class="module-panel section-card"><div class="section-heading section-card-heading"><div><span class="section-eyebrow">EVIDÊNCIAS</span><h2>Fotos do atendimento</h2><p>Registros privados de entrada, execução e saída.</p></div><span class="selected-count">@_ordem.Fotos.Count foto(s)</span></div>
            <div class="service-order-photo-groups">@foreach (var categoria in Enum.GetValues<CategoriaFotoOrdemServicoContrato>()) { var fotos = _ordem.Fotos.Where(f => f.Categoria == categoria).ToArray(); <section><div class="service-order-photo-heading"><strong>@NomeCategoria(categoria)</strong><span>@fotos.Length foto(s)</span>@if (PodeEnviar(categoria)) { <AuthorizeView Policy="@Permissoes.OrdemServicoEditar"><Authorized><InputFile id="@($"os-photo-{categoria}")" class="visually-hidden-file" accept="image/jpeg,image/png,image/webp" OnChange="@(args => EnviarFotoAsync(categoria, args))" /><label class="vehicle-photo-upload" for="@($"os-photo-{categoria}")"><MudIcon Icon="@Icons.Material.Outlined.AddAPhoto" /><span>Adicionar</span></label></Authorized></AuthorizeView> }</div><div class="vehicle-photo-gallery">@foreach (var foto in fotos) { <article class="vehicle-photo-card"><div class="vehicle-photo-frame">@if (_urlsFotos.TryGetValue(foto.Id, out var url)) { <img src="@url" alt="@($"Foto de {NomeCategoria(categoria)} da OS {_ordem.Codigo}")" loading="lazy" /> } else { <MudIcon Icon="@Icons.Material.Outlined.Image" /> }</div><div class="vehicle-photo-meta"><strong>@foto.NomeOriginal</strong><span>@FormatarTamanho(foto.TamanhoBytes)</span></div>@if (PodeExcluir(foto)) { <AuthorizeView Policy="@Permissoes.OrdemServicoEditar"><Authorized><MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" OnClick="@(() => ExcluirFotoAsync(foto.Id))" /></Authorized></AuthorizeView> }</article> }</div></section> }</div>
        </section>
    }

    @if (_ordem.Status == StatusOrdemServicoContrato.EmExecucao)
    {
        <section class="module-panel section-card"><div class="section-heading section-card-heading"><div><span class="section-eyebrow">ADICIONAIS</span><h2>Escopo identificado durante a execução</h2><p>Itens cobrados só entram na OS após aprovação do orçamento complementar.</p></div><AuthorizeView Policy="@Permissoes.OrcamentosCriar"><Authorized><MudButton Href="@($"/orcamentos/novo?ordemServicoId={Id}")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AddShoppingCart">Identificar adicional</MudButton></Authorized></AuthorizeView></div>
            @if (_ordem.OrcamentosAdicionais.Count == 0) { <div class="compact-empty-state"><span><MudIcon Icon="@Icons.Material.Outlined.PostAdd" /></span><div><strong>Nenhum adicional identificado</strong><p>O escopo autorizado permanece sem alterações.</p></div></div> } else { <div class="appointment-items">@foreach (var adicional in _ordem.OrcamentosAdicionais) { <article><MudIcon Icon="@Icons.Material.Outlined.RequestQuote" /><div><a class="primary-link" href="@($"/orcamentos/{adicional.Id}")">@(adicional.Codigo ?? "Rascunho adicional")</a><span>@string.Join(", ", adicional.Itens) · @adicional.Total.ToString("C2")</span></div><span class="status-badge @ClasseAdicional(adicional.Status)">@NomeStatusOrcamento(adicional.Status)</span></article> }</div> }
        </section>
    }

    @if (_ordem.Status is StatusOrdemServicoContrato.AguardandoRetirada or StatusOrdemServicoContrato.Concluida)
    {
        var ultimaComunicacao = _notificacao?.Comunicacoes.OrderByDescending(x => x.CriadoEmUtc).FirstOrDefault();
        var comunicacaoPendente = _notificacao?.Comunicacoes.Any(x => x.Status == StatusComunicacaoClienteContrato.Pendente) == true;
        <section class="module-panel section-card service-order-communication">
            <div class="section-heading section-card-heading"><div><span class="section-eyebrow">COMUNICAÇÃO COM O CLIENTE</span><h2>Veículo pronto para retirada</h2><p>Acompanhe o canal, o status e quando o cliente foi comunicado.</p></div><span class="status-badge @ClasseComunicacao(ultimaComunicacao?.Status)">@NomeComunicacao(ultimaComunicacao?.Status)</span></div>
            <div class="communication-summary">
                <span><MudIcon Icon="@Icons.Material.Outlined.Autorenew" /><span><small>CANAL AUTOMÁTICO</small><strong>@NomeCanalAutomatico(_notificacao?.CanalAutomaticoVeiculoPronto)</strong></span></span>
                <span><MudIcon Icon="@(ultimaComunicacao?.Canal == CanalComunicacaoClienteContrato.WhatsApp ? Icons.Material.Outlined.Chat : Icons.Material.Outlined.AlternateEmail)" /><span><small>ÚLTIMO CANAL</small><strong>@NomeCanal(ultimaComunicacao?.Canal)</strong></span></span>
                <span><MudIcon Icon="@Icons.Material.Outlined.Schedule" /><span><small>ÚLTIMA COMUNICAÇÃO</small><strong>@DataComunicacao(ultimaComunicacao)</strong></span></span>
                <span><MudIcon Icon="@Icons.Material.Outlined.PhoneAndroid" /><span><small>WHATSAPP DA EMPRESA</small><strong>@NomeStatusWhatsApp(_sessaoWhatsApp?.Status)</strong></span></span>
            </div>
            @if (ultimaComunicacao is null)
            { <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Cliente ainda não comunicado. Você pode escolher um canal manualmente.</MudAlert> }
            @if (string.IsNullOrWhiteSpace(_notificacao?.EmailDestinoAtual) && string.IsNullOrWhiteSpace(_notificacao?.WhatsAppDestinoAtual))
            { <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">Cliente sem e-mail ou WhatsApp válido cadastrado. Atualize o cadastro para enviar o aviso.</MudAlert> }
            @if (!string.IsNullOrWhiteSpace(ultimaComunicacao?.UltimoErroSeguro))
            { <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">@ultimaComunicacao.UltimoErroSeguro</MudAlert> }
            @if (_ordem.Status == StatusOrdemServicoContrato.AguardandoRetirada)
            {
                <AuthorizeView Policy="@Permissoes.NotificacoesReenviar"><Authorized>
                    <div class="form-actions communication-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Send"
                                   Disabled="@(_executandoNotificacao || comunicacaoPendente || string.IsNullOrWhiteSpace(_notificacao?.EmailDestinoAtual) && string.IsNullOrWhiteSpace(_notificacao?.WhatsAppDestinoAtual))"
                                   OnClick="ComunicarClienteAsync">@(_executandoNotificacao ? "Agendando..." : comunicacaoPendente ? "Envio em andamento" : "Comunicar cliente")</MudButton>
                    </div>
                </Authorized></AuthorizeView>
            }
            @if (_notificacao?.Comunicacoes.Count > 0)
            {
                <div class="communication-history" aria-label="Histórico de comunicação com o cliente">
                    <div class="communication-history-heading"><strong>Histórico</strong><span>@_notificacao.Comunicacoes.Count registro(s)</span></div>
                    @foreach (var comunicacao in _notificacao.Comunicacoes.OrderByDescending(x => x.CriadoEmUtc))
                    {
                        <article>
                            <span class="communication-history-icon"><MudIcon Icon="@(comunicacao.Canal == CanalComunicacaoClienteContrato.WhatsApp ? Icons.Material.Outlined.Chat : Icons.Material.Outlined.AlternateEmail)" /></span>
                            <div class="communication-history-copy"><strong>@NomeCanal(comunicacao.Canal)</strong><span>@((comunicacao.DataEnvioUtc ?? comunicacao.CriadoEmUtc).ToLocalTime().ToString("dd/MM/yyyy HH:mm")) · @(comunicacao.Origem == OrigemComunicacaoClienteContrato.Automatica ? "Automático" : "Manual")</span><small>@(comunicacao.Destinatario ?? "Sem destinatário")</small><details><summary>Ver detalhes</summary><div class="communication-history-detail"><span><b>Usuário</b>@(comunicacao.SolicitadoPorUsuarioNome ?? (comunicacao.Origem == OrigemComunicacaoClienteContrato.Automatica ? "Automático Detara" : "Não identificado"))</span><span><b>Data</b>@comunicacao.CriadoEmUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span><span><b>Resultado</b>@NomeComunicacao(comunicacao.Status)</span><span><b>Template</b>@(comunicacao.TemplateNome ?? "Template legado")</span><p>@comunicacao.Mensagem</p></div></details></div>
                            <span class="status-badge @ClasseComunicacao(comunicacao.Status)">@NomeComunicacao(comunicacao.Status)</span>
                        </article>
                    }
                </div>
            }
        </section>
    }

    <section class="module-panel section-card quotation-history"><div class="section-heading section-card-heading"><div><span class="section-eyebrow">HISTÓRICO</span><h2>Trilha operacional</h2><p>Status, data e responsável por cada transição.</p></div></div>@foreach (var h in _ordem.Historico.OrderByDescending(item => item.DataUtc)) { <article><span class="history-dot @ClasseStatus(h.Status)"></span><div><strong>@NomeStatus(h.Status)</strong><span>@h.DataUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @h.UsuarioNome</span>@if (!string.IsNullOrWhiteSpace(h.Observacao)) { <p>@h.Observacao</p> }</div></article> }</section>

    <AuthorizeView Policy="@Permissoes.OrdemServicoFinalizar"><Authorized>@if (!EhTerminal) { <section class="appointment-actions module-panel service-order-action-panel"><div><span class="section-eyebrow">EXECUÇÃO</span><h2>Próxima etapa operacional</h2></div><div class="appointment-action-buttons">@if (_ordem.Status == StatusOrdemServicoContrato.Aberta) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ExecutarTransicaoAsync("iniciar"))">Iniciar execução</MudButton> } @if (_ordem.Status == StatusOrdemServicoContrato.EmExecucao) { <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => ExecutarTransicaoAsync("finalizar"))">Serviços finalizados</MudButton> } @if (_ordem.Status == StatusOrdemServicoContrato.AguardandoRetirada) { <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => ExecutarTransicaoAsync("concluir"))">Concluir atendimento · veículo entregue</MudButton> } @if (_ordem.Status is StatusOrdemServicoContrato.Aberta or StatusOrdemServicoContrato.EmExecucao) { <MudTextField T="string" @bind-Value="_motivoCancelamento" Placeholder="Motivo para cancelar" Variant="Variant.Outlined" /><MudButton Variant="Variant.Text" Color="Color.Error" OnClick="CancelarAsync">Cancelar OS</MudButton> }</div></section> }</Authorized></AuthorizeView>
        </div>
    </div>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private OrdemServicoDetalheResponse? _ordem; private Guid? _contaReceberId; private NotificacaoOrdemServicoResponse? _notificacao; private SessaoWhatsAppResponse? _sessaoWhatsApp; private bool _executandoNotificacao; private Guid? _solicitacaoComunicacaoId; private bool _carregando = true; private int? _quilometragem; private string? _observacaoEntrada, _motivoCancelamento; private readonly List<RespostaEdicao> _respostas = []; private readonly Dictionary<Guid, string> _urlsFotos = [];
    private bool EhTerminal => _ordem?.Status is StatusOrdemServicoContrato.Concluida or StatusOrdemServicoContrato.Cancelada;
    private string IndicadorCheckIn => _ordem?.CheckInEmUtc.HasValue == true ? $"Checklist {_ordem.Checklist?.Itens.Count(i => i.Resposta.HasValue) ?? 0}/{_ordem.Checklist?.Itens.Count ?? 0} · Fotos entrada {_ordem.Fotos.Count(f => f.Categoria == CategoriaFotoOrdemServicoContrato.Entrada)}" : "Necessário antes da execução";
    protected override Task OnParametersSetAsync() => CarregarAsync();
    private async Task CarregarAsync() { _carregando = true; var r = await OrdensApi.ObterAsync(Id); _ordem = r.Resultado; if (!r.Sucesso) Mensagens.Mostrar(r.Mensagem, true); _respostas.Clear(); if (_ordem?.Checklist is not null) _respostas.AddRange(_ordem.Checklist.Itens.OrderBy(i => i.Ordem).Select(i => new RespostaEdicao(i))); _contaReceberId = null; _notificacao = null; _sessaoWhatsApp = null; if (_ordem is not null) { var estado = await AuthenticationState.GetAuthenticationStateAsync(); if ((await Authorization.AuthorizeAsync(estado.User, Permissoes.FinanceiroVisualizar)).Succeeded) { var financeiro = await FinanceiroApi.ObterPorOrdemServicoAsync(Id); if (financeiro.Resultado?.Existe == true) _contaReceberId = financeiro.Resultado.Id; } if (_ordem.Status is StatusOrdemServicoContrato.AguardandoRetirada or StatusOrdemServicoContrato.Concluida) { var comunicacaoTask = NotificacoesApi.ObterPorOrdemServicoAsync(Id); var whatsappTask = NotificacoesApi.ObterDisponibilidadeWhatsAppAsync(); await Task.WhenAll(comunicacaoTask, whatsappTask); var comunicacao = await comunicacaoTask; var whatsapp = await whatsappTask; if (comunicacao.Sucesso) _notificacao = comunicacao.Resultado; if (whatsapp.Sucesso) _sessaoWhatsApp = whatsapp.Resultado; } } await CarregarFotosAsync(); _carregando = false; }
    private async Task CarregarFotosAsync() { _urlsFotos.Clear(); if (_ordem is null) return; foreach (var foto in _ordem.Fotos) { var r = await OrdensApi.ObterFotoAsync(Id, foto.Id); if (r.Resultado is not null) _urlsFotos[foto.Id] = $"data:{r.Resultado.ContentType};base64,{Convert.ToBase64String(r.Resultado.Bytes)}"; } }
    private async Task RealizarCheckInAsync() { var r = await OrdensApi.CheckInAsync(Id, new(_quilometragem, _observacaoEntrada)); Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Sucesso) await CarregarAsync(); }
    private async Task SalvarChecklistAsync() { var r = await OrdensApi.AtualizarChecklistAsync(Id, new(_respostas.Where(i => i.Resposta.HasValue).Select(i => new RespostaChecklistOrdemServicoRequest(i.Id, i.Resposta!.Value, i.Observacao)).ToArray())); Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Sucesso) await CarregarAsync(); }
    private async Task EnviarFotoAsync(CategoriaFotoOrdemServicoContrato categoria, InputFileChangeEventArgs args) { var r = await OrdensApi.EnviarFotoAsync(Id, categoria, args.File); Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Sucesso) await CarregarAsync(); }
    private async Task ExcluirFotoAsync(Guid fotoId) { var r = await OrdensApi.ExcluirFotoAsync(Id, fotoId); Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Sucesso) await CarregarAsync(); }
    private async Task ExecutarTransicaoAsync(string acao) { var r = acao switch { "iniciar" => await OrdensApi.IniciarAsync(Id, null), "finalizar" => await OrdensApi.FinalizarAsync(Id, null), _ => await OrdensApi.ConcluirAsync(Id, null) }; Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Sucesso) await CarregarAsync(); }
    private async Task CancelarAsync() { if (string.IsNullOrWhiteSpace(_motivoCancelamento)) { Mensagens.Mostrar("Informe o motivo do cancelamento.", true); return; } var r = await OrdensApi.CancelarAsync(Id, _motivoCancelamento); Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Sucesso) await CarregarAsync(); }
    private async Task ComunicarClienteAsync() { var parametros = new DialogParameters<ComunicarClienteDialog> { { x => x.Email, _notificacao?.EmailDestinoAtual }, { x => x.WhatsApp, _notificacao?.WhatsAppDestinoAtual }, { x => x.WhatsAppConectado, _sessaoWhatsApp?.Status == StatusSessaoWhatsAppContrato.Conectada } }; var dialogo = await Dialogs.ShowAsync<ComunicarClienteDialog>("Comunicar cliente", parametros, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true }); var resultado = await dialogo.Result; if (resultado is null || resultado.Canceled || resultado.Data is not CanalComunicacaoClienteContrato canal) return; _solicitacaoComunicacaoId ??= Guid.NewGuid(); _executandoNotificacao = true; var r = await NotificacoesApi.ComunicarClienteAsync(Id, new(canal, _solicitacaoComunicacaoId.Value)); Mensagens.Mostrar(r.Mensagem, !r.Sucesso); _executandoNotificacao = false; if (r.Sucesso) { _solicitacaoComunicacaoId = null; await CarregarComunicacaoAsync(); } }
    private async Task CarregarComunicacaoAsync() { var r = await NotificacoesApi.ObterPorOrdemServicoAsync(Id); if (r.Sucesso) _notificacao = r.Resultado; else Mensagens.Mostrar(r.Mensagem, true); }
    private bool PodeEnviar(CategoriaFotoOrdemServicoContrato c) => !EhTerminal && (c == CategoriaFotoOrdemServicoContrato.Entrada ? _ordem?.Status == StatusOrdemServicoContrato.Aberta && _ordem.FotosEntradaSnapshot != NivelExigenciaOperacionalContrato.Desabilitado : _ordem?.Status == StatusOrdemServicoContrato.EmExecucao && (c == CategoriaFotoOrdemServicoContrato.Durante || _ordem.FotosSaidaSnapshot != NivelExigenciaOperacionalContrato.Desabilitado));
    private bool PodeExcluir(OrdemServicoFotoResponse f) => PodeEnviar(f.Categoria);
    private static string NomeOrigem(OrdemServicoDetalheResponse o) => o.Origem switch { OrigemOrdemServicoContrato.Orcamento => "Orçamento aprovado", OrigemOrdemServicoContrato.Agendamento => "Agendamento", _ => "Atendimento direto" };
    private static string DescricaoOrigem(OrdemServicoDetalheResponse o) => o.OrcamentoOrigemId.HasValue ? "Snapshot comercial preservado" : o.AgendamentoOrigemId.HasValue ? "Valores confirmados na OS" : "Acordo direto auditado";
    private static string OrigemItem(OrdemServicoItemResponse i) => i.OrigemComercial switch { OrigemComercialOrdemServicoContrato.Orcamento => "Autorizado por orçamento", OrigemComercialOrdemServicoContrato.Cortesia => "Cortesia", _ => "Acordo direto" };
    private static string NomeStatus(StatusOrdemServicoContrato s) => s switch { StatusOrdemServicoContrato.EmExecucao => "Em execução", StatusOrdemServicoContrato.AguardandoRetirada => "Aguardando retirada", StatusOrdemServicoContrato.Concluida => "Concluída", _ => s.ToString() };
    private static string ClasseStatus(StatusOrdemServicoContrato s) => s switch { StatusOrdemServicoContrato.Aberta => "status-scheduled", StatusOrdemServicoContrato.EmExecucao => "status-running", StatusOrdemServicoContrato.AguardandoRetirada => "status-waiting", StatusOrdemServicoContrato.Concluida => "status-confirmed", _ => "status-cancelled" };
    private static string NomeExigencia(NivelExigenciaOperacionalContrato? n) => n switch { NivelExigenciaOperacionalContrato.Obrigatorio => "Obrigatório", NivelExigenciaOperacionalContrato.Opcional => "Opcional", _ => "Desabilitado" };
    private static string NomeCategoria(CategoriaFotoOrdemServicoContrato c) => c switch { CategoriaFotoOrdemServicoContrato.Entrada => "Entrada", CategoriaFotoOrdemServicoContrato.Durante => "Durante a execução", _ => "Saída" };
    private static string FormatarTamanho(long b) => b >= 1024 * 1024 ? $"{b / 1024d / 1024d:N1} MiB" : $"{b / 1024d:N0} KiB";
    private static string ClasseAdicional(StatusOrcamentoContrato s) => s == StatusOrcamentoContrato.Aprovado ? "status-running" : s is StatusOrcamentoContrato.Recusado or StatusOrcamentoContrato.Cancelado ? "status-cancelled" : "status-waiting";
    private static string NomeStatusOrcamento(StatusOrcamentoContrato s) => s == StatusOrcamentoContrato.Expirado ? "Expirado" : s.ToString();
    private static string NomeCanalAutomatico(CanalComunicacaoVeiculoProntoContrato? canal) => canal switch { CanalComunicacaoVeiculoProntoContrato.Email => "Email", CanalComunicacaoVeiculoProntoContrato.WhatsApp => "WhatsApp", _ => "Nenhum" };
    private static string NomeCanal(CanalComunicacaoClienteContrato? canal) => canal switch { CanalComunicacaoClienteContrato.Email => "Email", CanalComunicacaoClienteContrato.WhatsApp => "WhatsApp", _ => "Nenhum envio" };
    private static string NomeComunicacao(StatusComunicacaoClienteContrato? s) => s switch { null => "Ainda não comunicado", StatusComunicacaoClienteContrato.Pendente => "Pendente", StatusComunicacaoClienteContrato.Enviado => "Enviado", _ => "Falhou" };
    private static string ClasseComunicacao(StatusComunicacaoClienteContrato? s) => s switch { StatusComunicacaoClienteContrato.Enviado => "status-confirmed", StatusComunicacaoClienteContrato.Falhou => "status-cancelled", StatusComunicacaoClienteContrato.Pendente => "status-waiting", _ => "status-neutral" };
    private static string DataComunicacao(ComunicacaoClienteResponse? comunicacao) => comunicacao is null ? "Nenhum envio" : (comunicacao.DataEnvioUtc ?? comunicacao.CriadoEmUtc).ToLocalTime().ToString("dd/MM/yyyy HH:mm");
    private static string NomeStatusWhatsApp(StatusSessaoWhatsAppContrato? status) => status switch { StatusSessaoWhatsAppContrato.Conectada => "Conectado", StatusSessaoWhatsAppContrato.AguardandoQrCode => "Aguardando QR Code", StatusSessaoWhatsAppContrato.Erro => "Erro de conexão", _ => "Não conectado" };
    private sealed class RespostaEdicao(OrdemServicoChecklistItemResponse i) { public Guid Id { get; } = i.Id; public string Descricao { get; } = i.Descricao; public int Ordem { get; } = i.Ordem; public RespostaChecklistOrdemServicoContrato? Resposta { get; set; } = i.Resposta; public string? Observacao { get; set; } = i.Observacao; }
}
