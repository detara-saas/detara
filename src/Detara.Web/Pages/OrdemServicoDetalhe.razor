@page "/ordens-servico/{Id:guid}"
@attribute [Authorize(Policy = Permissoes.OrdemServicoVisualizar)]
@inject OrdensServicoServico OrdensApi
@inject IMensagemServico Mensagens

<PageTitle>@(_ordem?.Codigo ?? "Ordem de Serviço") | Detara</PageTitle>
@if (_carregando) { <div class="module-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div> }
else if (_ordem is null) { <EstadoVazio Titulo="Ordem de serviço não encontrada" Descricao="O registro não existe ou pertence a outra empresa." Icone="@Icons.Material.Outlined.FactCheck" /> }
else
{
    <CabecalhoPagina Titulo="@_ordem.Codigo" Descricao="@($"{_ordem.ClienteNome} · {_ordem.VeiculoDescricao} · {_ordem.VeiculoPlaca}")" Sobretitulo="ORDEM DE SERVIÇO">
        <Acoes><span class="status-badge @ClasseStatus(_ordem.Status)">@NomeStatus(_ordem.Status)</span></Acoes>
    </CabecalhoPagina>

    <section class="service-order-hero module-panel">
        <div><span class="section-eyebrow">TOTAL AUTORIZADO</span><strong>@_ordem.TotalAutorizado.ToString("C2")</strong><span>Não reconstruído pelo catálogo</span></div>
        <div><span class="section-eyebrow">ORIGEM</span><strong>@NomeOrigem(_ordem)</strong><span>@DescricaoOrigem(_ordem)</span></div>
        <div><span class="section-eyebrow">CHECK-IN</span><strong>@(_ordem.CheckInEmUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Pendente")</strong><span>@IndicadorCheckIn</span></div>
    </section>

    @if (_ordem.Status is StatusOrdemServicoContrato.Concluida or StatusOrdemServicoContrato.Cancelada)
    { <MudAlert Severity="Severity.Info" Variant="Variant.Outlined">Esta OS é histórica. Checklist e evidências permanecem consultáveis e não podem mais ser alterados.</MudAlert> }

    <section class="module-panel related-section"><div class="section-heading"><div><span class="section-eyebrow">SERVIÇOS AUTORIZADOS</span><h2>@_ordem.Itens.Count item(ns)</h2></div><strong>@_ordem.TotalAutorizado.ToString("C2")</strong></div>
        <div class="appointment-items">@foreach (var item in _ordem.Itens.OrderBy(item => item.Ordem)) { <article><span class="package-order">@item.Ordem</span><div><strong>@item.Nome</strong><span>@item.Quantidade × @item.ValorUnitarioAutorizado.ToString("C2") · @OrigemItem(item)</span>@if (!string.IsNullOrWhiteSpace(item.ObservacaoAutorizacao)) { <p>@item.ObservacaoAutorizacao</p> }</div><strong>@item.Subtotal.ToString("C2")</strong></article> }</div>
        @if (_ordem.DescontoAutorizado > 0 || _ordem.AcrescimoAutorizado > 0) { <div class="service-order-adjustments"><span>Desconto: @_ordem.DescontoAutorizado.ToString("C2")</span><span>Acréscimo: @_ordem.AcrescimoAutorizado.ToString("C2")</span></div> }
    </section>

    @if (!_ordem.CheckInEmUtc.HasValue)
    {
        <AuthorizeView Policy="@Permissoes.OrdemServicoEditar"><Authorized><section class="module-panel related-section"><div class="section-heading"><div><span class="section-eyebrow">CHECK-IN</span><h2>Registrar entrada do veículo</h2></div></div><div class="form-grid"><MudNumericField T="int?" @bind-Value="_quilometragem" Label="Quilometragem de entrada (opcional)" Min="0" Variant="Variant.Outlined" /><MudTextField T="string" @bind-Value="_observacaoEntrada" Label="Observação de entrada" Lines="3" Variant="Variant.Outlined" Class="form-full" /></div><div class="form-actions"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="RealizarCheckInAsync">Realizar check-in</MudButton></div></section></Authorized></AuthorizeView>
    }
    else
    {
        <section class="module-panel related-section"><div class="section-heading"><div><span class="section-eyebrow">CHECK-IN</span><h2>Condições de entrada</h2></div><span class="status-badge @(_ordem.ChecklistEntradaSnapshot == NivelExigenciaOperacionalContrato.Obrigatorio ? "status-waiting" : "status-neutral")">@NomeExigencia(_ordem.ChecklistEntradaSnapshot)</span></div><div class="service-order-checkin-meta"><span>Quilometragem: @(_ordem.QuilometragemEntrada?.ToString("N0") ?? "Não informada")</span><span>@(_ordem.ObservacaoEntrada ?? "Sem observação de entrada")</span></div>
            @if (_ordem.Checklist is not null) { <div class="service-order-checklist">@foreach (var resposta in _respostas) { <article><div><strong>@resposta.Ordem. @resposta.Descricao</strong><MudSelect T="RespostaChecklistOrdemServicoContrato?" @bind-Value="resposta.Resposta" Label="Resposta" Variant="Variant.Outlined" Disabled="@EhTerminal"><MudSelectItem T="RespostaChecklistOrdemServicoContrato?" Value="RespostaChecklistOrdemServicoContrato.Conforme">Conforme</MudSelectItem><MudSelectItem T="RespostaChecklistOrdemServicoContrato?" Value="RespostaChecklistOrdemServicoContrato.NaoConforme">Não conforme</MudSelectItem><MudSelectItem T="RespostaChecklistOrdemServicoContrato?" Value="RespostaChecklistOrdemServicoContrato.NaoAplicavel">Não aplicável</MudSelectItem></MudSelect><MudTextField T="string" @bind-Value="resposta.Observacao" Label="Observação" Variant="Variant.Outlined" Disabled="@EhTerminal" /></div></article> }</div><AuthorizeView Policy="@Permissoes.OrdemServicoEditar"><Authorized>@if (!EhTerminal) { <div class="form-actions"><MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="SalvarChecklistAsync">Salvar checklist</MudButton></div> }</Authorized></AuthorizeView> }
        </section>
    }

    @if (_ordem.CheckInEmUtc.HasValue)
    {
        <section class="module-panel related-section"><div class="section-heading"><div><span class="section-eyebrow">EVIDÊNCIAS</span><h2>Fotos do atendimento</h2></div><span class="selected-count">@_ordem.Fotos.Count foto(s)</span></div>
            <div class="service-order-photo-groups">@foreach (var categoria in Enum.GetValues<CategoriaFotoOrdemServicoContrato>()) { var fotos = _ordem.Fotos.Where(f => f.Categoria == categoria).ToArray(); <section><div class="service-order-photo-heading"><strong>@NomeCategoria(categoria)</strong><span>@fotos.Length foto(s)</span>@if (PodeEnviar(categoria)) { <AuthorizeView Policy="@Permissoes.OrdemServicoEditar"><Authorized><InputFile id="@($"os-photo-{categoria}")" class="visually-hidden-file" accept="image/jpeg,image/png,image/webp" OnChange="@(args => EnviarFotoAsync(categoria, args))" /><label class="vehicle-photo-upload" for="@($"os-photo-{categoria}")"><MudIcon Icon="@Icons.Material.Outlined.AddAPhoto" /><span>Adicionar</span></label></Authorized></AuthorizeView> }</div><div class="vehicle-photo-gallery">@foreach (var foto in fotos) { <article class="vehicle-photo-card"><div class="vehicle-photo-frame">@if (_urlsFotos.TryGetValue(foto.Id, out var url)) { <img src="@url" alt="@($"Foto de {NomeCategoria(categoria)} da OS {_ordem.Codigo}")" loading="lazy" /> } else { <MudIcon Icon="@Icons.Material.Outlined.Image" /> }</div><div class="vehicle-photo-meta"><strong>@foto.NomeOriginal</strong><span>@FormatarTamanho(foto.TamanhoBytes)</span></div>@if (PodeExcluir(foto)) { <AuthorizeView Policy="@Permissoes.OrdemServicoEditar"><Authorized><MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" OnClick="@(() => ExcluirFotoAsync(foto.Id))" /></Authorized></AuthorizeView> }</article> }</div></section> }</div>
        </section>
    }

    @if (_ordem.Status == StatusOrdemServicoContrato.EmExecucao)
    {
        <section class="module-panel related-section"><div class="section-heading"><div><span class="section-eyebrow">ADICIONAIS</span><h2>Escopo identificado durante a execução</h2></div><AuthorizeView Policy="@Permissoes.OrcamentosCriar"><Authorized><MudButton Href="@($"/orcamentos/novo?ordemServicoId={Id}")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.AddShoppingCart">Identificar adicional</MudButton></Authorized></AuthorizeView></div>
            @if (_ordem.OrcamentosAdicionais.Count == 0) { <p>Nenhum orçamento adicional vinculado.</p> } else { <div class="appointment-items">@foreach (var adicional in _ordem.OrcamentosAdicionais) { <article><MudIcon Icon="@Icons.Material.Outlined.RequestQuote" /><div><a class="primary-link" href="@($"/orcamentos/{adicional.Id}")">@(adicional.Codigo ?? "Rascunho adicional")</a><span>@string.Join(", ", adicional.Itens) · @adicional.Total.ToString("C2")</span></div><span class="status-badge @ClasseAdicional(adicional.Status)">@NomeStatusOrcamento(adicional.Status)</span></article> }</div> }
        </section>
    }

    <section class="module-panel related-section quotation-history"><div class="section-heading"><div><span class="section-eyebrow">HISTÓRICO</span><h2>Trilha operacional</h2></div></div>@foreach (var h in _ordem.Historico.OrderByDescending(item => item.DataUtc)) { <article><span class="history-dot @ClasseStatus(h.Status)"></span><div><strong>@NomeStatus(h.Status)</strong><span>@h.DataUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @h.UsuarioNome</span>@if (!string.IsNullOrWhiteSpace(h.Observacao)) { <p>@h.Observacao</p> }</div></article> }</section>

    <AuthorizeView Policy="@Permissoes.OrdemServicoFinalizar"><Authorized>@if (!EhTerminal) { <section class="appointment-actions module-panel"><div><span class="section-eyebrow">EXECUÇÃO</span><h2>Próxima etapa operacional</h2></div><div class="appointment-action-buttons">@if (_ordem.Status == StatusOrdemServicoContrato.Aberta) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => ExecutarTransicaoAsync("iniciar"))">Iniciar execução</MudButton> } @if (_ordem.Status == StatusOrdemServicoContrato.EmExecucao) { <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => ExecutarTransicaoAsync("finalizar"))">Serviços finalizados</MudButton> } @if (_ordem.Status == StatusOrdemServicoContrato.AguardandoRetirada) { <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => ExecutarTransicaoAsync("concluir"))">Concluir atendimento · veículo entregue</MudButton> } @if (_ordem.Status is StatusOrdemServicoContrato.Aberta or StatusOrdemServicoContrato.EmExecucao) { <MudTextField T="string" @bind-Value="_motivoCancelamento" Placeholder="Motivo para cancelar" Variant="Variant.Outlined" /><MudButton Variant="Variant.Text" Color="Color.Error" OnClick="CancelarAsync">Cancelar OS</MudButton> }</div></section> }</Authorized></AuthorizeView>
}

@code {
    [Parameter] public Guid Id { get; set; }
    private OrdemServicoDetalheResponse? _ordem; private bool _carregando = true; private int? _quilometragem; private string? _observacaoEntrada, _motivoCancelamento; private readonly List<RespostaEdicao> _respostas = []; private readonly Dictionary<Guid, string> _urlsFotos = [];
    private bool EhTerminal => _ordem?.Status is StatusOrdemServicoContrato.Concluida or StatusOrdemServicoContrato.Cancelada;
    private string IndicadorCheckIn => _ordem?.CheckInEmUtc.HasValue == true ? $"Checklist {_ordem.Checklist?.Itens.Count(i => i.Resposta.HasValue) ?? 0}/{_ordem.Checklist?.Itens.Count ?? 0} · Fotos entrada {_ordem.Fotos.Count(f => f.Categoria == CategoriaFotoOrdemServicoContrato.Entrada)}" : "Necessário antes da execução";
    protected override Task OnParametersSetAsync() => CarregarAsync();
    private async Task CarregarAsync() { _carregando = true; var r = await OrdensApi.ObterAsync(Id); _ordem = r.Resultado; if (!r.Sucesso) Mensagens.Mostrar(r.Mensagem, true); _respostas.Clear(); if (_ordem?.Checklist is not null) _respostas.AddRange(_ordem.Checklist.Itens.OrderBy(i => i.Ordem).Select(i => new RespostaEdicao(i))); await CarregarFotosAsync(); _carregando = false; }
    private async Task CarregarFotosAsync() { _urlsFotos.Clear(); if (_ordem is null) return; foreach (var foto in _ordem.Fotos) { var r = await OrdensApi.ObterFotoAsync(Id, foto.Id); if (r.Resultado is not null) _urlsFotos[foto.Id] = $"data:{r.Resultado.ContentType};base64,{Convert.ToBase64String(r.Resultado.Bytes)}"; } }
    private async Task RealizarCheckInAsync() { var r = await OrdensApi.CheckInAsync(Id, new(_quilometragem, _observacaoEntrada)); Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Sucesso) await CarregarAsync(); }
    private async Task SalvarChecklistAsync() { var r = await OrdensApi.AtualizarChecklistAsync(Id, new(_respostas.Where(i => i.Resposta.HasValue).Select(i => new RespostaChecklistOrdemServicoRequest(i.Id, i.Resposta!.Value, i.Observacao)).ToArray())); Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Sucesso) await CarregarAsync(); }
    private async Task EnviarFotoAsync(CategoriaFotoOrdemServicoContrato categoria, InputFileChangeEventArgs args) { var r = await OrdensApi.EnviarFotoAsync(Id, categoria, args.File); Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Sucesso) await CarregarAsync(); }
    private async Task ExcluirFotoAsync(Guid fotoId) { var r = await OrdensApi.ExcluirFotoAsync(Id, fotoId); Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Sucesso) await CarregarAsync(); }
    private async Task ExecutarTransicaoAsync(string acao) { var r = acao switch { "iniciar" => await OrdensApi.IniciarAsync(Id, null), "finalizar" => await OrdensApi.FinalizarAsync(Id, null), _ => await OrdensApi.ConcluirAsync(Id, null) }; Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Sucesso) await CarregarAsync(); }
    private async Task CancelarAsync() { if (string.IsNullOrWhiteSpace(_motivoCancelamento)) { Mensagens.Mostrar("Informe o motivo do cancelamento.", true); return; } var r = await OrdensApi.CancelarAsync(Id, _motivoCancelamento); Mensagens.Mostrar(r.Mensagem, !r.Sucesso); if (r.Sucesso) await CarregarAsync(); }
    private bool PodeEnviar(CategoriaFotoOrdemServicoContrato c) => !EhTerminal && (c == CategoriaFotoOrdemServicoContrato.Entrada ? _ordem?.Status == StatusOrdemServicoContrato.Aberta && _ordem.FotosEntradaSnapshot != NivelExigenciaOperacionalContrato.Desabilitado : _ordem?.Status == StatusOrdemServicoContrato.EmExecucao && (c == CategoriaFotoOrdemServicoContrato.Durante || _ordem.FotosSaidaSnapshot != NivelExigenciaOperacionalContrato.Desabilitado));
    private bool PodeExcluir(OrdemServicoFotoResponse f) => PodeEnviar(f.Categoria);
    private static string NomeOrigem(OrdemServicoDetalheResponse o) => o.Origem switch { OrigemOrdemServicoContrato.Orcamento => "Orçamento aprovado", OrigemOrdemServicoContrato.Agendamento => "Agendamento", _ => "Atendimento direto" };
    private static string DescricaoOrigem(OrdemServicoDetalheResponse o) => o.OrcamentoOrigemId.HasValue ? "Snapshot comercial preservado" : o.AgendamentoOrigemId.HasValue ? "Valores confirmados na OS" : "Acordo direto auditado";
    private static string OrigemItem(OrdemServicoItemResponse i) => i.OrigemComercial switch { OrigemComercialOrdemServicoContrato.Orcamento => "Autorizado por orçamento", OrigemComercialOrdemServicoContrato.Cortesia => "Cortesia", _ => "Acordo direto" };
    private static string NomeStatus(StatusOrdemServicoContrato s) => s switch { StatusOrdemServicoContrato.EmExecucao => "Em execução", StatusOrdemServicoContrato.AguardandoRetirada => "Aguardando retirada", StatusOrdemServicoContrato.Concluida => "Concluída", _ => s.ToString() };
    private static string ClasseStatus(StatusOrdemServicoContrato s) => s switch { StatusOrdemServicoContrato.Aberta => "status-scheduled", StatusOrdemServicoContrato.EmExecucao => "status-running", StatusOrdemServicoContrato.AguardandoRetirada => "status-waiting", StatusOrdemServicoContrato.Concluida => "status-confirmed", _ => "status-cancelled" };
    private static string NomeExigencia(NivelExigenciaOperacionalContrato? n) => n switch { NivelExigenciaOperacionalContrato.Obrigatorio => "Obrigatório", NivelExigenciaOperacionalContrato.Opcional => "Opcional", _ => "Desabilitado" };
    private static string NomeCategoria(CategoriaFotoOrdemServicoContrato c) => c switch { CategoriaFotoOrdemServicoContrato.Entrada => "Entrada", CategoriaFotoOrdemServicoContrato.Durante => "Durante a execução", _ => "Saída" };
    private static string FormatarTamanho(long b) => b >= 1024 * 1024 ? $"{b / 1024d / 1024d:N1} MiB" : $"{b / 1024d:N0} KiB";
    private static string ClasseAdicional(StatusOrcamentoContrato s) => s == StatusOrcamentoContrato.Aprovado ? "status-running" : s is StatusOrcamentoContrato.Recusado or StatusOrcamentoContrato.Cancelado ? "status-cancelled" : "status-waiting";
    private static string NomeStatusOrcamento(StatusOrcamentoContrato s) => s == StatusOrcamentoContrato.Expirado ? "Expirado" : s.ToString();
    private sealed class RespostaEdicao(OrdemServicoChecklistItemResponse i) { public Guid Id { get; } = i.Id; public string Descricao { get; } = i.Descricao; public int Ordem { get; } = i.Ordem; public RespostaChecklistOrdemServicoContrato? Resposta { get; set; } = i.Resposta; public string? Observacao { get; set; } = i.Observacao; }
}
