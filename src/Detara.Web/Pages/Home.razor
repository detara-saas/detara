@page "/"
@page "/dashboard"
@attribute [Authorize]
@inject OnboardingServico OnboardingApi
@inject DashboardServico DashboardApi
@inject PreferenciasInterfaceServico Preferencias
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard | Detara</PageTitle>

<div class="page-container page-container-fluid executive-dashboard-page">
    <header class="executive-dashboard-header">
        <div class="executive-heading-copy">
            <span class="section-eyebrow">@DataAtual</span>
            <h1>@Saudacao</h1>
            <p>@DescricaoDashboard</p>
        </div>
        <div class="executive-header-actions">
            <div class="period-selector" role="group" aria-label="Período do Dashboard">
                @foreach (var opcao in Periodos)
                {
                    <MudButton Variant="@(_periodo == opcao.Valor ? Variant.Filled : Variant.Text)" Color="Color.Primary" Disabled="_carregandoDashboard" OnClick="() => AlterarPeriodoAsync(opcao.Valor)">@opcao.Rotulo</MudButton>
                }
            </div>
            @if (_onboarding?.Concluido is true && _dashboard?.Operacional?.AgendaHoje is not null)
            {
                <AuthorizeView Policy="@Permissoes.AgendaCriar"><Authorized><MudButton Href="/agenda/novo" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add">Novo agendamento</MudButton></Authorized></AuthorizeView>
            }
        </div>
    </header>

    <DashboardModoSelector Modo="_modoDashboard" Alterando="_salvandoModo" ModoAlterado="AlternarModoAsync" />

    @if (_carregandoInicial)
    {
        <section class="dashboard-loading" aria-label="Carregando Dashboard executivo"><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="112px" /><DetaraSkeleton Variant="DetaraSkeletonVariant.Cards" Quantidade="4" Rotulo="Carregando indicadores" /><MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="360px" /></section>
    }
    else
    {
        @if (_onboarding is null)
        {
            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="page-alert onboarding-error">Não foi possível carregar a configuração inicial. Os dados executivos continuam disponíveis abaixo.</MudAlert>
        }
        else if (!_onboarding.Concluido)
        {
            <OnboardingEmpresaCard Estado="_onboarding" Compacto="@(_onboardingRecolhido || _onboarding.Concluido && !_onboardingAbertoManualmente)" OnRecolher="RecolherOnboardingAsync" OnReabrir="ReabrirOnboardingAsync" />
        }

        @if (_dashboard is null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="page-alert dashboard-error"><div class="onboarding-error-content"><span>@_erroDashboard</span><MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="CarregarDashboardAsync">Tentar novamente</MudButton></div></MudAlert>
        }
        else if (_onboarding?.Concluido is false)
        {
            <section class="dashboard-start-state" aria-labelledby="dashboard-start-title"><span class="dashboard-start-icon"><MudIcon Icon="@Icons.Material.Outlined.SpaceDashboard" /></span><div><span class="section-eyebrow">VISÃO EXECUTIVA</span><h2 id="dashboard-start-title">Sua operação aparecerá aqui</h2><p>Indicadores, desempenho e pendências ganham contexto conforme sua empresa registra atendimentos reais.</p></div></section>
        }
        else if (!PossuiAlgumPainel)
        {
            <EstadoVazio Titulo="Nenhum painel disponível" Descricao="Seu perfil não possui acesso aos módulos que alimentam o Dashboard." Icone="@Icons.Material.Outlined.Lock" />
        }
        else
        {
            <div class="dashboard-refresh-layer @(_carregandoDashboard ? "refreshing" : null)">
                @if (_modoDashboard == ModoDashboard.Operacao)
                {
                    <DashboardOperacao Dados="_dashboard" />
                }
                else
                {
                    <DashboardEmpresa Dados="_dashboard" RotuloPeriodo="@RotuloPeriodoCurto" />
                }
            </div>
        }
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo Cultura = System.Globalization.CultureInfo.GetCultureInfo("pt-BR");
    private static readonly IReadOnlyCollection<(PeriodoDashboardContrato Valor, string Rotulo)> Periodos =
    [ (PeriodoDashboardContrato.Hoje, "Hoje"), (PeriodoDashboardContrato.Ultimos7Dias, "7 dias"), (PeriodoDashboardContrato.EsteMes, "Este mês"), (PeriodoDashboardContrato.EsteAno, "Este ano") ];
    private OnboardingEmpresaResponse? _onboarding;
    private DashboardExecutivoResponse? _dashboard;
    private PeriodoDashboardContrato _periodo = PeriodoDashboardContrato.EsteMes;
    private bool _carregandoInicial = true, _carregandoDashboard, _onboardingRecolhido, _onboardingAbertoManualmente, _salvandoModo;
    private ModoDashboard _modoDashboard = ModoDashboard.Operacao;
    private Guid _usuarioId;
    private string _nomeUsuario = "Administrador";
    private string _erroDashboard = "Não foi possível carregar os dados executivos.";

    private string DataAtual => _dashboard is null ? "VISÃO EXECUTIVA" : _dashboard.DataReferencia.ToDateTime(TimeOnly.MinValue).ToString("dddd, d 'de' MMMM", Cultura).ToUpper(Cultura);
    private string Saudacao { get { if (_onboarding?.Concluido is not true) return $"Bem-vindo ao Detara, {_nomeUsuario}"; var momento = _dashboard?.AtualizadoEmLocal.Hour switch { < 12 => "Bom dia", < 18 => "Boa tarde", _ => "Boa noite" }; return $"{momento}, {_nomeUsuario}"; } }
    private string DescricaoDashboard => _onboarding?.Concluido is not true
        ? "Sua conta está pronta. Vamos organizar os primeiros passos."
        : _modoDashboard == ModoDashboard.Operacao
            ? "Priorize a agenda, os atendimentos em curso e as pendências que pedem ação hoje."
            : "Acompanhe resultados, evolução financeira e indicadores consolidados da empresa.";
    private bool PossuiAlgumPainel => _dashboard is not null && (_dashboard.Operacional is not null || _dashboard.Comercial is not null || _dashboard.Financeiro is not null);
    private string RotuloPeriodoCurto => _periodo switch { PeriodoDashboardContrato.Hoje => "HOJE", PeriodoDashboardContrato.Ultimos7Dias => "7 DIAS", PeriodoDashboardContrato.EsteAno => "ESTE ANO", _ => "ESTE MÊS" };

    protected override async Task OnInitializedAsync()
    {
        var autenticacao = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var usuario = autenticacao.User;
        _nomeUsuario = usuario.Identity?.Name?.Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Administrador";
        Guid.TryParse(usuario.FindFirst("sub")?.Value, out _usuarioId);
        _modoDashboard = Preferencias.ModoDashboardAtual;
        _onboardingRecolhido = await Preferencias.ObterOnboardingRecolhidoAsync(_usuarioId);
        var onboardingTask = OnboardingApi.ObterAsync(); var dashboardTask = DashboardApi.ObterAsync(_periodo);
        await Task.WhenAll(onboardingTask, dashboardTask);
        var onboarding = await onboardingTask; var dashboard = await dashboardTask;
        _onboarding = onboarding.Sucesso ? onboarding.Resultado : null;
        AplicarDashboard(dashboard);
        _carregandoInicial = false;
    }
    private async Task AlterarPeriodoAsync(PeriodoDashboardContrato periodo) { if (_periodo == periodo) return; _periodo = periodo; await CarregarDashboardAsync(); }
    private async Task AlternarModoAsync(ModoDashboard modo)
    {
        if (_modoDashboard == modo || _salvandoModo) return;
        _modoDashboard = modo;
        _salvandoModo = true;
        try { await Preferencias.DefinirModoDashboardAsync(modo); }
        finally { _salvandoModo = false; }
    }
    private async Task CarregarDashboardAsync() { _carregandoDashboard = true; AplicarDashboard(await DashboardApi.ObterAsync(_periodo)); _carregandoDashboard = false; }
    private void AplicarDashboard(ResultadoServico<DashboardExecutivoResponse> resultado) { _dashboard = resultado.Sucesso ? resultado.Resultado : null; _erroDashboard = resultado.Mensagem ?? "Não foi possível carregar os dados executivos."; }
    private async Task RecolherOnboardingAsync() { _onboardingRecolhido = true; _onboardingAbertoManualmente = false; await Preferencias.DefinirOnboardingRecolhidoAsync(_usuarioId, true); }
    private async Task ReabrirOnboardingAsync() { _onboardingRecolhido = false; _onboardingAbertoManualmente = true; await Preferencias.DefinirOnboardingRecolhidoAsync(_usuarioId, false); }
}
