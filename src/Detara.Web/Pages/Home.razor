@page "/"
@page "/dashboard"
@attribute [Authorize]

<PageTitle>Dashboard | Detara</PageTitle>

<header class="page-heading dashboard-heading">
    <div>
        <MudText Typo="Typo.caption" Class="page-eyebrow">QUINTA-FEIRA, 13 DE AGOSTO</MudText>
        <MudText Typo="Typo.h1">Bom dia, Administrador</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary">Aqui está o ritmo da sua operação hoje.</MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add">
        Novo atendimento
    </MudButton>
</header>

<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mock-notice">
    Visão demonstrativa: os indicadores serão conectados aos módulos operacionais nas próximas etapas.
</MudAlert>

<section class="metric-grid" aria-label="Indicadores de hoje">
    @foreach (var indicador in _indicadores)
    {
        <MudPaper Elevation="0" Class="metric-card">
            <div class="metric-card-head">
                <div class="metric-icon @indicador.Classe"><MudIcon Icon="@indicador.Icone" /></div>
                <MudText Typo="Typo.caption" Class="metric-trend">@indicador.Tendencia</MudText>
            </div>
            <MudText Typo="Typo.body2" Class="metric-label">@indicador.Titulo</MudText>
            <MudText Typo="Typo.h2" Class="metric-value">@indicador.Valor</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">@indicador.Apoio</MudText>
        </MudPaper>
    }
</section>

<section class="dashboard-grid">
    <MudPaper Elevation="0" Class="operation-panel">
        <div class="panel-header">
            <div>
                <MudText Typo="Typo.h3">Agenda de hoje</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Próximos atendimentos e andamento</MudText>
            </div>
            <MudButton Variant="Variant.Text" EndIcon="@Icons.Material.Outlined.ArrowForward">Ver agenda</MudButton>
        </div>
        <div class="agenda-desktop">
            <MudTable T="Atividade" Items="@_atividades" Hover="true" Elevation="0" Dense="true">
                <HeaderContent>
                    <MudTh>Horário</MudTh>
                    <MudTh>Cliente e veículo</MudTh>
                    <MudTh>Serviço</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Horário"><strong>@context.Horario</strong></MudTd>
                    <MudTd DataLabel="Cliente e veículo">
                        <div class="vehicle-cell"><strong>@context.Cliente</strong><span>@context.Veiculo</span></div>
                    </MudTd>
                    <MudTd DataLabel="Serviço">@context.Servico</MudTd>
                    <MudTd DataLabel="Status"><span class="status-badge @context.ClasseStatus">@context.Status</span></MudTd>
                    <MudTd><MudIconButton Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" aria-label="Abrir atendimento" /></MudTd>
                </RowTemplate>
            </MudTable>
        </div>
        <div class="agenda-mobile">
            @foreach (var atividade in _atividades)
            {
                <article class="agenda-mobile-item">
                    <div class="agenda-mobile-time">@atividade.Horario</div>
                    <div class="agenda-mobile-main">
                        <strong>@atividade.Cliente</strong>
                        <span>@atividade.Veiculo · @atividade.Servico</span>
                        <span class="status-badge @atividade.ClasseStatus">@atividade.Status</span>
                    </div>
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" />
                </article>
            }
        </div>
    </MudPaper>

    <MudPaper Elevation="0" Class="attention-panel">
        <div class="panel-header compact">
            <div>
                <MudText Typo="Typo.h3">Precisa de atenção</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Pendências da operação</MudText>
            </div>
        </div>
        @foreach (var alerta in _alertas)
        {
            <div class="attention-item">
                <div class="attention-icon @alerta.Classe"><MudIcon Icon="@alerta.Icone" /></div>
                <div>
                    <MudText Typo="Typo.body2"><strong>@alerta.Titulo</strong></MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@alerta.Descricao</MudText>
                </div>
                <span class="attention-count">@alerta.Quantidade</span>
            </div>
        }
        <div class="operation-summary">
            <MudText Typo="Typo.caption" Color="Color.Secondary">CAPACIDADE DO DIA</MudText>
            <div class="summary-row"><span>6 de 8 horários ocupados</span><strong>75%</strong></div>
            <div class="summary-track"><span></span></div>
        </div>
    </MudPaper>
</section>

@code {
    private sealed record Indicador(string Titulo, string Valor, string Apoio, string Tendencia, string Icone, string Classe);
    private sealed record Atividade(string Horario, string Cliente, string Veiculo, string Servico, string Status, string ClasseStatus);
    private sealed record Alerta(string Titulo, string Descricao, string Quantidade, string Icone, string Classe);

    private readonly Indicador[] _indicadores =
    [
        new("Agendamentos de hoje", "8", "Próximo às 10:30", "3 concluídos", Icons.Material.Outlined.CalendarToday, "teal"),
        new("Em atendimento", "3", "2 dentro do prazo", "Agora", Icons.Material.Outlined.Handyman, "blue"),
        new("Aguardando retirada", "2", "Prontos para o cliente", "Ação", Icons.Material.Outlined.DirectionsCar, "amber"),
        new("Previsto hoje", "R$ 6.480", "Ticket médio R$ 810", "+8,2%", Icons.Material.Outlined.Payments, "green")
    ];

    private readonly Atividade[] _atividades =
    [
        new("09:00", "Marina Alves", "Jeep Compass · ABC1D23", "Vitrificação", "Confirmado", "status-confirmed"),
        new("10:30", "Rafael Costa", "BMW 320i · DEF4G56", "Higienização", "Em execução", "status-running"),
        new("14:00", "Lucas Martins", "Porsche Macan · HIJ7K89", "PPF frontal", "Agendado", "status-scheduled"),
        new("16:30", "Camila Souza", "Volvo XC60 · KLM0N12", "Polimento", "Aguardando", "status-waiting")
    ];

    private readonly Alerta[] _alertas =
    [
        new("Aprovações pendentes", "Orçamentos aguardando cliente", "4", Icons.Material.Outlined.PendingActions, "amber"),
        new("Veículos próximos do prazo", "Conclusão prevista em até 1 hora", "2", Icons.Material.Outlined.Schedule, "blue"),
        new("Retiradas aguardando", "Clientes já foram avisados", "2", Icons.Material.Outlined.Key, "green")
    ];
}
