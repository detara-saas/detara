@page "/clientes/novo"
@page "/clientes/{Id:guid}/editar"
@attribute [Authorize]

<PageTitle>@(Id.HasValue ? "Editar cliente" : "Novo cliente") | Detara</PageTitle>

<div class="page-container page-container-focused">
<AuthorizeView Policy="@Politica">
    <Authorized>
        <CabecalhoPagina Titulo="@(Id.HasValue ? "Editar cliente" : "Novo cliente")"
                         Descricao="Dados essenciais para uma operação rápida e organizada."
                         Sobretitulo="CADASTROS" />
        <section class="module-panel form-panel"><ClienteFormulario ClienteId="Id" /></section>
    </Authorized>
    <NotAuthorized>
        <EstadoVazio Titulo="Acesso não autorizado" Descricao="Seu perfil não possui permissão para esta operação." Icone="@Icons.Material.Outlined.Lock" />
    </NotAuthorized>
</AuthorizeView>
</div>

@code {
    [Parameter]
    public Guid? Id { get; set; }
    private string Politica => Id.HasValue ? Permissoes.ClientesEditar : Permissoes.ClientesCriar;
}
