@page "/agenda/{Id:guid}"
@attribute [Authorize(Policy = Permissoes.AgendaVisualizar)]
@inject AgendaServico AgendaApi
@inject OrcamentosServico OrcamentosApi
@inject OrdensServicoServico OrdensApi
@inject IMensagemServico Mensagens
@inject IDialogService Dialogs
@inject AuthenticationStateProvider AuthenticationState
@inject IAuthorizationService Authorization

<PageTitle>@(_agendamento is null ? "Agendamento" : $"{_agendamento.ClienteNome} | Agenda") | Detara</PageTitle>
<div class="page-container page-container-wide">
@if (_carregando) { <DetaraSkeleton Variant="DetaraSkeletonVariant.Detail" Rotulo="Carregando agendamento" /> }
else if (_agendamento is null) { <EstadoVazio Titulo="Agendamento não encontrado" Descricao="O registro não existe ou não pertence à empresa atual." Icone="@Icons.Material.Outlined.EventBusy" /> }
else
{
    <CabecalhoPagina Titulo="@_agendamento.ClienteNome" Descricao="@FormatacaoVeiculo.Exibir(_agendamento.VeiculoDescricao, _agendamento.VeiculoPlaca)" Sobretitulo="AGENDAMENTO">
        <Acoes><DetaraStatusBadge Texto="@NomeStatus(_agendamento.Status)" Tone="@TomStatus(_agendamento.Status)" />@if (_ordem is not null) { <MudButton Href="@($"/ordens-servico/{_ordem.Id}")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.FactCheck">Ver OS @_ordem.Codigo</MudButton> } else if (_podeVisualizarOrdem && PermiteCriarOrdem(_agendamento.Status)) { <AuthorizeView Policy="@Permissoes.OrdemServicoCriar"><Authorized><MudButton Href="@($"/ordens-servico/nova?agendamentoId={Id}")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.FactCheck">Criar ordem de serviço</MudButton></Authorized></AuthorizeView> }@if (_ordem is null && PermiteCriarOrdem(_agendamento.Status)) { <AuthorizeView Policy="@Permissoes.OrcamentosCriar"><Authorized><MudButton Href="@($"/orcamentos/novo?agendamentoId={Id}")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.RequestQuote">Criar orçamento</MudButton></Authorized></AuthorizeView> }<AuthorizeView Policy="@Permissoes.AgendaEditar"><Authorized>@if (EhEditavel(_agendamento.Status) && _ordem is null) { <MudButton Href="@($"/agenda/{Id}/editar")" Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Edit">Editar</MudButton><MudButton Href="@($"/agenda/{Id}/reagendar")" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.EventRepeat">Reagendar</MudButton> }</Authorized></AuthorizeView></Acoes>
    </CabecalhoPagina>

    <section class="appointment-hero module-panel">
        <div><span class="section-eyebrow">INÍCIO LOCAL</span><strong>@_agendamento.InicioLocal.ToString("dd/MM/yyyy 'às' HH:mm")</strong><span>@_agendamento.FusoHorario</span></div>
        <div><span class="section-eyebrow">DURAÇÃO PLANEJADA</span><strong>@FormatarDuracao(_agendamento.DuracaoPlanejadaMinutos)</strong><span>Independente da referência do catálogo</span></div>
        <div><span class="section-eyebrow">REFERÊNCIA DO CATÁLOGO</span><strong>@_agendamento.Referencia.Texto</strong><span>@(_agendamento.Referencia.PossuiSobConsulta ? "Itens sujeitos à avaliação" : "Não é preço acordado")</span></div>
    </section>

    @if (_ordem is not null || _orcamentos.Count > 0)
    {
        <section class="module-panel related-section operational-links">
            <div class="section-heading"><div><span class="section-eyebrow">FLUXO OPERACIONAL</span><h2>Registros vinculados</h2></div></div>
            <div class="detail-grid">
                @if (_ordem is not null) { <a class="detail-card primary-link" href="@($"/ordens-servico/{_ordem.Id}")"><span>Ordem de serviço</span><strong>@_ordem.Codigo</strong><small>@NomeStatusOrdem(_ordem.Status)</small></a> }
                @foreach (var orcamento in _orcamentos.Take(2)) { <a class="detail-card primary-link" href="@($"/orcamentos/{orcamento.Id}")"><span>Orçamento</span><strong>@(orcamento.Codigo ?? "Rascunho")</strong><small>@NomeStatusOrcamento(orcamento.Status)</small></a> }
            </div>
        </section>
    }

    @if (_agendamento.QuantidadeSobreposicoes > 0)
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="agenda-overlap-warning agenda-detail-overlap-warning">
            <div class="agenda-overlap-copy">
                <strong>@TextoConflitoHorario(_agendamento.QuantidadeSobreposicoes)</strong>
                <span>Sobreposições são permitidas e não bloqueiam a capacidade da agenda.</span>
            </div>
        </MudAlert>
    }

    <section class="module-panel related-section"><div class="section-heading"><div><span class="section-eyebrow">ITENS PLANEJADOS</span><h2>@_agendamento.Itens.Count serviço(s)/pacote(s)</h2></div></div><div class="appointment-items">
        @foreach (var item in _agendamento.Itens.OrderBy(x => x.Ordem))
        {
            <article><span class="package-order">@item.Ordem</span><div><strong>@item.Nome</strong><span>@(item.TipoItem == TipoItemAgendamentoContrato.Servico ? "Serviço" : "Pacote") · @FormatacaoCatalogo.Preco(item.TipoPrecificacao, item.PrecoReferencia) · @FormatarDuracao(item.DuracaoReferenciaMinutos)</span>@if (!string.IsNullOrWhiteSpace(item.Descricao)) { <p>@item.Descricao</p> }</div>@if (!item.ItemAtivoNoCatalogo) { <span class="status-badge status-neutral">Inativo no catálogo</span> }</article>
        }
    </div></section>

    <div class="detail-grid"><section class="module-panel detail-card detail-observation"><div class="section-heading"><div><span class="section-eyebrow">SOLICITANTE</span><h2>Observação recebida</h2></div></div><p>@(string.IsNullOrWhiteSpace(_agendamento.ObservacaoSolicitante) ? "Nenhuma observação registrada." : _agendamento.ObservacaoSolicitante)</p></section><section class="module-panel detail-card detail-observation"><div class="section-heading"><div><span class="section-eyebrow">OPERAÇÃO INTERNA</span><h2>Observação interna</h2></div></div><p>@(string.IsNullOrWhiteSpace(_agendamento.ObservacaoInterna) ? "Nenhuma observação interna." : _agendamento.ObservacaoInterna)</p></section></div>
    @if (_agendamento.Status == StatusAgendamentoContrato.Cancelado && !string.IsNullOrWhiteSpace(_agendamento.MotivoCancelamento)) { <MudAlert Severity="Severity.Error" Variant="Variant.Outlined"><strong>Motivo do cancelamento:</strong> @_agendamento.MotivoCancelamento</MudAlert> }
    <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="commercial-reference-note">Os valores exibidos são referências do catálogo. O valor final pode depender da avaliação do veículo. A Agenda não registra preço acordado.</MudAlert>

    <AuthorizeView Policy="@Permissoes.AgendaEditar"><Authorized>
        @if (!EhFinal(_agendamento.Status))
        {
            <section class="appointment-actions module-panel"><div><span class="section-eyebrow">PRÓXIMA AÇÃO</span><h2>Atualizar etapa operacional</h2></div><div class="appointment-action-buttons">
                @if (_agendamento.Status == StatusAgendamentoContrato.Agendado) { <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => SolicitarStatusAsync(StatusAgendamentoContrato.Confirmado))">Confirmar</MudButton> }
                @if (_agendamento.Status is StatusAgendamentoContrato.Agendado or StatusAgendamentoContrato.Confirmado && _ordem is null) { <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.DirectionsCar" OnClick="@(() => SolicitarStatusAsync(StatusAgendamentoContrato.Compareceu))">Registrar chegada</MudButton><MudButton Variant="Variant.Text" OnClick="@(() => SolicitarStatusAsync(StatusAgendamentoContrato.NaoCompareceu))">Não compareceu</MudButton> }
                @if (_ordem is null || _ordem.Status == StatusOrdemServicoContrato.Cancelada) { <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => SolicitarStatusAsync(StatusAgendamentoContrato.Cancelado))">Cancelar agendamento</MudButton> }
            </div></section>
        }
    </Authorized></AuthorizeView>
}

</div>

@code {
    [Parameter] public Guid Id { get; set; }
    private AgendamentoDetalheResponse? _agendamento; private OrdemServicoAgendamentoResponse? _ordem; private IReadOnlyCollection<ReferenciaOrcamentoResponse> _orcamentos = []; private bool _carregando = true; private bool _podeVisualizarOrdem;
    protected override async Task OnParametersSetAsync()
    {
        _carregando = true; var resultado = await AgendaApi.ObterAsync(Id); _agendamento = resultado.Resultado;
        if (!resultado.Sucesso) Mensagens.Mostrar(resultado.Mensagem, true);
        if (_agendamento is not null)
        {
            var usuario = (await AuthenticationState.GetAuthenticationStateAsync()).User;
            _podeVisualizarOrdem = (await Authorization.AuthorizeAsync(usuario, Permissoes.OrdemServicoVisualizar)).Succeeded;
            if (_podeVisualizarOrdem)
                _ordem = (await OrdensApi.ObterPorAgendamentoAsync(Id)).Resultado?.OrdemServico;
            if ((await Authorization.AuthorizeAsync(usuario, Permissoes.OrcamentosVisualizar)).Succeeded)
                _orcamentos = (await OrcamentosApi.ListarPorAgendamentoAsync(Id)).Resultado ?? [];
        }
        _carregando = false;
    }
    private async Task SolicitarStatusAsync(StatusAgendamentoContrato destino)
    {
        if (_agendamento is null) return;
        var parametros = new DialogParameters<ConfirmacaoAgendamentoDialog>
        {
            { componente => componente.AgendamentoId, Id },
            { componente => componente.Destino, destino },
            { componente => componente.ClienteNome, _agendamento.ClienteNome },
            { componente => componente.VeiculoDescricao, FormatacaoVeiculo.Exibir(_agendamento.VeiculoDescricao, _agendamento.VeiculoPlaca) }
        };
        var dialogo = await Dialogs.ShowAsync<ConfirmacaoAgendamentoDialog>(
            "Confirmar ação do agendamento",
            parametros,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                CloseButton = false,
                BackdropClick = false,
                CloseOnEscapeKey = false
            });
        var resultadoDialogo = await dialogo.Result;
        if (resultadoDialogo is null || resultadoDialogo.Canceled ||
            resultadoDialogo.Data is not ResultadoServico<AgendamentoDetalheResponse> resultado)
            return;

        Mensagens.Mostrar(resultado.Mensagem);
        await OnParametersSetAsync();
    }
    private static bool EhEditavel(StatusAgendamentoContrato status) => status is StatusAgendamentoContrato.Agendado or StatusAgendamentoContrato.Confirmado;
    private static bool EhFinal(StatusAgendamentoContrato status) => status is StatusAgendamentoContrato.Concluido or StatusAgendamentoContrato.Cancelado or StatusAgendamentoContrato.NaoCompareceu;
    private static bool PermiteCriarOrdem(StatusAgendamentoContrato status) => status is StatusAgendamentoContrato.Agendado or StatusAgendamentoContrato.Confirmado or StatusAgendamentoContrato.Compareceu;
    private static string NomeStatus(StatusAgendamentoContrato status) => status switch { StatusAgendamentoContrato.NaoCompareceu => "Não compareceu", StatusAgendamentoContrato.Compareceu => "Em atendimento", StatusAgendamentoContrato.Concluido => "Concluído", _ => status.ToString() };
    private static string NomeStatusOrdem(StatusOrdemServicoContrato status) => status switch { StatusOrdemServicoContrato.EmExecucao => "Em execução", StatusOrdemServicoContrato.AguardandoRetirada => "Aguardando retirada", StatusOrdemServicoContrato.Concluida => "Concluída", StatusOrdemServicoContrato.Cancelada => "Cancelada", _ => "Aberta" };
    private static string NomeStatusOrcamento(StatusOrcamentoContrato status) => status switch { StatusOrcamentoContrato.Aprovado => "Aprovado", StatusOrcamentoContrato.Emitido => "Emitido", StatusOrcamentoContrato.Substituido => "Substituído", _ => status.ToString() };
    private static string ClasseStatus(StatusAgendamentoContrato status) => status switch { StatusAgendamentoContrato.Agendado => "status-scheduled", StatusAgendamentoContrato.Confirmado => "status-confirmed", StatusAgendamentoContrato.Compareceu => "status-waiting", StatusAgendamentoContrato.Concluido => "status-running", StatusAgendamentoContrato.Cancelado => "status-cancelled", _ => "status-neutral" };
    private static DetaraStatusTone TomStatus(StatusAgendamentoContrato status) => status switch { StatusAgendamentoContrato.Agendado => DetaraStatusTone.Info, StatusAgendamentoContrato.Confirmado or StatusAgendamentoContrato.Concluido => DetaraStatusTone.Positive, StatusAgendamentoContrato.Compareceu => DetaraStatusTone.Warning, StatusAgendamentoContrato.Cancelado => DetaraStatusTone.Critical, _ => DetaraStatusTone.Neutral };
    private static string TextoConflitoHorario(int quantidade) => quantidade == 1
        ? "1 conflito de horário identificado"
        : $"{quantidade} conflitos de horário identificados";
    private static string FormatarDuracao(int minutos) => minutos >= 60 ? $"{minutos / 60}h{(minutos % 60 > 0 ? $" {minutos % 60}min" : string.Empty)}" : $"{minutos} min";
    private static string FormatarDuracao(int? minutos) => minutos.HasValue ? FormatarDuracao(minutos.Value) : "Não informada";
}
