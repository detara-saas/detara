@page "/orcamentos/novo"
@attribute [Authorize(Policy = Permissoes.OrcamentosCriar)]
@inject NavigationManager Navegacao

<PageTitle>Novo orçamento | Detara</PageTitle>
<div class="page-container page-container-wide">
    <CabecalhoPagina Titulo="Novo orçamento" Descricao="Defina o que será oferecido e o valor negociado neste caso." Sobretitulo="ATENDIMENTO" />
    <OrcamentoFormulario ClienteInicialId="_clienteId" ClienteInicialNome="@_clienteNome" />
</div>

@code {
    private Guid? _clienteId;
    private string? _clienteNome;

    protected override void OnInitialized()
    {
        var query = Navegacao.ToAbsoluteUri(Navegacao.Uri).Query.TrimStart('?');
        foreach (var parte in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var itens = parte.Split('=', 2);
            if (itens.Length != 2) continue;
            if (itens[0].Equals("clienteId", StringComparison.OrdinalIgnoreCase) && Guid.TryParse(Uri.UnescapeDataString(itens[1]), out var id)) _clienteId = id;
            if (itens[0].Equals("clienteNome", StringComparison.OrdinalIgnoreCase)) _clienteNome = Uri.UnescapeDataString(itens[1]);
        }
    }
}
