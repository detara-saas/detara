@page "/veiculos/novo"
@page "/veiculos/{Id:guid}/editar"
@attribute [Authorize]
@inject EmpresaCapacidadesState Capacidades

<PageTitle>@(Id.HasValue ? "Editar veículo" : "Novo veículo") | Detara</PageTitle>
@if (!_capacidadeCarregada)
{
    <div class="page-container page-container-focused"><DetaraSkeleton Variant="DetaraSkeletonVariant.Detail" Rotulo="Validando módulos da empresa" /></div>
}
else if (!_capacidadeDisponivel)
{
    <div class="page-container page-container-focused"><EstadoVazio Titulo="@TituloCapacidadeIndisponivel" Descricao="@DescricaoCapacidadeIndisponivel" Icone="@Icons.Material.Outlined.ExtensionOff" /></div>
}
else
{
<div class="page-container page-container-focused">
<AuthorizeView Policy="@Politica">
    <Authorized>
        <CabecalhoPagina Titulo="@(Id.HasValue ? "Editar veículo" : "Novo veículo")" Descricao="Identifique o veículo e vincule-o ao cliente responsável." Sobretitulo="CADASTROS" />
        <section class="module-panel form-panel"><VeiculoFormulario VeiculoId="Id" ClienteInicialId="ClienteId" /></section>
    </Authorized>
    <NotAuthorized>
        <EstadoVazio Titulo="Acesso não autorizado" Descricao="Seu perfil não possui permissão para esta operação." Icone="@Icons.Material.Outlined.Lock" />
    </NotAuthorized>
</AuthorizeView>
</div>
}

@code {
    [Parameter] public Guid? Id { get; set; }
    [SupplyParameterFromQuery(Name = "clienteId")] public Guid? ClienteId { get; set; }
    private string Politica => Id.HasValue ? Permissoes.VeiculosEditar : Permissoes.VeiculosCriar;
    private bool _capacidadeDisponivel;
    private bool _capacidadeCarregada;
    private string TituloCapacidadeIndisponivel => Capacidades.Estado == EstadoCarregamentoCapacidades.Carregado ? "Módulo indisponível" : "Não foi possível validar os módulos";
    private string DescricaoCapacidadeIndisponivel => Capacidades.Estado == EstadoCarregamentoCapacidades.Carregado ? "Veículos não está habilitado para esta empresa." : Capacidades.Mensagem ?? "Tente novamente quando a conexão estiver disponível.";
    protected override async Task OnInitializedAsync()
    {
        await Capacidades.CarregarAsync();
        _capacidadeCarregada = true;
        _capacidadeDisponivel = Capacidades.Possui(CodigosCapacidadeContrato.Veiculos);
    }
}
