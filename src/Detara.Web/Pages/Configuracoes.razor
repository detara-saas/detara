@page "/configuracoes"
@attribute [Authorize(Policy = Permissoes.ConfiguracoesVisualizar)]
@inject ConfiguracoesServico ConfiguracoesApi
@inject IMensagemServico Mensagens
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IAuthorizationService AuthorizationService
@inject NotificacoesServico NotificacoesApi
@inject IDialogService Dialogs
@inject IJSRuntime JS

<PageTitle>Configurações | Detara</PageTitle>

<div class="page-container page-container-wide">
<CabecalhoPagina Titulo="Configurações" Descricao="Defina como sua empresa conduz o atendimento sem impor um processo único." Sobretitulo="ADMINISTRAÇÃO" />

@if (_carregando)
{
    <div class="module-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
}
else if (_configuracao is null)
{
    <EstadoVazio Titulo="Configurações indisponíveis" Descricao="Não foi possível carregar as regras operacionais da empresa." Icone="@Icons.Material.Outlined.Settings" />
}
else
{
    <div class="settings-layout">
        <section class="module-panel settings-panel" aria-labelledby="operacao-heading">
            <div class="section-heading settings-heading">
                <div>
                    <span class="section-eyebrow">OPERAÇÃO · ATENDIMENTO</span>
                    <h2 id="operacao-heading">Etapas do atendimento</h2>
                    <p>Escolha o que ficará fora do fluxo, disponível ao operador ou obrigatório na futura Ordem de Serviço.</p>
                </div>
                <MudIcon Icon="@Icons.Material.Outlined.Tune" Color="Color.Primary" />
            </div>

            <div class="operational-settings-grid">
                <NivelExigenciaOperacionalCard Titulo="Checklist de entrada" Descricao="Avaliação visual configurada pela sua empresa." Valor="_checklistEntrada" ValorChanged="@(valor => _checklistEntrada = valor)" PodeEditar="_podeEditar" Identificador="checklist-entrada" />
                <NivelExigenciaOperacionalCard Titulo="Fotos de entrada" Descricao="Evidências registradas antes do início do serviço." Valor="_fotosEntrada" ValorChanged="@(valor => _fotosEntrada = valor)" PodeEditar="_podeEditar" Identificador="fotos-entrada" />
                <NivelExigenciaOperacionalCard Titulo="Fotos de saída" Descricao="Evidências registradas antes da entrega do veículo." Valor="_fotosSaida" ValorChanged="@(valor => _fotosSaida = valor)" PodeEditar="_podeEditar" Identificador="fotos-saida" />
            </div>

            <AuthorizeView Policy="@Permissoes.ConfiguracoesEditar">
                <Authorized>
                    <div class="settings-actions">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" Disabled="_salvandoOperacao" OnClick="SalvarOperacaoAsync">
                            @(_salvandoOperacao ? "Salvando..." : "Salvar operação")
                        </MudButton>
                    </div>
                </Authorized>
            </AuthorizeView>
        </section>

        <section class="module-panel settings-panel checklist-editor" aria-labelledby="checklist-heading">
            <div class="section-heading settings-heading">
                <div>
                    <span class="section-eyebrow">MODELO PADRÃO</span>
                    <h2 id="checklist-heading">Checklist de entrada</h2>
                    <p>A ordem abaixo será usada como base para o snapshot das futuras Ordens de Serviço.</p>
                </div>
                <span class="settings-count">@_itens.Count item(ns)</span>
            </div>

            <div class="checklist-status-management">
                <div>
                    <span class="status-badge @(ChecklistAtivo ? "status-running" : "status-neutral")">
                        @(ChecklistAtivo ? "Ativo" : "Inativo")
                    </span>
                    <p>@(ChecklistAtivo
                        ? "Este modelo pode compor o check-in das novas Ordens de Serviço conforme o nível configurado."
                        : "Este modelo permanece salvo, mas não será aplicado às novas Ordens de Serviço.")</p>
                </div>
                <AuthorizeView Policy="@Permissoes.ConfiguracoesEditar">
                    <Authorized>
                        <MudButton Variant="Variant.Outlined"
                                   Color="@(ChecklistAtivo ? Color.Warning : Color.Primary)"
                                   StartIcon="@(ChecklistAtivo ? Icons.Material.Outlined.PauseCircle : Icons.Material.Outlined.PlayCircle)"
                                   Disabled="@(_alterandoStatusChecklist || (!ChecklistAtivo && _itens.Count == 0))"
                                   OnClick="@(() => AlterarStatusChecklistAsync(!ChecklistAtivo))">
                            @(_alterandoStatusChecklist
                                ? "Atualizando..."
                                : ChecklistAtivo ? "Inativar checklist" : "Reativar checklist")
                        </MudButton>
                    </Authorized>
                </AuthorizeView>
            </div>

            <div class="settings-fields">
                <MudTextField T="string" @bind-Value="_nomeChecklist" Label="Nome do checklist" Variant="Variant.Outlined" Disabled="@(!_podeEditar)" MaxLength="120" />
                <MudTextField T="string" @bind-Value="_descricaoChecklist" Label="Descrição (opcional)" Variant="Variant.Outlined" Disabled="@(!_podeEditar)" MaxLength="500" Lines="2" />
            </div>

            @if (_itens.Count == 0)
            {
                <div class="compact-empty checklist-empty">
                    <MudIcon Icon="@Icons.Material.Outlined.Checklist" />
                    <div><strong>Nenhum item configurado</strong><span>Adicione itens antes de habilitar o checklist como opcional ou obrigatório.</span></div>
                </div>
            }
            else
            {
                <ol class="checklist-settings-list">
                    @for (var indice = 0; indice < _itens.Count; indice++)
                    {
                        var posicao = indice;
                        <li @key="_itens[posicao].Chave">
                            <span class="checklist-order" aria-hidden="true">@(posicao + 1)</span>
                            <MudTextField T="string" @bind-Value="_itens[posicao].Descricao" Label="@($"Item {posicao + 1}")" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(!_podeEditar)" MaxLength="240" />
                            <div class="checklist-item-actions">
                                <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowUp" aria-label="@($"Mover item {posicao + 1} para cima")" Disabled="@(!_podeEditar || posicao == 0)" OnClick="@(() => Mover(posicao, -1))" />
                                <MudIconButton Icon="@Icons.Material.Outlined.KeyboardArrowDown" aria-label="@($"Mover item {posicao + 1} para baixo")" Disabled="@(!_podeEditar || posicao == _itens.Count - 1)" OnClick="@(() => Mover(posicao, 1))" />
                                <MudIconButton Icon="@Icons.Material.Outlined.DeleteOutline" Color="Color.Error" aria-label="@($"Remover item {posicao + 1}")" Disabled="@(!_podeEditar)" OnClick="@(() => Remover(posicao))" />
                            </div>
                        </li>
                    }
                </ol>
            }

            <AuthorizeView Policy="@Permissoes.ConfiguracoesEditar">
                <Authorized>
                    <div class="settings-actions checklist-actions">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Add" OnClick="AdicionarItem">Adicionar item</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" Disabled="_salvandoChecklist" OnClick="SalvarChecklistAsync">
                            @(_salvandoChecklist ? "Salvando..." : "Salvar checklist")
                        </MudButton>
                    </div>
                </Authorized>
            </AuthorizeView>
        </section>

        <section class="module-panel settings-panel settings-panel-wide notification-settings" aria-labelledby="notificacoes-heading">
            <div class="section-heading settings-heading">
                <div>
                    <span class="section-eyebrow">COMUNICAÇÃO COM CLIENTES</span>
                    <h2 id="notificacoes-heading">Comunicação com clientes</h2>
                    <p>Configure como sua empresa deseja avisar o cliente quando o veículo estiver pronto.</p>
                </div>
                <MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead" Color="Color.Primary" />
            </div>

            @if (_carregandoNotificacoes)
            {
                <div class="module-loading compact-loading"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
            }
            else if (_configuracaoNotificacao is null || _templateEmail is null || _templateWhatsApp is null)
            {
                <div class="compact-empty"><MudIcon Icon="@Icons.Material.Outlined.CloudOff" /><div><strong>Comunicação indisponível</strong><span>Não foi possível carregar as configurações dos canais.</span></div></div>
            }
            else
            {
                <div class="communication-settings-stack">
                    <section class="communication-config-block" aria-labelledby="canal-automatico-heading">
                        <div class="communication-block-heading"><span class="section-eyebrow">AUTOMAÇÃO</span><h3 id="canal-automatico-heading">Canal automático</h3><p>Escolha um único canal para a comunicação preparada quando a OS entrar em “Aguardando retirada”.</p></div>
                        <MudRadioGroup T="CanalComunicacaoVeiculoProntoContrato" Value="_canalAutomatico" ValueChanged="SelecionarCanalAsync" Disabled="@(!_podeEditar)" Class="communication-channel-cards">
                            <MudRadio T="CanalComunicacaoVeiculoProntoContrato" Value="@CanalComunicacaoVeiculoProntoContrato.Nenhum" Color="Color.Primary" Class="@ClasseCardCanal(CanalComunicacaoVeiculoProntoContrato.Nenhum)">
                                <span class="communication-channel-card-icon"><MudIcon Icon="@Icons.Material.Outlined.NotificationsOff" /></span><span class="communication-channel-card-copy"><strong>Nenhum</strong><small>Não prepara avisos automáticos.</small></span>
                            </MudRadio>
                            <MudRadio T="CanalComunicacaoVeiculoProntoContrato" Value="@CanalComunicacaoVeiculoProntoContrato.Email" Color="Color.Primary" Class="@ClasseCardCanal(CanalComunicacaoVeiculoProntoContrato.Email)">
                                <span class="communication-channel-card-icon"><MudIcon Icon="@Icons.Material.Outlined.MailOutline" /></span><span class="communication-channel-card-copy"><strong>Email</strong><small>Envia o aviso pelo e-mail do cliente.</small></span><span class="communication-channel-availability status-badge status-confirmed">Disponível</span>
                            </MudRadio>
                            <MudRadio T="CanalComunicacaoVeiculoProntoContrato" Value="@CanalComunicacaoVeiculoProntoContrato.WhatsApp" Color="Color.Primary" Class="@ClasseCardCanal(CanalComunicacaoVeiculoProntoContrato.WhatsApp)">
                                <span class="communication-channel-card-icon"><MudIcon Icon="@Icons.Material.Outlined.Chat" /></span><span class="communication-channel-card-copy"><strong>WhatsApp</strong><small>Envia o aviso pela sessão desta empresa.</small></span><span class="communication-channel-availability status-badge @ClasseStatusWhatsApp(_sessaoWhatsApp?.Status)">@NomeStatusWhatsApp(_sessaoWhatsApp?.Status)</span>
                            </MudRadio>
                        </MudRadioGroup>
                    </section>

                    <section class="communication-config-block" aria-labelledby="canal-selecionado-heading">
                        <div class="communication-block-heading"><span class="section-eyebrow">CANAL SELECIONADO</span><h3 id="canal-selecionado-heading">Configuração do canal</h3><p>A disponibilidade e as autorizações abaixo pertencem somente a esta empresa.</p></div>
                        @if (_canalAutomatico == CanalComunicacaoVeiculoProntoContrato.Nenhum)
                        {
                            <div class="compact-empty communication-channel-empty"><MudIcon Icon="@Icons.Material.Outlined.NotificationsPaused" /><div><strong>Comunicação automática desativada</strong><span>O operador ainda pode comunicar manualmente pela Ordem de Serviço.</span></div></div>
                        }
                        else if (_canalAutomatico == CanalComunicacaoVeiculoProntoContrato.Email)
                        {
                            <div class="communication-selected-provider"><span><MudIcon Icon="@Icons.Material.Outlined.MarkEmailRead" /></span><div><strong>Email selecionado</strong><p>O aviso usará o e-mail atual do cliente e o template específico deste canal.</p></div><span class="status-badge status-confirmed">Pronto</span></div>
                        }
                        else
                        {
                            <div class="whatsapp-management-card">
                                <div class="whatsapp-management-header">
                                    <span class="whatsapp-connection-icon @ClasseStatusWhatsApp(_sessaoWhatsApp?.Status)"><MudIcon Icon="@Icons.Material.Outlined.Chat" /></span>
                                    <div class="whatsapp-connection-copy"><span class="section-eyebrow">WHATSAPP DA EMPRESA</span><strong>@TituloStatusWhatsApp()</strong><small>@DescricaoStatusWhatsApp()</small></div>
                                    <span class="status-badge @ClasseStatusWhatsApp(_sessaoWhatsApp?.Status)">@NomeStatusWhatsApp(_sessaoWhatsApp?.Status)</span>
                                </div>
                                @if (_sessaoWhatsApp?.Status == StatusSessaoWhatsAppContrato.Conectada)
                                {
                                    <div class="whatsapp-session-facts"><span><small>NÚMERO</small><strong>@FormatarWhatsApp(_sessaoWhatsApp.NumeroConectado)</strong></span><span><small>STATUS</small><strong><i class="whatsapp-online-dot" aria-hidden="true"></i> Online</strong></span><span><small>ÚLTIMA CONEXÃO</small><strong>@FormatarData(_sessaoWhatsApp.UltimaConexaoEmUtc)</strong></span></div>
                                }
                                <div class="whatsapp-consent-card">
                                    <MudCheckBox T="bool" @bind-Value="_permitirComunicacaoWhatsApp" Color="Color.Primary" Disabled="@(!_podeEditar || _sessaoWhatsApp?.Status != StatusSessaoWhatsAppContrato.Conectada)" Label="Autorizar avisos automáticos via WhatsApp" />
                                    <span>Esta autorização controla somente envios automáticos. O envio manual continua sujeito às permissões do operador.</span>
                                    @if (_configuracaoNotificacao.DataAtivacaoWhatsAppEmUtc.HasValue)
                                    {
                                        <small>Última ativação em @_configuracaoNotificacao.DataAtivacaoWhatsAppEmUtc.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")@(!string.IsNullOrWhiteSpace(_configuracaoNotificacao.UsuarioAtivacaoWhatsApp) ? $" · {_configuracaoNotificacao.UsuarioAtivacaoWhatsApp}" : string.Empty)</small>
                                    }
                                </div>
                                <MudAlert Severity="@(WhatsAppAutomaticoPronto ? Severity.Success : Severity.Warning)" Variant="Variant.Outlined" Class="communication-provider-alert">@(WhatsAppAutomaticoPronto ? "WhatsApp conectado e autorizado para avisos automáticos." : _sessaoWhatsApp?.Status != StatusSessaoWhatsAppContrato.Conectada ? "Conecte o WhatsApp desta empresa antes de autorizar os avisos automáticos." : "O WhatsApp está conectado, mas os envios automáticos ainda não foram autorizados.")</MudAlert>
                                <AuthorizeView Policy="@Permissoes.ConfiguracoesEditar"><Authorized><div class="whatsapp-management-actions">
                                    @if (_sessaoWhatsApp?.Status == StatusSessaoWhatsAppContrato.Conectada)
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Send" Disabled="@_testandoWhatsApp" OnClick="TestarWhatsAppAsync">@(_testandoWhatsApp ? "Agendando..." : "Testar envio")</MudButton>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Outlined.LinkOff" Disabled="@_desconectandoWhatsApp" OnClick="DesconectarWhatsAppAsync">@(_desconectandoWhatsApp ? "Desconectando..." : "Desconectar")</MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.QrCode2" Disabled="@_conectandoWhatsApp" OnClick="ConectarWhatsAppAsync">@(_conectandoWhatsApp ? "Preparando..." : StatusEmConexao ? "Exibir QR Code" : "Conectar WhatsApp")</MudButton>
                                    }
                                </div></Authorized></AuthorizeView>
                                @if (_testesWhatsApp.Count > 0)
                                {
                                    <div class="whatsapp-test-history"><div><strong>Testes recentes</strong><span>Últimas validações desta sessão</span></div>@foreach (var teste in _testesWhatsApp.Take(3)) { <article><MudIcon Icon="@Icons.Material.Outlined.MarkChatRead" /><span><strong>@FormatarWhatsApp(teste.Destinatario)</strong><small>@teste.CriadoEmUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm") · @(teste.SolicitadoPorUsuarioNome ?? "Usuário")</small></span><span class="status-badge @ClasseComunicacao(teste.Status)">@NomeComunicacao(teste.Status)</span></article> }</div>
                                }
                            </div>
                        }
                    </section>

                    <section class="communication-config-block" aria-labelledby="preferencias-comunicacao-heading">
                        <div class="communication-block-heading"><span class="section-eyebrow">PREFERÊNCIAS ADICIONAIS</span><h3 id="preferencias-comunicacao-heading">Respostas por e-mail</h3><p>Defina para onde serão encaminhadas as respostas dos clientes aos avisos por e-mail.</p></div>
                        <MudTextField T="string" @bind-Value="_responderPara" Label="Responder para (opcional)" Placeholder="contato@suaempresa.com.br" Variant="Variant.Outlined" Disabled="@(!_podeEditar)" MaxLength="200" HelperText="O remetente continua administrado pela infraestrutura Detara." />
                        <AuthorizeView Policy="@Permissoes.ConfiguracoesEditar"><Authorized><div class="settings-actions notification-config-action"><MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" Disabled="_salvandoNotificacoes" OnClick="SalvarConfiguracaoNotificacaoAsync">@(_salvandoNotificacoes ? "Salvando..." : "Salvar comunicação")</MudButton></div></Authorized></AuthorizeView>
                    </section>

                    <section class="communication-config-block communication-template-block" aria-labelledby="template-comunicacao-heading">
                        <div class="notification-template-heading"><div><span class="section-eyebrow">TEMPLATE TRANSACIONAL</span><h3 id="template-comunicacao-heading">Veículo pronto para retirada</h3><p>Cada canal possui conteúdo próprio, validado e renderizado no servidor.</p></div>@if (TemplateSelecionado is not null) { <span class="status-badge @(TemplateSelecionado.Origem == OrigemTemplateComunicacaoContrato.PadraoDetara ? "status-neutral" : "status-running")">@(TemplateSelecionado.Origem == OrigemTemplateComunicacaoContrato.PadraoDetara ? "Padrão Detara" : "Personalizado")</span> }</div>
                        @if (_canalAutomatico == CanalComunicacaoVeiculoProntoContrato.Nenhum)
                        {
                            <div class="compact-empty communication-channel-empty"><MudIcon Icon="@Icons.Material.Outlined.Description" /><div><strong>Selecione Email ou WhatsApp</strong><span>O editor e a prévia serão apresentados para o canal escolhido.</span></div></div>
                        }
                        else
                        {
                            <div class="notification-template-layout">
                                <div class="notification-template-editor">
                                    @if (_canalAutomatico == CanalComunicacaoVeiculoProntoContrato.Email)
                                    {
                                        <MudTextField T="string" @bind-Value="_assuntoEmail" Label="Assunto" Variant="Variant.Outlined" Disabled="@(!_podeEditar)" MaxLength="200" Counter="200" />
                                        <div><label class="field-label">Corpo do e-mail</label><EditorEmail @bind-Value="_corpoEmail" Disabled="@(!_podeEditar)" /></div>
                                        <div class="email-variables" aria-label="Variáveis disponíveis"> <span>Variáveis disponíveis</span>@foreach (var variavel in _variaveisEmail) { <button type="button" class="token-chip" title="Copiar variável" @onclick="@(() => CopiarVariavelAsync(variavel))">@variavel</button> }</div>
                                    }
                                    else
                                    {
                                        <MudTextField T="string" @bind-Value="_mensagemWhatsApp" Label="Mensagem de WhatsApp" Variant="Variant.Outlined" Lines="10" Disabled="@(!_podeEditar)" MaxLength="4096" Counter="4096" />
                                        <div class="email-variables" aria-label="Variáveis disponíveis"> <span>Variáveis disponíveis</span>@foreach (var variavel in _variaveisWhatsApp) { <button type="button" class="token-chip" title="Copiar variável" @onclick="@(() => CopiarVariavelAsync(variavel))">@variavel</button> }</div>
                                    }
                                    <div class="settings-actions notification-template-actions">
                                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Visibility" Disabled="_gerandoPreview" OnClick="GerarPreviewAsync">@(_gerandoPreview ? "Gerando..." : "Atualizar prévia")</MudButton>
                                        <AuthorizeView Policy="@Permissoes.ConfiguracoesEditar"><Authorized>
                                            @if (_canalAutomatico == CanalComunicacaoVeiculoProntoContrato.Email) { <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Outlined.Send" Disabled="_enviandoTeste" OnClick="EnviarTesteAsync">@(_enviandoTeste ? "Enviando..." : "Enviar teste")</MudButton> }
                                            @if (TemplateSelecionado?.Origem == OrigemTemplateComunicacaoContrato.PersonalizadoEmpresa) { <MudButton Variant="Variant.Text" Color="Color.Error" StartIcon="@Icons.Material.Outlined.Restore" OnClick="RestaurarTemplateAsync">Restaurar padrão</MudButton> }
                                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Outlined.Save" Disabled="_salvandoTemplate" OnClick="SalvarTemplateAsync">@(_salvandoTemplate ? "Salvando..." : "Salvar template")</MudButton>
                                        </Authorized></AuthorizeView>
                                    </div>
                                </div>
                                <aside class="email-preview-panel" aria-label="Pré-visualização da mensagem">
                                    <div class="email-preview-heading"><div><span class="section-eyebrow">PRÉ-VISUALIZAÇÃO</span><strong>@(_canalAutomatico == CanalComunicacaoVeiculoProntoContrato.Email ? _previewAssunto ?? "Prévia do e-mail" : "Prévia da mensagem")</strong></div><MudIcon Icon="@(_canalAutomatico == CanalComunicacaoVeiculoProntoContrato.Email ? Icons.Material.Outlined.DesktopWindows : Icons.Material.Outlined.PhoneAndroid)" /></div>
                                    @if (_canalAutomatico == CanalComunicacaoVeiculoProntoContrato.Email)
                                    {
                                        @if (string.IsNullOrWhiteSpace(_previewHtml)) { <div class="compact-empty email-preview-empty"><MudIcon Icon="@Icons.Material.Outlined.MarkEmailUnread" /><div><strong>Conteúdo ainda não renderizado</strong><span>Atualize a prévia para aplicar os dados de exemplo.</span></div></div> } else { <iframe class="email-preview-frame" sandbox="" title="Pré-visualização do e-mail" srcdoc="@_previewHtml"></iframe> }
                                    }
                                    else if (string.IsNullOrWhiteSpace(_previewWhatsApp))
                                    {
                                        <div class="compact-empty email-preview-empty"><MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" /><div><strong>Mensagem ainda não renderizada</strong><span>Atualize a prévia para aplicar João, Honda Civic e Estética Horizonte.</span></div></div>
                                    }
                                    else
                                    {
                                        <div class="whatsapp-template-preview"><MudIcon Icon="@Icons.Material.Outlined.Chat" /><pre>@_previewWhatsApp</pre></div>
                                    }
                                </aside>
                            </div>
                        }
                    </section>
                </div>
            }
        </section>
    </div>
}

</div>

@code {
    private ConfiguracaoOperacionalResponse? _configuracao;
    private NivelExigenciaOperacionalContrato _checklistEntrada;
    private NivelExigenciaOperacionalContrato _fotosEntrada;
    private NivelExigenciaOperacionalContrato _fotosSaida;
    private string _nomeChecklist = "Checklist de entrada";
    private string? _descricaoChecklist;
    private readonly List<ItemChecklistEdicao> _itens = [];
    private bool _carregando = true;
    private bool _podeEditar;
    private bool _salvandoOperacao;
    private bool _salvandoChecklist;
    private bool _alterandoStatusChecklist;
    private ConfiguracaoNotificacaoResponse? _configuracaoNotificacao;
    private TemplateComunicacaoResponse? _templateEmail;
    private TemplateComunicacaoResponse? _templateWhatsApp;
    private SessaoWhatsAppResponse? _sessaoWhatsApp;
    private IReadOnlyCollection<ComunicacaoClienteResponse> _testesWhatsApp = [];
    private CanalComunicacaoVeiculoProntoContrato _canalAutomatico;
    private bool _permitirComunicacaoWhatsApp;
    private string? _responderPara;
    private string _assuntoEmail = string.Empty;
    private string _corpoEmail = string.Empty;
    private string _mensagemWhatsApp = string.Empty;
    private string? _previewAssunto;
    private string? _previewHtml;
    private string? _previewWhatsApp;
    private bool _carregandoNotificacoes = true;
    private bool _salvandoNotificacoes;
    private bool _salvandoTemplate;
    private bool _gerandoPreview;
    private bool _enviandoTeste;
    private bool _conectandoWhatsApp;
    private bool _desconectandoWhatsApp;
    private bool _testandoWhatsApp;
    private Guid? _solicitacaoTesteWhatsAppId;
    private readonly string[] _variaveisEmail = ["{{EmpresaNome}}", "{{ClienteNome}}", "{{ClientePrimeiroNome}}", "{{VeiculoDescricao}}", "{{Placa}}", "{{OrdemServicoCodigo}}"];
    private readonly string[] _variaveisWhatsApp = ["{ClienteNome}", "{VeiculoDescricao}", "{EmpresaNome}"];
    private bool ChecklistAtivo => _configuracao?.ChecklistEntrada != NivelExigenciaOperacionalContrato.Desabilitado;
    private bool StatusEmConexao => _sessaoWhatsApp?.Status is
        StatusSessaoWhatsAppContrato.Conectando or
        StatusSessaoWhatsAppContrato.AguardandoQrCode or
        StatusSessaoWhatsAppContrato.Reconectando;
    private bool WhatsAppAutomaticoPronto => _permitirComunicacaoWhatsApp &&
        _sessaoWhatsApp?.Status == StatusSessaoWhatsAppContrato.Conectada;
    private TemplateComunicacaoResponse? TemplateSelecionado => _canalAutomatico switch
    {
        CanalComunicacaoVeiculoProntoContrato.Email => _templateEmail,
        CanalComunicacaoVeiculoProntoContrato.WhatsApp => _templateWhatsApp,
        _ => null
    };

    protected override async Task OnInitializedAsync()
    {
        var autenticacao = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        _podeEditar = (await AuthorizationService.AuthorizeAsync(
            autenticacao.User,
            Permissoes.ConfiguracoesEditar)).Succeeded;
        await Task.WhenAll(CarregarAsync(), CarregarNotificacoesAsync());
    }

    private async Task CarregarAsync()
    {
        _carregando = true;
        var resultado = await ConfiguracoesApi.ObterOperacaoAsync();
        if (resultado.Sucesso && resultado.Resultado is not null)
        {
            Aplicar(resultado.Resultado);
        }
        else
        {
            Mensagens.Mostrar(resultado.Mensagem, true);
        }

        _carregando = false;
    }

    private void Aplicar(ConfiguracaoOperacionalResponse configuracao)
    {
        _configuracao = configuracao;
        _checklistEntrada = configuracao.ChecklistEntrada;
        _fotosEntrada = configuracao.FotosEntrada;
        _fotosSaida = configuracao.FotosSaida;
        _nomeChecklist = configuracao.Checklist.Nome;
        _descricaoChecklist = configuracao.Checklist.Descricao;
        _itens.Clear();
        _itens.AddRange(configuracao.Checklist.Itens
            .OrderBy(item => item.Ordem)
            .Select(item => new ItemChecklistEdicao(item.Descricao)));
    }

    private async Task SalvarOperacaoAsync()
    {
        _salvandoOperacao = true;
        var resultado = await ConfiguracoesApi.AtualizarOperacaoAsync(
            new AtualizarConfiguracaoOperacionalRequest(
                _checklistEntrada,
                _fotosEntrada,
                _fotosSaida));
        if (resultado.Sucesso && resultado.Resultado is not null)
        {
            Aplicar(resultado.Resultado);
        }

        Mensagens.Mostrar(resultado.Mensagem, !resultado.Sucesso);
        _salvandoOperacao = false;
    }

    private async Task SalvarChecklistAsync()
    {
        _salvandoChecklist = true;
        var resultado = await ConfiguracoesApi.AtualizarChecklistAsync(
            new AtualizarChecklistModeloRequest(
                _nomeChecklist,
                _descricaoChecklist,
                _itens.Select(item => new ChecklistModeloItemRequest(item.Descricao)).ToArray()));
        if (resultado.Sucesso && resultado.Resultado is not null)
        {
            Aplicar(resultado.Resultado);
        }

        Mensagens.Mostrar(resultado.Mensagem, !resultado.Sucesso);
        _salvandoChecklist = false;
    }

    private async Task AlterarStatusChecklistAsync(bool ativar)
    {
        if (ativar && _itens.Count == 0)
        {
            Mensagens.Mostrar("Adicione ao menos um item antes de reativar o checklist.", true);
            return;
        }

        var confirmar = await Dialogs.ShowMessageBoxAsync(
            ativar ? "Reativar checklist?" : "Inativar checklist?",
            ativar
                ? "O modelo voltará a ficar disponível para novos check-ins como etapa opcional."
                : "Futuras Ordens de Serviço deixarão de usar este checklist. Checklists já registrados e seu histórico não serão removidos.",
            yesText: ativar ? "Reativar checklist" : "Inativar checklist",
            cancelText: "Cancelar");
        if (confirmar != true)
        {
            return;
        }

        _alterandoStatusChecklist = true;
        var resultado = await ConfiguracoesApi.AtualizarOperacaoAsync(
            new AtualizarConfiguracaoOperacionalRequest(
                ativar
                    ? NivelExigenciaOperacionalContrato.Opcional
                    : NivelExigenciaOperacionalContrato.Desabilitado,
                _fotosEntrada,
                _fotosSaida));
        if (resultado.Sucesso && resultado.Resultado is not null)
        {
            Aplicar(resultado.Resultado);
        }

        Mensagens.Mostrar(resultado.Mensagem, !resultado.Sucesso);
        _alterandoStatusChecklist = false;
    }

    private void AdicionarItem() => _itens.Add(new ItemChecklistEdicao(string.Empty));

    private void Remover(int indice) => _itens.RemoveAt(indice);

    private void Mover(int indice, int deslocamento)
    {
        var destino = indice + deslocamento;
        if (destino < 0 || destino >= _itens.Count)
        {
            return;
        }

        (_itens[indice], _itens[destino]) = (_itens[destino], _itens[indice]);
    }

    private async Task CarregarNotificacoesAsync()
    {
        _carregandoNotificacoes = true;
        var configuracaoTask = NotificacoesApi.ObterConfiguracaoAsync();
        var templateEmailTask = NotificacoesApi.ObterTemplateAsync(
            CanalComunicacaoClienteContrato.Email);
        var templateWhatsAppTask = NotificacoesApi.ObterTemplateAsync(
            CanalComunicacaoClienteContrato.WhatsApp);
        var whatsappTask = NotificacoesApi.ObterStatusWhatsAppAsync();
        var testesTask = NotificacoesApi.ObterTestesWhatsAppAsync();
        await Task.WhenAll(configuracaoTask, templateEmailTask,
            templateWhatsAppTask, whatsappTask, testesTask);
        var configuracao = await configuracaoTask;
        var templateEmail = await templateEmailTask;
        var templateWhatsApp = await templateWhatsAppTask;
        var whatsapp = await whatsappTask;
        var testes = await testesTask;
        if (configuracao.Sucesso && configuracao.Resultado is not null &&
            templateEmail.Sucesso && templateEmail.Resultado is not null &&
            templateWhatsApp.Sucesso && templateWhatsApp.Resultado is not null)
        {
            _configuracaoNotificacao = configuracao.Resultado;
            _canalAutomatico = configuracao.Resultado.CanalAutomaticoVeiculoPronto;
            _permitirComunicacaoWhatsApp = configuracao.Resultado.PermitirComunicacaoWhatsApp;
            _responderPara = configuracao.Resultado.ResponderParaEmail;
            AplicarTemplate(templateEmail.Resultado);
            AplicarTemplate(templateWhatsApp.Resultado);
        }
        else Mensagens.Mostrar(!configuracao.Sucesso ? configuracao.Mensagem :
            !templateEmail.Sucesso ? templateEmail.Mensagem : templateWhatsApp.Mensagem, true);
        if (whatsapp.Sucesso && whatsapp.Resultado is not null)
            _sessaoWhatsApp = whatsapp.Resultado;
        if (testes.Sucesso && testes.Resultado is not null)
            _testesWhatsApp = testes.Resultado;
        _carregandoNotificacoes = false;
        if (TemplateSelecionado is not null) await GerarPreviewInternoAsync(false);
    }

    private void AplicarTemplate(TemplateComunicacaoResponse template)
    {
        if (template.Canal == CanalComunicacaoClienteContrato.Email)
        {
            _templateEmail = template;
            _assuntoEmail = template.Assunto ?? string.Empty;
            _corpoEmail = template.Conteudo;
            _previewAssunto = null;
            _previewHtml = null;
        }
        else
        {
            _templateWhatsApp = template;
            _mensagemWhatsApp = template.Conteudo;
            _previewWhatsApp = null;
        }
    }

    private async Task SelecionarCanalAsync(CanalComunicacaoVeiculoProntoContrato canal)
    {
        _canalAutomatico = canal;
        if (TemplateSelecionado is not null) await GerarPreviewInternoAsync(false);
    }

    private string ClasseCardCanal(CanalComunicacaoVeiculoProntoContrato canal)
    {
        var classes = _canalAutomatico == canal ? "is-selected" : string.Empty;
        if (canal == CanalComunicacaoVeiculoProntoContrato.WhatsApp &&
            _sessaoWhatsApp?.Status != StatusSessaoWhatsAppContrato.Conectada)
            classes += " is-unavailable";
        return classes.Trim();
    }

    private CanalComunicacaoClienteContrato CanalTemplateSelecionado =>
        _canalAutomatico == CanalComunicacaoVeiculoProntoContrato.Email
            ? CanalComunicacaoClienteContrato.Email
            : CanalComunicacaoClienteContrato.WhatsApp;

    private async Task SalvarConfiguracaoNotificacaoAsync()
    {
        _salvandoNotificacoes = true;
        var r = await NotificacoesApi.SalvarConfiguracaoAsync(new(
            _canalAutomatico, _responderPara, _permitirComunicacaoWhatsApp));
        if (r.Sucesso && r.Resultado is not null) _configuracaoNotificacao = r.Resultado;
        Mensagens.Mostrar(r.Mensagem, !r.Sucesso);
        _salvandoNotificacoes = false;
    }

    private async Task ConectarWhatsAppAsync()
    {
        _conectandoWhatsApp = true;
        var resultado = await NotificacoesApi.ConectarWhatsAppAsync();
        _conectandoWhatsApp = false;
        if (!resultado.Sucesso || resultado.Resultado is null)
        {
            Mensagens.Mostrar(resultado.Mensagem, true);
            return;
        }
        _sessaoWhatsApp = resultado.Resultado;
        var parametros = new DialogParameters<ConectarWhatsAppDialog>
        {
            { x => x.EstadoInicial, resultado.Resultado }
        };
        var dialogo = await Dialogs.ShowAsync<ConectarWhatsAppDialog>(
            "Conectar WhatsApp", parametros,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var retorno = await dialogo.Result;
        if (retorno is { Canceled: false, Data: SessaoWhatsAppResponse estado })
            _sessaoWhatsApp = estado;
        else
        {
            var status = await NotificacoesApi.ObterStatusWhatsAppAsync();
            if (status.Sucesso && status.Resultado is not null)
                _sessaoWhatsApp = status.Resultado;
        }
    }

    private async Task DesconectarWhatsAppAsync()
    {
        var confirmar = await Dialogs.ShowMessageBoxAsync(
            "Desconectar WhatsApp?",
            "A sessão desta empresa será encerrada. Para conectar novamente será necessário ler um novo QR Code.",
            yesText: "Desconectar", cancelText: "Cancelar");
        if (confirmar != true) return;
        _desconectandoWhatsApp = true;
        var resultado = await NotificacoesApi.DesconectarWhatsAppAsync();
        _desconectandoWhatsApp = false;
        if (resultado.Sucesso && resultado.Resultado is not null)
            _sessaoWhatsApp = resultado.Resultado;
        Mensagens.Mostrar(resultado.Mensagem, !resultado.Sucesso);
    }

    private async Task TestarWhatsAppAsync()
    {
        var parametros = new DialogParameters<TestarWhatsAppDialog>();
        var dialogo = await Dialogs.ShowAsync<TestarWhatsAppDialog>(
            "Enviar mensagem de teste", parametros,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true,
                CloseButton = true });
        var retorno = await dialogo.Result;
        if (retorno is null || retorno.Canceled || retorno.Data is not string numero)
            return;
        _solicitacaoTesteWhatsAppId ??= Guid.NewGuid();
        _testandoWhatsApp = true;
        var resultado = await NotificacoesApi.TestarWhatsAppAsync(new(numero,
            true, _solicitacaoTesteWhatsAppId.Value));
        _testandoWhatsApp = false;
        Mensagens.Mostrar(resultado.Mensagem, !resultado.Sucesso);
        if (!resultado.Sucesso) return;
        _solicitacaoTesteWhatsAppId = null;
        var historico = await NotificacoesApi.ObterTestesWhatsAppAsync();
        if (historico.Sucesso && historico.Resultado is not null)
            _testesWhatsApp = historico.Resultado;
    }

    private static string NomeStatusWhatsApp(StatusSessaoWhatsAppContrato? status) => status switch
    {
        StatusSessaoWhatsAppContrato.Conectada => "Conectado",
        StatusSessaoWhatsAppContrato.AguardandoQrCode or
            StatusSessaoWhatsAppContrato.Conectando => "Conectando",
        StatusSessaoWhatsAppContrato.Reconectando => "Reconectando",
        StatusSessaoWhatsAppContrato.Erro => "Erro de conexão",
        _ => "Desconectado"
    };

    private static string ClasseStatusWhatsApp(StatusSessaoWhatsAppContrato? status) => status switch
    {
        StatusSessaoWhatsAppContrato.Conectada => "status-confirmed",
        StatusSessaoWhatsAppContrato.AguardandoQrCode or
            StatusSessaoWhatsAppContrato.Conectando or
            StatusSessaoWhatsAppContrato.Reconectando => "status-waiting",
        StatusSessaoWhatsAppContrato.Erro => "status-cancelled",
        _ => "status-neutral"
    };

    private string DescricaoStatusWhatsApp() => _sessaoWhatsApp switch
    {
        { Status: StatusSessaoWhatsAppContrato.Conectada, UltimaConexaoEmUtc: not null } =>
            $"Última conexão em {_sessaoWhatsApp.UltimaConexaoEmUtc.Value.ToLocalTime():dd/MM/yyyy HH:mm}.",
        { Status: StatusSessaoWhatsAppContrato.AguardandoQrCode or
            StatusSessaoWhatsAppContrato.Conectando } =>
            "Leia o QR Code no celular da empresa para concluir a autenticação.",
        { Status: StatusSessaoWhatsAppContrato.Reconectando } =>
            "Restaurando a sessão persistente desta empresa.",
        { Status: StatusSessaoWhatsAppContrato.Erro, UltimoErroSeguro: not null } =>
            _sessaoWhatsApp.UltimoErroSeguro,
        _ => "Conecte o WhatsApp da empresa para enviar avisos aos clientes."
    };

    private string TituloStatusWhatsApp() => _sessaoWhatsApp?.Status switch
    {
        StatusSessaoWhatsAppContrato.Conectada => "WhatsApp conectado",
        StatusSessaoWhatsAppContrato.AguardandoQrCode or
            StatusSessaoWhatsAppContrato.Conectando => "Aguardando conexão",
        StatusSessaoWhatsAppContrato.Reconectando => "Restaurando conexão",
        StatusSessaoWhatsAppContrato.Erro => "WhatsApp com erro",
        _ => "WhatsApp não conectado"
    };

    private static string FormatarWhatsApp(string? numero)
    {
        if (string.IsNullOrWhiteSpace(numero)) return "Não informado";
        var digitos = new string(numero.Where(char.IsDigit).ToArray());
        if (digitos.Length == 13 && digitos.StartsWith("55", StringComparison.Ordinal))
            return $"+55 {digitos[2..4]} {digitos[4..9]}-{digitos[9..]}";
        if (digitos.Length == 12 && digitos.StartsWith("55", StringComparison.Ordinal))
            return $"+55 {digitos[2..4]} {digitos[4..8]}-{digitos[8..]}";
        return $"+{digitos}";
    }

    private static string FormatarData(DateTime? data) => data.HasValue
        ? data.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
        : "Ainda não registrada";

    private static string NomeComunicacao(StatusComunicacaoClienteContrato status) => status switch
    {
        StatusComunicacaoClienteContrato.Enviado => "Enviado",
        StatusComunicacaoClienteContrato.Falhou => "Falhou",
        _ => "Pendente"
    };

    private static string ClasseComunicacao(StatusComunicacaoClienteContrato status) => status switch
    {
        StatusComunicacaoClienteContrato.Enviado => "status-confirmed",
        StatusComunicacaoClienteContrato.Falhou => "status-cancelled",
        _ => "status-waiting"
    };

    private async Task SalvarTemplateAsync()
    {
        if (TemplateSelecionado is null) return;
        _salvandoTemplate = true;
        var canal = CanalTemplateSelecionado;
        var r = await NotificacoesApi.SalvarTemplateAsync(canal, new(
            canal == CanalComunicacaoClienteContrato.Email ? _assuntoEmail : null,
            canal == CanalComunicacaoClienteContrato.Email ? _corpoEmail : _mensagemWhatsApp));
        if (r.Sucesso && r.Resultado is not null)
        {
            AplicarTemplate(r.Resultado);
            await GerarPreviewInternoAsync(false);
        }
        Mensagens.Mostrar(r.Mensagem, !r.Sucesso);
        _salvandoTemplate = false;
    }

    private async Task RestaurarTemplateAsync()
    {
        var confirmar = await Dialogs.ShowMessageBoxAsync("Restaurar template padrão?",
            "A personalização atual será removida. Notificações já criadas manterão seus snapshots.",
            yesText: "Restaurar padrão", cancelText: "Cancelar");
        if (confirmar != true) return;
        if (TemplateSelecionado is null) return;
        var r = await NotificacoesApi.RestaurarTemplateAsync(CanalTemplateSelecionado);
        if (r.Sucesso && r.Resultado is not null)
        {
            AplicarTemplate(r.Resultado);
            await GerarPreviewInternoAsync(false);
        }
        Mensagens.Mostrar(r.Mensagem, !r.Sucesso);
    }

    private Task GerarPreviewAsync() => GerarPreviewInternoAsync(true);

    private async Task GerarPreviewInternoAsync(bool mostrarErro)
    {
        if (TemplateSelecionado is null) return;
        _gerandoPreview = true;
        var canal = CanalTemplateSelecionado;
        var r = await NotificacoesApi.PreviewAsync(canal, new(
            canal == CanalComunicacaoClienteContrato.Email ? _assuntoEmail : null,
            canal == CanalComunicacaoClienteContrato.Email ? _corpoEmail : _mensagemWhatsApp));
        if (r.Sucesso && r.Resultado is not null)
        {
            if (canal == CanalComunicacaoClienteContrato.Email)
            {
                _previewAssunto = r.Resultado.Assunto;
                _previewHtml = r.Resultado.Conteudo;
            }
            else _previewWhatsApp = r.Resultado.Conteudo;
        }
        else if (mostrarErro) Mensagens.Mostrar(r.Mensagem, true);
        _gerandoPreview = false;
    }

    private async Task EnviarTesteAsync()
    {
        _enviandoTeste = true;
        var r = await NotificacoesApi.EnviarTesteAsync();
        Mensagens.Mostrar(r.Mensagem, !r.Sucesso);
        _enviandoTeste = false;
    }

    private async Task CopiarVariavelAsync(string variavel)
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", variavel);
        Mensagens.Mostrar($"Variável {variavel} copiada.");
    }

    private sealed class ItemChecklistEdicao(string descricao)
    {
        public Guid Chave { get; } = Guid.NewGuid();
        public string Descricao { get; set; } = descricao;
    }
}
