@inherits LayoutComponentBase
@implements IDisposable
@inject AutenticacaoServico Autenticacao
@inject PreferenciasInterfaceServico Preferencias
@inject PwaServico Pwa
@inject IMensagemServico Mensagens
@inject AdministracaoTenantServico AdministracaoTenant
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<MudThemeProvider Theme="@Detara.Web.Temas.DetaraTema.Valor" IsDarkMode="@Preferencias.EhEscuro" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout Class="detara-shell">
    <MudAppBar Elevation="0" Class="detara-topbar">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                       OnClick="AlternarSidebar"
                       Edge="Edge.Start"
                       Class="desktop-menu-button"
                       aria-label="Alternar menu" />
        <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                       OnClick="AlternarDrawer"
                       Edge="Edge.Start"
                       Class="mobile-menu-button"
                       aria-label="Abrir menu" />
        <div class="topbar-title">
            <MudText Typo="Typo.caption" Class="topbar-eyebrow">OPERAÇÃO</MudText>
            <MudText Typo="Typo.subtitle1" Class="topbar-context">Visão geral</MudText>
        </div>
        <MudSpacer />
        <div class="company-context">
            <span class="company-dot"></span>
            <span>@_empresaNome</span>
        </div>
        <MudMenu Icon="@IconeTema" AnchorOrigin="Origin.BottomRight" aria-label="Escolher aparência">
            <MudMenuItem Icon="@Icons.Material.Outlined.SettingsBrightness" OnClick="@(() => DefinirTemaAsync("Sistema"))">
                Sistema
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.LightMode" OnClick="@(() => DefinirTemaAsync("Claro"))">
                Claro
            </MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.DarkMode" OnClick="@(() => DefinirTemaAsync("Escuro"))">
                Escuro
            </MudMenuItem>
        </MudMenu>
        <MudIconButton Icon="@Icons.Material.Outlined.NotificationsNone"
                       Disabled="true"
                       aria-label="Notificações — em breve" />
        <MudMenu Icon="@Icons.Material.Outlined.AccountCircle" AnchorOrigin="Origin.BottomRight" aria-label="Menu da conta">
            @if (Pwa.PodeInstalar)
            {
                <MudMenuItem Icon="@Icons.Material.Outlined.InstallDesktop" OnClick="InstalarAsync">Instalar Detara</MudMenuItem>
            }
            <MudMenuItem Icon="@Icons.Material.Outlined.PersonOutline" Href="/minha-conta">Minha conta</MudMenuItem>
            <MudMenuItem Icon="@Icons.Material.Outlined.Logout" OnClick="SairAsync">Sair</MudMenuItem>
        </MudMenu>
    </MudAppBar>

    <MudDrawer @bind-Open="_menuAberto"
               Variant="DrawerVariant.Responsive"
               Breakpoint="Breakpoint.Md"
               Elevation="0"
               Class="@SidebarClass">
        <div class="brand-shell">
            @if (Preferencias.Atual.SidebarRecolhida)
            {
                <img src="brand/detara-icon.png" alt="Detara" class="brand-icon" />
            }
            else
            {
                <img src="brand/detara-logo-on-dark.png" alt="Detara — Gestão para estéticas automotivas" class="brand-logo" />
            }
        </div>
        <NavMenu Recolhida="@Preferencias.Atual.SidebarRecolhida" />
        <div class="sidebar-footer">
            <span class="status-dot"></span>
            <span class="sidebar-label">Ambiente de desenvolvimento</span>
        </div>
    </MudDrawer>

    <MudMainContent Class="detara-content">
        <PwaStatus />
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _menuAberto = true;
    private string _empresaNome = "Empresa";
    private string SidebarClass => Preferencias.Atual.SidebarRecolhida
        ? "detara-sidebar sidebar-collapsed"
        : "detara-sidebar";
    private string IconeTema => Preferencias.Atual.Tema switch
    {
        "Claro" => Icons.Material.Outlined.LightMode,
        "Escuro" => Icons.Material.Outlined.DarkMode,
        _ => Icons.Material.Outlined.SettingsBrightness
    };

    protected override void OnInitialized()
    {
        Preferencias.Alterado += Atualizar;
        Pwa.Alterado += Atualizar;
        AdministracaoTenant.ContextoAlterado += AtualizarContexto;
    }

    protected override async Task OnInitializedAsync()
    {
        var autenticacao = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (autenticacao.User.Identity?.IsAuthenticated != true)
        {
            return;
        }

        var conta = await AdministracaoTenant.ObterMinhaContaAsync();
        if (conta is { Sucesso: true, Resultado: not null })
        {
            _empresaNome = conta.Resultado.EmpresaNome;
        }
    }

    private async Task AlternarSidebar()
    {
        if (Preferencias.Atual.SidebarRecolhida)
        {
            await Preferencias.DefinirSidebarAsync(false);
        }
        else
        {
            await Preferencias.DefinirSidebarAsync(true);
        }
    }

    private void AlternarDrawer() => _menuAberto = !_menuAberto;

    private Task DefinirTemaAsync(string tema) => Preferencias.DefinirTemaAsync(tema);

    private async Task InstalarAsync()
    {
        if (await Pwa.InstalarAsync())
        {
            Mensagens.Mostrar("Detara instalada com sucesso.");
        }
    }

    private async Task SairAsync()
    {
        await Autenticacao.SairAsync();
        Navigation.NavigateTo("/login", replace: true);
    }

    private void Atualizar() => InvokeAsync(StateHasChanged);
    private void AtualizarContexto()
    {
        _empresaNome = AdministracaoTenant.EmpresaNomeAtual;
        Atualizar();
    }
    public void Dispose()
    {
        Preferencias.Alterado -= Atualizar;
        Pwa.Alterado -= Atualizar;
        AdministracaoTenant.ContextoAlterado -= AtualizarContexto;
    }
}
