<DetaraEmptyState Titulo="@Titulo" Descricao="@Descricao" Icone="@Icone" Acao="@Acao" />

@code {
    [Parameter, EditorRequired]
    public string Titulo { get; set; } = string.Empty;

    [Parameter, EditorRequired]
    public string Descricao { get; set; } = string.Empty;

    [Parameter]
    public string Icone { get; set; } = Icons.Material.Outlined.Inbox;

    [Parameter]
    public RenderFragment? Acao { get; set; }
}
